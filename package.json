{
  "name": "catbox-ecosystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:catbox": "pnpm --filter @catbox/site-catbox dev",
    "dev:tetta": "pnpm --filter @catbox/site-tetta dev",
    "dev:cfc": "pnpm --filter @catbox/site-cfc dev",
    "build": "pnpm -r --filter \"./sites/*\" build",
    "build:catbox": "pnpm --filter @catbox/site-catbox build",
    "build:tetta": "pnpm --filter @catbox/site-tetta build",
    "build:cfc": "pnpm --filter @catbox/site-cfc build",
    "gen:placeholder": "node scripts/gen-placeholder.mjs",
    "check:content": "node scripts/check-content.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
