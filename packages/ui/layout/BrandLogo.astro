---
/**
 * Logo + dòng bảo chứng "A Member of Catbox Packaging Ecosystem"
 * — điểm đồng bộ bắt buộc #2 (REQUIREMENTS §2).
 *
 * Hiện dùng logo chữ (wordmark) theo mockup. Khi khách gửi file AI/SVG gốc,
 * thay khối <span> bằng <img> — kích thước hộp giữ nguyên nên CLS = 0.
 */
import { BRANDS, type BrandId } from "@config/brands";

interface Props {
  brand: BrandId;
  variant?: "light" | "dark";
}

const { brand, variant = "light" } = Astro.props;
const b = BRANDS[brand];

const wordmark: Record<BrandId, { head: string; tail: string }> = {
  catbox: { head: "CAT", tail: "BOX" },
  tetta: { head: "TET", tail: "TA" },
  cfc: { head: "C", tail: "FC" },
};
const mark = wordmark[brand];

const boxClass =
  variant === "dark"
    ? "bg-white/10"
    : "bg-surface-tint border border-line";
const headClass = variant === "dark" ? "text-white" : "text-brandmark";
const subClass = variant === "dark" ? "text-white/50" : "text-ink-faint";
---

<span class={`grid size-[46px] flex-none place-items-center rounded-[13px] text-[22px] ${boxClass}`}>
  {b.emoji}
</span>
<span class="flex flex-col gap-1">
  <span class="font-display text-[27px] leading-none font-extrabold tracking-tight">
    <span class={headClass}>{mark.head}</span><span class="text-primary">{mark.tail}</span>
  </span>
  {
    b.memberOf && (
      <span class={`text-[11px] leading-none font-medium ${subClass}`}>{b.memberOf}</span>
    )
  }
</span>
