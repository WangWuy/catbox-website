---
/**
 * Header chính — Logo trái + Search bo tròn giữa + pill CTA phải.
 * Theo mockup: chiều cao 92px, search max-width 520px.
 *
 * Nút "👤 Đăng nhập / Đăng ký" trong ảnh mẫu Thái Dương đã đổi thành CTA báo giá
 * (TECH_STACK_v2 §3) — giữ nguyên vị trí & hình dáng pill, đổi mục tiêu.
 */
import { BRANDS, type BrandId } from "@config/brands";
import SearchBox from "../islands/SearchBox.astro";
import BrandLogo from "./BrandLogo.astro";

interface Props {
  brand: BrandId;
}

const { brand } = Astro.props;
const b = BRANDS[brand];
---

<header class="border-b border-line-soft bg-surface">
  <div class="site-container flex h-(--height-header) items-center gap-6 lg:gap-10">
    <a href="/" class="flex flex-none items-center gap-3" aria-label={`${b.name} — trang chủ`}>
      <BrandLogo brand={brand} />
    </a>

    <div class="mx-auto hidden w-full max-w-[520px] flex-1 md:block">
      <SearchBox placeholder={b.searchPlaceholder} />
    </div>

    <a
      href={b.headerCta.href}
      class="pill h-11 flex-none bg-line-soft px-5 text-sm text-primary-deep transition-colors hover:bg-surface-tint"
    >
      <span aria-hidden="true">👤</span>
      <span class="hidden sm:inline">{b.headerCta.label}</span>
    </a>
  </div>

  <div class="site-container pb-3 md:hidden">
    <SearchBox placeholder={b.searchPlaceholder} />
  </div>
</header>
