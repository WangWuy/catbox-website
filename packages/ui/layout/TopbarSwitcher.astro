---
/**
 * Topbar Switcher — điểm đồng bộ bắt buộc #1 (REQUIREMENTS §2).
 * [🌟 CATBOX | 🎁 TETTA | 🥖 CFC] + link phụ + hotline + CTA pill.
 *
 * Vì 3 site nằm trên 3 domain riêng, link chéo dùng URL tuyệt đối lấy từ
 * brands.ts — brand đang xem thì render <span>, không phải <a>.
 */
import { BRAND_ORDER, BRANDS, type BrandId } from "@config/brands";
import { TOPBAR_LINKS } from "@config/nav";

interface Props {
  brand: BrandId;
}

const { brand } = Astro.props;
const b = BRANDS[brand];
const links = TOPBAR_LINKS[brand];
---

<div class="bg-primary-deep text-white/70">
  <div class="site-container flex h-(--height-topbar) items-center justify-between gap-4">
    <nav aria-label="Hệ sinh thái Catbox" class="flex items-center gap-4">
      {
        BRAND_ORDER.map((id, i) => {
          const other = BRANDS[id];
          const active = id === brand;
          return (
            <>
              {i > 0 && <span aria-hidden="true" class="h-3.5 w-px bg-white/20" />}
              {active ? (
                <span
                  aria-current="page"
                  class="border-b-2 border-primary pb-[3px] text-[12.5px] font-bold text-white"
                >
                  {other.emoji} {other.short}
                </span>
              ) : (
                <a
                  href={other.site}
                  class="text-[12.5px] font-semibold text-white/50 transition-colors hover:text-white"
                >
                  <span class="hidden sm:inline">
                    {other.emoji} {other.short}
                  </span>
                  <span class="sm:hidden">{other.emoji}</span>
                </a>
              )}
            </>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-5">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hidden text-[12.5px] font-medium text-white/70 transition-colors hover:text-white md:inline"
          >
            {l.label}
          </a>
        ))
      }
      <span aria-hidden="true" class="hidden h-3.5 w-px bg-white/20 md:inline-block"></span>
      <a
        href={`tel:${b.hotline.replace(/\D/g, "")}`}
        data-analytics="click_hotline"
        class="hidden text-[13px] font-bold text-white sm:inline"
      >
        ☎ {b.hotline}
      </a>
      <a
        href={b.topbarCta.href}
        class="pill h-6.5 bg-primary px-4 text-xs text-white transition-colors hover:bg-primary-hover"
      >
        {b.topbarCta.label}
      </a>
    </div>
  </div>
</div>
