---
/**
 * Khối giới thiệu hệ sinh thái trước Footer — điểm đồng bộ bắt buộc #3
 * (REQUIREMENTS §2). 3 cột, brand đang xem được đánh dấu "Đang xem".
 *
 * Đây cũng là kênh internal-link chéo giữa 3 domain (§6A.5) — link tuyệt đối.
 */
import { BRAND_ORDER, BRANDS, type BrandId } from "@config/brands";

interface Props {
  brand: BrandId;
}

const { brand } = Astro.props;
---

<section class="bg-surface-alt py-16" aria-labelledby="eco-heading">
  <div class="site-container">
    <h2 id="eco-heading" class="mb-2 text-2xl font-extrabold tracking-tight uppercase">
      Hệ sinh thái Catbox Packaging
    </h2>
    <p class="mb-8 text-[15px] text-ink-muted">
      Một nhà máy — ba thương hiệu chuyên biệt. Cùng năng lực sản xuất, khác định vị khách hàng.
    </p>

    <div class="grid gap-5 md:grid-cols-3">
      {
        BRAND_ORDER.map((id) => {
          const o = BRANDS[id];
          const here = id === brand;
          return (
            <div
              class={`flex flex-col gap-3 rounded-panel border bg-surface p-6 shadow-card ${
                here ? "border-primary" : "border-line"
              }`}
            >
              <div class="flex items-center gap-2.5">
                <span aria-hidden="true" class="text-xl">
                  {o.emoji}
                </span>
                <span class="font-display text-lg font-extrabold tracking-tight">{o.name}</span>
                <span
                  class={`pill ml-auto px-2.5 py-1 text-[10.5px] ${
                    here
                      ? "bg-primary text-white"
                      : "bg-surface-tint text-ink-muted"
                  }`}
                >
                  {here ? "Đang xem" : o.ecoTag}
                </span>
              </div>
              <p class="text-sm font-semibold text-ink-muted">{o.tagline}</p>
              <p class="text-sm leading-relaxed text-ink-muted">{o.ecoDesc}</p>
              {here ? (
                <span class="mt-auto pt-2 text-[13px] font-bold text-ink-faint">
                  Bạn đang ở đây
                </span>
              ) : (
                <a
                  href={o.site}
                  class="mt-auto pt-2 text-[13px] font-bold text-primary transition-colors hover:text-primary-hover"
                >
                  Truy cập {o.short} →
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
