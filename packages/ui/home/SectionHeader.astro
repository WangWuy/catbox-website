---
/**
 * Tiêu đề section theo mockup: chữ in hoa đậm bên trái, chỗ trống bên phải cho
 * tabs hoặc nút "Xem thêm →". Dùng lại ở BÁN CHẠY, TIN TỨC, LỰA CHỌN CỦA TUẦN.
 */
interface Props {
  title: string;
  subtitle?: string;
  /** Nút pill bên phải */
  action?: { label: string; href: string };
  class?: string;
}

const { title, subtitle, action, class: className = "" } = Astro.props;
---

<div class={`mb-7 flex flex-wrap items-center justify-between gap-4 ${className}`}>
  <div class="flex flex-col gap-1.5">
    <h2 class="text-3xl font-extrabold tracking-tight uppercase md:text-section">{title}</h2>
    {subtitle && <p class="text-[15px] text-ink-muted">{subtitle}</p>}
  </div>

  <div class="flex items-center gap-2.5">
    <slot />
    {
      action && (
        <a
          href={action.href}
          class="pill h-10 border border-line bg-surface-alt px-5 text-[13.5px] font-semibold text-ink-muted transition-colors hover:bg-surface-tint"
        >
          {action.label}
        </a>
      )
    }
  </div>
</div>
