---
/**
 * DANH MỤC — lưới 4 ô vuông bo góc, nút pill trắng chữ đen nằm giữa thẻ
 * (TETTA_CFC_DESIGN_SPEC §2, hàng "DANH MỤC").
 */
import type { AssetMap } from "../lib/images";
import SmartImage from "../media/SmartImage.astro";
import SectionHeader from "./SectionHeader.astro";

export interface CategoryCard {
  name: string;
  sub?: string;
  href: string;
  image?: string;
}

interface Props {
  assets: AssetMap;
  title?: string;
  subtitle?: string;
  action?: { label: string; href: string };
  items: CategoryCard[];
}

const { assets, title = "Danh mục", subtitle, action, items } = Astro.props;
---

<section class="site-container" aria-labelledby="cat-heading">
  <SectionHeader {title} {subtitle} {action} />

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      items.map((c, i) => (
        <a
          href={c.href}
          class="group relative block overflow-hidden rounded-panel bg-surface-tint shadow-card"
        >
          <SmartImage
            {assets}
            src={c.image}
            alt={c.name}
            width={600}
            height={600}
            ratio="1x1"
            variant={i + 1}
            class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />

          <div
            aria-hidden="true"
            class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"
          />

          <div class="absolute inset-x-0 bottom-0 flex flex-col items-center gap-2 p-4">
            <span class="pill bg-white px-5 py-2.5 text-center text-[12.5px] leading-tight text-ink shadow-card">
              {c.name}
            </span>
            {c.sub && (
              <span class="hidden text-center text-[11.5px] text-white/85 sm:block">{c.sub}</span>
            )}
          </div>
        </a>
      ))
    }
  </div>
</section>
