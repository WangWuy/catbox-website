---
/**
 * Video xưởng ngang full-width — khối cuối trước footer.
 * Chưa có video thật thì hiển thị ảnh + nút play tĩnh, đúng bố cục để khi thay
 * video vào không xê dịch gì.
 */
import type { AssetMap } from "../lib/images";
import SmartImage from "../media/SmartImage.astro";

interface Props {
  assets: AssetMap;
  headline: string;
  image?: string;
  video?: string;
}

const { assets, headline, image, video } = Astro.props;
---

<section class="relative bg-primary-ink" aria-label={headline}>
  {
    video ? (
      <video
        controls
        preload="none"
        poster={image}
        class="h-[280px] w-full object-cover md:h-[460px]"
        aria-label={headline}
      >
        <source src={video} type="video/mp4" />
      </video>
    ) : (
      <>
        <SmartImage
          {assets}
          src={image}
          alt=""
          width={1600}
          height={900}
          ratio="16x9"
          variant={4}
          class="h-[280px] w-full object-cover md:h-[460px]"
        />
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-6 bg-black/35">
          <span
            aria-hidden="true"
            class="grid size-22 place-items-center rounded-full bg-primary shadow-[0_10px_30px_rgba(0,0,0,.35)]"
          >
            <span class="ml-1 border-y-[15px] border-l-[24px] border-y-transparent border-l-white"
            ></span>
          </span>
          <p
            class="px-6 text-center text-xl font-extrabold text-white drop-shadow-[0_2px_12px_rgba(0,0,0,.4)] md:text-[32px]"
          >
            {headline}
          </p>
        </div>
      </>
    )
  }
</section>
