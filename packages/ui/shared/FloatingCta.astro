---
/**
 * Nút nổi "Lên đầu trang" góc phải dưới — chỉ hiện khi cuộn xuống quá
 * `--scroll-top-threshold`. Thay cho cặp nút Zalo + hotline cũ (đã bỏ theo
 * yêu cầu thiết kế mới) và nút back-to-top tĩnh từng nằm trong Footer.
 */
import { Icon } from "astro-icon/components";
---

<a
  href="#top"
  aria-label="Lên đầu trang"
  data-scroll-top-btn
  class="fixed right-3 bottom-4 z-(--z-floating) grid size-(--size-back-to-top) translate-y-2 place-items-center rounded-full bg-primary text-white opacity-0 shadow-lg transition-[opacity,translate] duration-(--duration-base) ease-(--ease-out-soft) pointer-events-none print:hidden md:right-4 md:bottom-5 [&.is-visible]:translate-y-0 [&.is-visible]:opacity-100 [&.is-visible]:pointer-events-auto"
>
  <Icon name="lucide:arrow-up" class="size-5" aria-hidden="true" />
</a>

<script>
  const btn = document.querySelector<HTMLAnchorElement>("[data-scroll-top-btn]");

  if (btn) {
    const threshold = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--scroll-top-threshold")) || 400;

    const onScroll = () => {
      btn.classList.toggle("is-visible", window.scrollY > threshold);
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
