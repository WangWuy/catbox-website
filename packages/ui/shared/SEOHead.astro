---
/**
 * <head> dùng chung: meta, OG, canonical, hreflang, preconnect font.
 * TECH_STACK_v2 §6A.
 */
import { BRANDS, type BrandId } from "@config/brands";

interface Props {
  brand: BrandId;
  title: string;
  description: string;
  /** Ảnh OG; thiếu → dùng ảnh sinh sẵn theo brand */
  ogImage?: string;
  ogType?: "website" | "article" | "product";
  noindex?: boolean;
  /** Fonts Google cần tải cho site này */
  fonts?: string;
}

const {
  brand,
  title,
  description,
  ogImage,
  ogType = "website",
  noindex = false,
  fonts,
} = Astro.props;

const b = BRANDS[brand];

// Chỉ áp dụng xử lý OG Image PNG và domain linh hoạt riêng cho CFC theo yêu cầu
const isCfc = brand === "cfc";

const siteUrl = isCfc
  ? (Astro.site ??
     (typeof process !== "undefined" && process.env.SITE_URL
       ? new URL(process.env.SITE_URL)
       : null) ??
     (typeof process !== "undefined" && process.env.VERCEL_PROJECT_PRODUCTION_URL
       ? new URL(`https://${process.env.VERCEL_PROJECT_PRODUCTION_URL}`)
       : null) ??
     (typeof process !== "undefined" && process.env.VERCEL_URL
       ? new URL(`https://${process.env.VERCEL_URL}`)
       : null) ??
     new URL(b.site))
  : (Astro.site ?? b.site);

const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Với CFC: dùng ảnh PNG 1200×630 để các ứng dụng (Telegram, Zalo, FB) render preview đẹp
// Với các site khác: giữ nguyên placeholder SVG như ban đầu
const fallbackOg = isCfc ? (b.ogImage ?? "/og/og-image.png") : "/og/default.svg";
const rawOg = ogImage ?? fallbackOg;
const safeOg = isCfc && rawOg.endsWith(".svg") ? fallbackOg : rawOg;
const og = new URL(safeOg, siteUrl).href;

const fullTitle = title.includes(b.short) ? title : `${title} | ${b.name}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<!-- hreflang: chỉ khai báo ngôn ngữ thật sự có bản dịch (§9) -->
<link rel="alternate" hreflang="vi" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<meta property="og:site_name" content={b.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
{isCfc && (
  <>
    <meta property="og:image:secure_url" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
  </>
)}
<meta property="og:locale" content="vi_VN" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og} />

<meta name="theme-color" content={b.themeColor} />
<link rel="icon" href={b.favicon} type={b.favicon.endsWith(".png") ? "image/png" : "image/svg+xml"} />
<link rel="sitemap" href="/sitemap-index.xml" />
{/* Chỉ CFC có mục Tin tức + /rss.xml; 2 site kia chưa có feed nên không khai báo */}
{brand === "cfc" && (
  <link rel="alternate" type="application/rss+xml" title={`${b.name} — Tin tức`} href="/rss.xml" />
)}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
{fonts && <link rel="stylesheet" href={fonts} />}
