---
/**
 * Layout gốc của site CATBOX — Dark Luxury Studio.
 *
 * Đây là bộ khung RIÊNG, không dùng chung với CFC/Tetta (@ui/brand/fnb):
 * Catbox là site thương hiệu nên không có topbar giá sỉ và không có
 * CategoryNav e-commerce; header đã gộp nav + switcher hệ sinh thái.
 * Phần thật sự chung 3 site (SEO, JSON-LD, FloatingCta) vẫn lấy
 * từ @ui/shared — đó mới là chỗ dùng chung hợp lệ.
 */
import { BRANDS } from "@config/brands";
import SEOHead from "@ui/shared/SEOHead.astro";
import JsonLd from "@ui/shared/JsonLd.astro";
import FloatingCta from "@ui/shared/FloatingCta.astro";
import SiteHeader from "@ui/brand/catbox/SiteHeader.astro";
import SiteFooter from "@ui/brand/catbox/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article" | "product";
  noindex?: boolean;
  /** Schema bổ sung cho trang này (Product, Article, FAQPage…) */
  jsonLd?: Record<string, unknown>[];
  fonts?: string;
}

const {
  title,
  description,
  ogImage,
  ogType,
  noindex,
  jsonLd = [],
  fonts,
} = Astro.props;

const b = BRANDS.catbox;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="vi" data-brand="catbox">
  <head>
    <SEOHead brand="catbox" {title} {description} {ogImage} {ogType} {noindex} {fonts} />
    <JsonLd brand="catbox" extra={jsonLd} />
    <slot name="head" />
  </head>
  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-chip focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Bỏ qua tới nội dung chính
    </a>

    <SiteHeader {current} />

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <SiteFooter />
    <FloatingCta />

    <script is:inline define:vars={{ hotline: b.hotline }}>
      // GA4 events (§12.12) — chỉ gắn listener, không kéo thêm thư viện.
      document.addEventListener("click", (e) => {
        const el = (e.target instanceof Element ? e.target : null)?.closest("[data-analytics]");
        if (!el) return;
        const name = el.getAttribute("data-analytics");
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: name, hotline });
      });
    </script>
  </body>
</html>
