---
/**
 * Biểu trưng logo chứng nhận & pháp lý chân trang (Footer):
 * - Con dấu tròn HACCP Certified Food Safety (chuẩn quốc tế ngành thực phẩm)
 * - Con dấu tròn ISO 9001:2015 Certified Quality System
 * - Tem chứng nhận Đã thông báo Bộ Công Thương / Sở Công Thương
 * - Hoặc file ảnh logo riêng (khi có `src`)
 */
import { Icon } from "astro-icon/components";

interface Props {
  id?: string;
  name: string;
  label?: string;
  sub?: string;
  href?: string;
  src?: string;
  type?: "iso" | "haccp" | "bocongthuong" | "socongthuong" | "custom";
}

const {
  id,
  name,
  label,
  sub,
  href,
  src,
  type = "custom",
} = Astro.props;

// Tự động dùng /bo-cong-thuong.png khi type là bocongthuong nếu chưa truyền src
const badgeSrc = src || (type === "bocongthuong" ? "/bo-cong-thuong.png" : undefined);

// Tạo ID duy nhất cho các thẻ <defs> SVG tránh trùng lặp giữa các instance
const uid = id || type || Math.random().toString(36).slice(2, 7);
const topArcId = `top-arc-${uid}`;
const botArcId = `bot-arc-${uid}`;

const isLink = Boolean(href && href !== "#");
const Tag = isLink ? "a" : "div";
const linkProps = isLink
  ? {
      href,
      target: href?.startsWith("http") ? "_blank" : undefined,
      rel: href?.startsWith("http") ? "noopener noreferrer" : undefined,
      "data-analytics": `click_cert_${id || type || "badge"}`,
    }
  : {};
---

<Tag
  {...linkProps}
  class="group inline-flex items-center transition-transform duration-200 hover:scale-105 select-none"
  title={`${name}${label ? ` - ${label}` : ""}`}
>
  {
    badgeSrc ? (
      <img
        src={badgeSrc}
        alt={name}
        class="h-10.5 w-auto max-w-[160px] object-contain drop-shadow-sm md:h-13"
        loading="lazy"
        decoding="async"
      />
    ) : type === "haccp" ? (
      /* Con dấu tròn HACCP Certified Food Safety */
      <svg
        class="size-11.5 flex-none drop-shadow-sm transition-shadow duration-200 group-hover:drop-shadow-md md:size-13.5"
        viewBox="0 0 100 100"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        aria-hidden="true"
      >
        <!-- Nền tròn trắng -->
        <circle cx="50" cy="50" r="48" fill="#FFFFFF" />

        <!-- Viền đôi màu xanh navy chuẩn F&B -->
        <circle cx="50" cy="50" r="45" fill="none" stroke="#0B3C61" stroke-width="2" />
        <circle cx="50" cy="50" r="42" fill="none" stroke="#0B3C61" stroke-width="0.8" />

        <!-- Vòng tròn trong đỡ chữ -->
        <circle cx="50" cy="50" r="27.5" fill="none" stroke="#0B3C61" stroke-width="1.2" />

        <defs>
          <path id={topArcId} d="M 18,50 A 32,32 0 0,1 82,50" fill="none" />
          <path id={botArcId} d="M 82,50 A 32,32 0 0,1 18,50" fill="none" />
        </defs>

        <!-- Chữ CERTIFIED uốn cong phía trên -->
        <text fill="#0B3C61" font-size="8" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="1">
          <textPath href={`#${topArcId}`} xlink:href={`#${topArcId}`} startOffset="50%" text-anchor="middle">CERTIFIED</textPath>
        </text>

        <!-- Chữ FOOD SAFETY uốn cong phía dưới -->
        <text fill="#0B3C61" font-size="7.5" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.8">
          <textPath href={`#${botArcId}`} xlink:href={`#${botArcId}`} startOffset="50%" text-anchor="middle">FOOD SAFETY</textPath>
        </text>

        <!-- Khung ngang HACCP chính giữa cắt qua vòng tròn -->
        <rect x="8" y="37.5" width="84" height="25" rx="4" fill="#FFFFFF" stroke="#0B3C61" stroke-width="2" />
        <text x="50" y="56" fill="#0B3C61" font-size="16.5" font-weight="900" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle" letter-spacing="1.2">HACCP</text>
      </svg>
    ) : type === "iso" ? (
      /* Con dấu tròn ISO 9001:2015 Certified Quality System đồng bộ */
      <svg
        class="size-11.5 flex-none drop-shadow-sm transition-shadow duration-200 group-hover:drop-shadow-md md:size-13.5"
        viewBox="0 0 100 100"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        aria-hidden="true"
      >
        <!-- Nền tròn trắng -->
        <circle cx="50" cy="50" r="48" fill="#FFFFFF" />

        <!-- Viền đôi màu xanh navy -->
        <circle cx="50" cy="50" r="45" fill="none" stroke="#0B3C61" stroke-width="2" />
        <circle cx="50" cy="50" r="42" fill="none" stroke="#0B3C61" stroke-width="0.8" />

        <!-- Vòng tròn trong đỡ chữ -->
        <circle cx="50" cy="50" r="27.5" fill="none" stroke="#0B3C61" stroke-width="1.2" />

        <defs>
          <path id={topArcId} d="M 18,50 A 32,32 0 0,1 82,50" fill="none" />
          <path id={botArcId} d="M 82,50 A 32,32 0 0,1 18,50" fill="none" />
        </defs>

        <!-- Chữ CERTIFIED uốn cong phía trên -->
        <text fill="#0B3C61" font-size="8" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="1">
          <textPath href={`#${topArcId}`} xlink:href={`#${topArcId}`} startOffset="50%" text-anchor="middle">CERTIFIED</textPath>
        </text>

        <!-- Chữ QUALITY SYSTEM uốn cong phía dưới -->
        <text fill="#0B3C61" font-size="7" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.5">
          <textPath href={`#${botArcId}`} xlink:href={`#${botArcId}`} startOffset="50%" text-anchor="middle">QUALITY SYSTEM</textPath>
        </text>

        <!-- Khung ngang ISO 9001 chính giữa -->
        <rect x="6" y="37.5" width="88" height="25" rx="4" fill="#FFFFFF" stroke="#0B3C61" stroke-width="2" />
        <text x="50" y="55.5" fill="#0B3C61" font-size="13" font-weight="900" font-family="system-ui, -apple-system, sans-serif" text-anchor="middle" letter-spacing="0.6">
          {name || "ISO 9001:2015"}
        </text>
      </svg>
    ) : type === "bocongthuong" || type === "socongthuong" ? (
      /* Tem chính thức Đã thông báo Bộ Công Thương / Sở Công Thương */
      <svg
        class="h-10 w-auto flex-none drop-shadow-sm transition-shadow duration-200 group-hover:drop-shadow-md md:h-12"
        viewBox="0 0 132 44"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect width="132" height="44" rx="6" fill="#FFFFFF" />
        <rect x="0.5" y="0.5" width="131" height="43" rx="5.5" stroke="#E2E8F0" stroke-width="1" />

        <!-- Huy hiệu đỏ bên trái -->
        <circle cx="22" cy="22" r="14.5" fill="#D32F2F" />
        <circle cx="22" cy="22" r="12" stroke="#FFD54F" stroke-width="0.8" stroke-dasharray="1.5 1" fill="none" />
        <!-- Ngôi sao vàng chính giữa -->
        <polygon points="22,12.5 23.8,18 29.5,18 24.8,21.5 26.6,27 22,23.5 17.4,27 19.2,21.5 14.5,18 20.2,18" fill="#FFD54F" />
        <!-- Tích xanh kiểm duyệt -->
        <circle cx="29.5" cy="28.5" r="5.5" fill="#2E7D32" stroke="#FFFFFF" stroke-width="1.2" />
        <path d="M27 28.5 L28.8 30.3 L32.5 26.8" stroke="#FFFFFF" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />

        <!-- Dòng chữ ĐÃ THÔNG BÁO / ĐÃ ĐĂNG KÝ -->
        <text x="42" y="15.5" fill="#D32F2F" font-size="8.5" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.4">
          {(type === "socongthuong" ? "ĐÃ ĐĂNG KÝ" : (name || "ĐÃ THÔNG BÁO")).toUpperCase()}
        </text>
        <!-- Dòng chữ BỘ CÔNG THƯƠNG / SỞ CÔNG THƯƠNG -->
        <text x="42" y="27" fill="#0D47A1" font-size="10" font-weight="900" font-family="system-ui, -apple-system, sans-serif" letter-spacing="0.2">
          {(type === "socongthuong" ? "SỞ CÔNG THƯƠNG" : (label || "BỘ CÔNG THƯƠNG")).toUpperCase()}
        </text>
        <!-- Tên miền xác thực -->
        <text x="42" y="36.5" fill="#64748B" font-size="6.5" font-family="system-ui, -apple-system, sans-serif" font-weight="600">
          {sub || (type === "socongthuong" ? "socongthuong.gov.vn" : "online.gov.vn")}
        </text>
      </svg>
    ) : (
      /* Fallback dạng biểu trưng khiên bảo vệ */
      <div class="flex items-center gap-2.5 rounded-lg border border-white/15 bg-white/10 px-3 py-2">
        <div class="flex size-7.5 flex-none items-center justify-center rounded-full bg-primary/20 text-primary">
          <Icon name="lucide:shield-check" class="size-4.5" aria-hidden="true" />
        </div>
        <div class="flex flex-col">
          <span class="text-xs font-bold leading-snug text-white">{name}</span>
          {label && <span class="text-micro font-medium leading-none text-white/60">{label}</span>}
        </div>
      </div>
    )
  }
</Tag>
