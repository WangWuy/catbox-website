---
/**
 * Khung F&B dùng chung cho CFC + Tetta: topbar giá sỉ → header có search →
 * CategoryNav e-commerce. Site chỉ truyền `brand` + import theme CSS của
 * mình — mọi thứ còn lại giống hệt nhau.
 *
 * Catbox KHÔNG dùng file này (khung studio riêng ở @ui/brand/catbox) — kiểu
 * FnbBrandId chặn việc truyền brand="catbox" vào đây ngay lúc biên dịch.
 */
import { BRANDS, type FnbBrandId } from "@config/brands";
import type { CategoryEntryLike, ProductEntryLike } from "@config/categories";
import { buildNavEntries } from "@config/nav";
import SEOHead from "@ui/shared/SEOHead.astro";
import JsonLd from "@ui/shared/JsonLd.astro";
import TopbarSwitcher from "@ui/brand/fnb/TopbarSwitcher.astro";
import MainHeader from "@ui/brand/fnb/MainHeader.astro";
import CfcHeader from "@ui/brand/fnb/CfcHeader.astro";
import Footer from "@ui/brand/fnb/Footer.astro";
import FloatingCta from "@ui/shared/FloatingCta.astro";

interface Props {
  brand: FnbBrandId;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: "website" | "article" | "product";
  noindex?: boolean;
  /** Schema bổ sung cho trang này (Product, Article, FAQPage…) */
  jsonLd?: Record<string, unknown>[];
  fonts?: string;
  /**
   * Collection `categories` để CategoryNav dựng menu từ content thay vì
   * `NAV[brand]` hardcode. Layout của site tự lấy và truyền xuống (BaseLayout
   * dùng chung nhiều site nên không tự gọi `getCollection` được).
   */
  categories?: CategoryEntryLike[];
  /**
   * Collection `products` để CategoryNav gắn danh sách sản phẩm thực tế vào
   * từng nhóm danh mục con.
   */
  products?: ProductEntryLike[];
  /** Link cột chính sách ở Footer — xem `footerLinks` của Footer.astro */
  footerLinks?: { label: string; href: string }[];
  /** Xem `overlapTrustStrip` của Footer.astro */
  overlapTrustStrip?: boolean;
}

const {
  brand,
  title,
  description,
  ogImage,
  ogType,
  noindex,
  jsonLd = [],
  fonts,
  categories,
  products,
  footerLinks,
  overlapTrustStrip,
} = Astro.props;

const b = BRANDS[brand];
const current = Astro.url.pathname;

/**
 * Dựng menu MỘT lần rồi truyền xuống cả `MainHeader` (drawer mobile) lẫn
 * `CategoryNav` (thanh ngang + mega menu từ md). Hai component nằm ở hai nhánh
 * DOM khác nhau nhưng phải hiển thị đúng cùng một danh sách.
 */
const navEntries = buildNavEntries(brand, categories, products);
---

<!doctype html>
<html lang="vi" data-brand={brand}>
  <head>
    <SEOHead {brand} {title} {description} {ogImage} {ogType} {noindex} {fonts} />
    <JsonLd {brand} extra={jsonLd} />
    <slot name="head" />

    <script is:inline>
      // Bật hiệu ứng reveal. Phải nằm trong <head> và chạy đồng bộ: luật ẩn
      // trong base.css chỉ khớp khi có thuộc tính này, nên đặt sớm hơn lần vẽ
      // đầu tiên thì nội dung không kịp hiện rồi mới biến mất.
      //
      // Đặt bằng JS thay vì viết thẳng vào <html>: không có JS thì thuộc tính
      // không tồn tại → không khối nào bị ẩn → trang vẫn đọc được đầy đủ.
      document.documentElement.setAttribute("data-reveal-root", "on");
    </script>
  </head>
  <body id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-(--z-skiplink) focus:rounded-chip focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      Bỏ qua tới nội dung chính
    </a>

    {brand === "cfc" ? null : <TopbarSwitcher {brand} />}
    {brand === "cfc" ? (
      <CfcHeader items={navEntries} {current} />
    ) : (
      <MainHeader {brand} items={navEntries} {current} />
    )}

    {/* Mốc cho IntersectionObserver: nằm SAU header tĩnh. Khi người dùng cuộn
        qua hết cụm header tĩnh, thanh sticky compact clone sẽ trượt êm ái xuống
        từ mép trên theo chuẩn cấu trúc Woodmart (áp dụng cho site Tetta; site CFC
        giữ nguyên toàn bộ 2 dòng header khi cuộn) */}
    {brand !== "cfc" && (
      <>
        <div data-header-sentinel aria-hidden="true" class="h-px -mt-px pointer-events-none"></div>
        <MainHeader {brand} items={navEntries} {current} isStickyClone />
      </>
    )}

    <main id="main" data-pagefind-body>
      <slot />
    </main>

    <Footer {brand} {footerLinks} {overlapTrustStrip} />
    <FloatingCta />

    <script is:inline define:vars={{ hotline: b.hotline }}>
      // GA4 events (§12.12) — chỉ gắn listener, không kéo thêm thư viện.
      document.addEventListener("click", (e) => {
        const el = (e.target instanceof Element ? e.target : null)?.closest("[data-analytics]");
        if (!el) return;
        const name = el.getAttribute("data-analytics");
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: name, hotline });
      });
    </script>

    <script is:inline>
      // Header sticky clone trượt xuống khi cuộn qua cụm header tĩnh (chuẩn Woodmart).
      // Quan sát thẻ mốc sentinel: callback chỉ chạy khi vượt qua hoặc quay lại,
      // hoạt động 100% trên GPU với transform translateY nên không drop FPS và không layout shift.
      (() => {
        const sentinel = document.querySelector("[data-header-sentinel]");
        const stickyHeader = document.querySelector("[data-sticky-clone]");
        if (!sentinel || !stickyHeader) return;

        if (!("IntersectionObserver" in window)) return;

        new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              stickyHeader.classList.add("-translate-y-full");
              stickyHeader.classList.remove("translate-y-0");
            } else {
              stickyHeader.classList.remove("-translate-y-full");
              stickyHeader.classList.add("translate-y-0");
            }
          },
          { threshold: 0 },
        ).observe(sentinel);
      })();
    </script>

    <script is:inline>
      // Header CFC dính + hiệu ứng bật xuống: đánh dấu data-stuck khi cuộn khỏi
      // đầu trang (CSS lo animation). Hai ngưỡng khác nhau để không nhấp nháy
      // khi dừng quanh mốc: bật ở >24px, tắt chỉ khi về hẳn 0.
      (() => {
        const header = document.querySelector("[data-header-drop]");
        if (!header) return;
        let ticking = false;
        const update = () => {
          ticking = false;
          const y = window.scrollY;
          if (y > 24) header.setAttribute("data-stuck", "");
          else if (y <= 0) header.removeAttribute("data-stuck");
        };
        window.addEventListener(
          "scroll",
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
      })();
    </script>

    <script is:inline>
      // Reveal khi cuộn — IntersectionObserver thuần, không thư viện.
      // Bọc IIFE theo đúng quy ước của dự án (Astro gộp script inline của một
      // trang vào chung một scope, xem chú thích trong ProductFilter.astro).
      (() => {
        const targets = document.querySelectorAll("[data-reveal], [data-reveal-group]");
        if (!targets.length) return;

        const show = (el) => el.setAttribute(el.hasAttribute("data-reveal-group") ? "data-reveal-group" : "data-reveal", "in");

        // Trình duyệt không hỗ trợ thì hiện tất cả ngay, không để trang trắng.
        if (!("IntersectionObserver" in window)) {
          targets.forEach(show);
          return;
        }

        // Gán độ trễ lần lượt cho con của mỗi lưới. Làm ngay lúc này (không đợi
        // lúc hiện) vì đặt một CSS variable không đụng gì tới hiển thị — không
        // có nguy cơ nháy như khi thêm/bớt thuộc tính điều khiển opacity.
        document.querySelectorAll("[data-reveal-group]").forEach((group) => {
          Array.from(group.children).forEach((child, i) => {
            child.style.setProperty("--reveal-delay", `calc(var(--stagger-reveal) * ${i})`);
          });
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              show(entry.target);
              // Chạy một lần: cuộn ngược lên không làm nội dung biến mất lại.
              io.unobserve(entry.target);
            });
          },
          // Lùi mép dưới 10%: khối chỉ hiện khi đã cuộn vào hẳn khung nhìn,
          // không phải lúc vừa ló một đường ở đáy màn hình.
          //
          // `threshold: 0` chứ KHÔNG phải 0.1: ngưỡng theo tỉ lệ tính trên chiều
          // cao chính khối đó, nên khối cao hơn khung nhìn không bao giờ đạt
          // nổi — lưới sản phẩm mobile 2 cột dài vài nghìn px thì 10% của nó
          // lớn hơn cả màn hình, card sẽ kẹt opacity 0 vĩnh viễn. Riêng mép
          // dưới -10% đã đủ giữ ý đồ "vào hẳn rồi mới hiện".
          { rootMargin: "0px 0px -10% 0px", threshold: 0 },
        );

        targets.forEach((el) => io.observe(el));

        // LẦN VẼ ĐẦU: mọi khối đã nằm trong khung nhìn phải hiện ngay, kể cả
        // khối mới ló một phần ở đáy. Giao hết cho observer thì mép dưới -10%
        // quay ra hại: người mới vào trang thấy một mảng trắng ngay dưới nếp
        // gấp (trên mobile là lưới BÁN CHẠY) và tưởng trang lỗi, vì nội dung
        // chỉ hiện sau cú cuộn đầu tiên. Sau lần này observer lo phần còn lại.
        //
        // Hai lớp requestAnimationFrame là BẮT BUỘC, không phải cho chắc: script
        // này chạy cuối <body>, có thể trước lần vẽ đầu tiên. Đổi opacity lúc đó
        // thì trình duyệt gộp 0 → 1 vào cùng một lần tính style, không có giá
        // trị đầu nào từng được vẽ nên transition KHÔNG chạy — khối chữ hiện
        // bụp một cái. Chờ qua một frame là chắc chắn đã vẽ trạng thái mờ.
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            targets.forEach((el) => {
              if (el.getBoundingClientRect().top >= window.innerHeight) return;
              io.unobserve(el);
              show(el);
            });
          });
        });
      })();
    </script>
  </body>
</html>
