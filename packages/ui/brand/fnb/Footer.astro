---
/**
 * Footer 3 cột theo mockup: pháp nhân + chứng nhận + policy + social |
 * 4 khối liên hệ | form đăng ký nhận bảng giá. Kèm copyright bar + scroll-top.
 *
 * Form newsletter POST thẳng vào Worker (workers/quote-handler) — có
 * fallback không-JS: submit thật, Worker trả về redirect.
 */
import { Icon } from "astro-icon/components";
import { BRANDS, POLICY_LINKS, otherBrands, type FnbBrandId } from "@config/brands";
import BrandLogo from "@ui/brand/fnb/BrandLogo.astro";

interface Props {
  brand: FnbBrandId;
  /** Endpoint Worker nhận form; đổi ở .env khi deploy */
  formEndpoint?: string;
}

const { brand, formEndpoint = "/api/subscribe" } = Astro.props;
const b = BRANDS[brand];

const newsletterCopy: Record<FnbBrandId, { title: string; desc: string }> = {
  catbox: {
    title: "Đăng ký nhận catalogue năng lực",
    desc: "Hồ sơ năng lực sản xuất, bảng chất liệu và case study mới nhất.",
  },
  tetta: {
    title: "Đăng ký nhận catalogue Tết",
    desc: "Bộ sưu tập hộp quà theo mùa và bảng giá cập nhật.",
  },
  cfc: {
    title: "Đăng ký nhận bảng giá sỉ",
    desc: "Bảng giá cập nhật theo chất liệu Kraft / MG và số lượng đặt.",
  },
};
const copy = newsletterCopy[brand];

/** Link chéo sang 2 domain còn lại — kênh internal-link duy nhất còn lại giữa
 * 3 site sau khi bỏ khối Ecosystem trước footer (REQUIREMENTS §2.3). Dùng
 * `name — tagline` làm anchor text để link còn ngữ cảnh cho SEO. */
const siblings = otherBrands(brand);
---

<footer class="bg-primary-deep text-white">
  <div class="site-container grid gap-14 py-18 lg:grid-cols-[1.25fr_1.1fr_0.95fr]">
    <!-- Cột 1: pháp nhân + chứng nhận + policy + social -->
    <div class="flex flex-col gap-5">
      <div class="flex items-center gap-3">
        <BrandLogo brand={brand} variant="dark" />
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        {
          b.certifications.map((c) => (
            <span class="pill flex items-center gap-1.5 border border-white/15 bg-white/8 px-3.5 py-2 text-tiny text-white">
              <Icon name="lucide:check" class="size-3.5" aria-hidden="true" /> {c}
            </span>
          ))
        }
      </div>

      <p class="text-nav leading-relaxed font-medium text-white/80">{b.legalName}</p>

      <ul class="flex flex-col gap-3">
        {
          b.contacts.map((c) => (
            <li class="flex items-start gap-3">
              <Icon name={c.icon} class="mt-0.5 size-[18px] flex-none text-white/70" aria-hidden="true" />
              <div class="flex flex-col gap-0.5">
                <span class="text-tiny font-semibold tracking-wide text-white/45 uppercase">
                  {c.label}
                </span>
                {c.href ? (
                  <a
                    href={c.href}
                    class="text-[14px] leading-snug font-semibold text-white transition-colors hover:text-primary"
                  >
                    {c.value}
                  </a>
                ) : (
                  <span class="text-[14px] leading-snug font-semibold text-white">{c.value}</span>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <ul class="flex flex-col gap-2.5">
        {
          POLICY_LINKS.map((p) => (
            <li>
              <a href={p.href} class="text-sm text-white/60 transition-colors hover:text-white">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-1 flex items-center gap-2.5">
        {
          b.social.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              class="grid size-[38px] place-items-center rounded-[11px] bg-white/10 text-xs font-bold text-white transition-colors hover:bg-white/20"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Cột 2: tư vấn bán hàng (sale trực page) + hotline dịch vụ -->
    <div class="flex flex-col gap-4.5">
      <h2 class="text-meta font-bold tracking-[1.2px] text-white uppercase">Tư vấn bán hàng</h2>
      <ul class="flex flex-col gap-2.5">
        {
          b.salesReps.map((r) => (
            <li>
              <a
                href={`https://zalo.me/${r.phone.replace(/\D/g, "")}`}
                target="_blank"
                rel="noopener"
                data-analytics="click_zalo_sale"
                class="group flex items-center gap-2.5 text-nav text-white transition-colors hover:text-primary"
              >
                <span
                  aria-hidden="true"
                  class="grid size-(--size-icon-chip) flex-none place-items-center overflow-hidden rounded-chip"
                >
                  <img src="/zalo.png" alt="" class="size-4/5 object-contain" />
                </span>
                <span class="font-semibold">{r.name}:</span>
                <span class="text-white/75 transition-colors group-hover:text-primary">
                  {r.phone}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-2 text-meta font-bold tracking-[1.2px] text-white uppercase">
        Hotline phản ánh dịch vụ
      </h2>
      <ul class="flex flex-col gap-2.5">
        {
          b.serviceHotlines.map((h) => (
            <li>
              <a
                href={`tel:+84${h.replace(/\D/g, "").replace(/^0/, "")}`}
                data-analytics="click_hotline"
                class="flex items-center gap-2.5 text-nav font-semibold text-white transition-colors hover:text-primary"
              >
                <span
                  aria-hidden="true"
                  class="grid size-(--size-icon-chip) flex-none place-items-center rounded-chip bg-primary"
                >
                  <Icon name="lucide:phone" class="size-3 text-white" />
                </span>
                {h}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="border-t border-white/12 pt-3 text-micro leading-relaxed text-white/45">
        KV Hà Nội / Hà Nam: thanh toán khi nhận hàng · Ngoài KV: thanh toán trước khi giao
      </p>
    </div>

    <!-- Cột 3: newsletter -->
    <div class="flex flex-col gap-4">
      <h2 class="text-meta font-bold tracking-[1.2px] text-white uppercase">{copy.title}</h2>
      <p class="text-sm leading-relaxed text-white/60">{copy.desc}</p>
      <form
        method="post"
        action={formEndpoint}
        class="flex flex-col gap-2.5"
        data-newsletter
        data-brand={brand}
      >
        <input type="hidden" name="brand" value={brand} />
        <!-- Bẫy bot: người thật không bao giờ điền -->
        <input
          type="text"
          name="company_website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="absolute -left-[9999px] size-px"
        />
        <label class="sr-only" for="footer-email">Email của bạn</label>
        <input
          id="footer-email"
          type="email"
          name="email"
          required
          placeholder="Email của bạn"
          class="h-12 rounded-chip border border-white/20 bg-white/8 px-4.5 text-nav text-white outline-none placeholder:text-white/45 focus-visible:border-white/50"
        />
        <button
          type="submit"
          class="h-12 rounded-chip bg-cta text-body font-bold text-white transition-colors hover:bg-cta-hover"
        >
          Gửi
        </button>
        <p data-newsletter-msg role="status" class="min-h-5 text-micro text-white/70"></p>
      </form>
    </div>
  </div>

  <div class="border-t border-white/12">
    <div class="site-container flex flex-wrap items-center gap-x-7 gap-y-3 py-4">
      <span class="text-tiny font-semibold tracking-wide text-white/45 uppercase">
        Hệ sinh thái Catbox Packaging
      </span>
      {
        siblings.map((o) => (
          <a
            href={o.site}
            class="flex items-center gap-2 text-meta font-semibold text-white/75 transition-colors hover:text-primary"
          >
            <Icon name={o.icon} class="size-4 flex-none" aria-hidden="true" />
            {o.name} — {o.tagline}
          </a>
        ))
      }
    </div>
  </div>

  <div class="border-t border-white/12">
    <div class="site-container flex items-center justify-between gap-4 py-5">
      <p class="text-meta text-white/50">
        © {new Date().getFullYear()} {b.short} — {b.legalName}
      </p>
      <a
        href="#top"
        aria-label="Lên đầu trang"
        class="grid size-[42px] flex-none place-items-center rounded-full bg-primary text-[17px] font-bold text-white transition-colors hover:bg-primary-hover"
      >
        ↑
      </a>
    </div>
  </div>
</footer>

<script>
  // Newsletter: chặn reload, gửi qua fetch. Không JS → form vẫn POST bình thường.
  document.querySelectorAll<HTMLFormElement>("form[data-newsletter]").forEach((form) => {
    const msg = form.querySelector<HTMLElement>("[data-newsletter-msg]");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = form.querySelector("button")!;
      btn.disabled = true;
      if (msg) msg.textContent = "Đang gửi…";
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        if (msg) msg.textContent = "Đã ghi nhận. Cảm ơn bạn!";
        form.reset();
      } catch {
        if (msg) msg.textContent = "Gửi chưa được — vui lòng gọi hotline giúp mình.";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
