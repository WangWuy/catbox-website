---
/**
 * Footer 3 cột theo mockup: pháp nhân + chứng nhận + liên hệ | tư vấn bán
 * hàng + hotline | policy + social. Kèm copyright bar.
 * (Nút "lên đầu trang" nay là FloatingCta dạng nổi, hiện khi cuộn — không
 * còn nằm tĩnh trong Footer.)
 */
import { Icon } from "astro-icon/components";
import { BRANDS, POLICY_LINKS, type FnbBrandId, type CertBadge as CertBadgeType } from "@config/brands";
import BrandLogo from "@ui/brand/fnb/BrandLogo.astro";
import CertBadge from "@ui/brand/fnb/CertBadge.astro";

interface Props {
  brand: FnbBrandId;
  /**
   * Link cột chính sách. Site truyền vào danh sách dựng từ content (chính sách
   * + trang khách tự tạo có tick "hiện ở chân trang"), nhờ vậy khách đổi tên
   * hay thêm một chính sách mới là chân trang tự cập nhật.
   *
   * Bỏ trống thì dùng `POLICY_LINKS` tĩnh — site chưa CMS-hoá phần này vẫn chạy.
   */
  footerLinks?: { label: string; href: string }[];
  /**
   * true khi trang đặt TrustStrip (variant="panel") ngay trước Footer với
   * margin âm `--overlap-trust-strip` đè lên mép trên — cộng thêm padding-top
   * bù đúng khoảng đó để nội dung cột 1 không bị thẻ che mất.
   */
  overlapTrustStrip?: boolean;
  /**
   * Danh sách logo chứng nhận / kiểm định (ISO, HACCP, Sở/Bộ Công Thương...).
   * Mặc định lấy từ `b.certLogos` trong cài đặt brand.
   */
  certLogos?: CertBadgeType[];
  /**
   * Tiêu đề nhỏ phía trên nhóm logo chứng nhận.
   * Mặc định: "Chứng nhận chất lượng & Đăng ký" (để trống nếu không muốn hiện chữ).
   */
  certTitle?: string;
}

const {
  brand,
  footerLinks,
  overlapTrustStrip = false,
  certLogos,
  certTitle = "Chứng nhận chất lượng & Đăng ký",
} = Astro.props;
const policyLinks = footerLinks?.length ? footerLinks : POLICY_LINKS;
const b = BRANDS[brand];

// Fallback badges nếu chưa khai báo trong JSON
const fallbackCertLogos: CertBadgeType[] = [
  {
    id: "iso",
    name: "ISO 9001:2015",
    label: "Quản lý chất lượng",
    sub: "Tiêu chuẩn quốc tế",
    type: "iso",
    href: "/quy-trinh",
  },
  {
    id: "haccp",
    name: "HACCP CODEX",
    label: "An toàn thực phẩm",
    sub: "Đạt chuẩn F&B",
    type: "haccp",
    href: "/quy-trinh",
  },
  {
    id: "bocongthuong",
    name: "ĐÃ THÔNG BÁO",
    label: "Bộ Công Thương",
    sub: "online.gov.vn",
    type: "bocongthuong",
    href: "http://online.gov.vn",
    src: "/bo-cong-thuong.png",
  },
];

const badges = certLogos?.length
  ? certLogos
  : b.certLogos?.length
    ? b.certLogos
    : brand === "cfc"
      ? fallbackCertLogos
      : [];

// Dòng điều khoản dưới cột 2 đọc từ "Cài đặt" của brand — trước đây là một
// map 3 brand nằm ngay trong component, sửa lời điều khoản phải vào sửa code.
const copy = b.footer;

// Chuẩn hóa link mạng xã hội & sàn TMĐT: fallback an toàn nếu để trống hoặc #
const getSocialHref = (s: { label: string; href: string }) => {
  if (s.href && s.href !== "#") return s.href;
  const l = s.label.toLowerCase();
  if (l.includes("zalo")) {
    return b.zalo ? `https://zalo.me/${b.zalo.replace(/\D/g, "")}` : "https://zalo.me";
  }
  if (l.includes("shopee")) {
    return "https://shopee.vn";
  }
  if (l === "f" || l.includes("face")) {
    return "https://facebook.com";
  }
  return s.href || "#";
};

// Đảm bảo brand cfc luôn có Shopee bên phải Zalo kể cả khi dữ liệu CMS chưa nạp lại
const socialList = [...b.social];
if (brand === "cfc" && !socialList.some((s) => s.label.toLowerCase().includes("shopee"))) {
  socialList.push({ label: "Shopee", href: "https://shopee.vn" });
}
---

<footer class:list={["bg-primary-deep text-white", { "pt-(--overlap-trust-strip)": overlapTrustStrip }]}>
  <div
    class="site-container grid items-start gap-10 py-14 md:grid-cols-2 md:gap-14 md:py-18 lg:grid-cols-(--cols-footer)"
  >
    <!-- Cột 1: pháp nhân + chứng nhận + liên hệ (policy + social nay ở cột 3) -->
    <div class="flex flex-col gap-5 lg:row-span-2">
      <div class="flex items-center gap-3">
        <BrandLogo brand={brand} variant="dark" />
      </div>

      {
        b.certifications.length > 0 && (
          <div class="flex flex-wrap items-center gap-2.5">
            {b.certifications.map((c) => (
              <span class="pill flex items-center gap-1.5 border border-white/15 bg-white/8 px-3.5 py-2 text-tiny text-white">
                <Icon name="lucide:check" class="size-3.5" aria-hidden="true" /> {c}
              </span>
            ))}
          </div>
        )
      }

      <p class="text-nav leading-relaxed font-medium text-white/80">{b.legalName}</p>

      <ul class="flex flex-col gap-3">
        {
          b.contacts.map((c) => (
            <li class="flex items-start gap-3">
              <Icon name={c.icon} class="mt-0.5 size-(--size-icon-contact) flex-none text-white/70" aria-hidden="true" />
              <div class="flex flex-col gap-0.5">
                <span class="text-tiny font-semibold tracking-wide text-white/45 uppercase">
                  {c.label}
                </span>
                {c.href ? (
                  <a
                    href={c.href}
                    class="text-footer-contact leading-snug font-semibold text-white transition-colors hover:text-primary"
                  >
                    {c.value}
                  </a>
                ) : (
                  <span class="text-footer-contact leading-snug font-semibold text-white">{c.value}</span>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Cột 2: tư vấn bán hàng (sale trực page) + hotline dịch vụ -->
    <div class="flex flex-col gap-4.5">
      <h2 class="text-meta font-bold tracking-eyebrow text-white uppercase">Tư vấn bán hàng</h2>
      <ul class="flex flex-col gap-2.5">
        {
          b.salesReps.map((r) => (
            <li>
              <a
                href={`https://zalo.me/${r.phone.replace(/\D/g, "")}`}
                target="_blank"
                rel="noopener"
                data-analytics="click_zalo_sale"
                class="group flex items-center gap-2.5 text-nav text-white transition-colors hover:text-primary"
              >
                <span
                  aria-hidden="true"
                  class="grid size-(--size-icon-chip) flex-none place-items-center overflow-hidden rounded-chip"
                >
                  <img src="/zalo.png" alt="" class="size-4/5 object-contain" />
                </span>
                <span class="font-semibold">{r.name}:</span>
                <span class="text-white/75 transition-colors group-hover:text-primary">
                  {r.phone}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-2 text-meta font-bold tracking-eyebrow text-white uppercase">
        Hotline phản ánh dịch vụ
      </h2>
      <ul class="flex flex-col gap-2.5">
        {
          b.serviceHotlines.map((h) => (
            <li>
              <a
                href={`tel:+84${h.replace(/\D/g, "").replace(/^0/, "")}`}
                data-analytics="click_hotline"
                class="flex items-center gap-2.5 text-nav font-semibold text-white transition-colors hover:text-primary"
              >
                <span
                  aria-hidden="true"
                  class="grid size-(--size-icon-chip) flex-none place-items-center rounded-chip bg-primary"
                >
                  <Icon name="lucide:phone" class="size-3 text-white" />
                </span>
                {h}
              </a>
            </li>
          ))
        }
      </ul>

      {
        copy.terms && (
          <p class="border-t border-white/12 pt-3 text-micro leading-relaxed text-white/45">
            {copy.terms}
          </p>
        )
      }
    </div>

    <!-- Cột 3: policy + social (trước đây là form newsletter) -->
    <div class="flex flex-col gap-4">
      <h2 class="text-meta font-bold tracking-eyebrow text-white uppercase">Chính sách bán hàng</h2>
      <ul class="flex flex-col gap-2.5">
        {
          policyLinks.map((p) => (
            <li>
              <a href={p.href} class="text-sm text-white/60 transition-colors hover:text-white">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-1 flex items-center gap-2.5">
        {
          socialList.map((s) => {
            const href = getSocialHref(s);
            const isShopee = s.label.toLowerCase().includes("shopee");
            const isFb = s.label.toLowerCase() === "f" || s.label.toLowerCase().includes("face");
            const isZalo = s.label.toLowerCase().includes("zalo");

            return (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${b.name} ${s.label}`}
                data-analytics={isZalo ? "click_zalo" : undefined}
                class:list={[
                  "grid size-(--size-social-btn) place-items-center rounded-social-btn bg-white/10 text-xs font-bold text-white transition-all",
                  isShopee && "hover:bg-[#EE4D2D] hover:text-white",
                  isFb && "hover:bg-[#1877F2] hover:text-white",
                  isZalo && "hover:bg-[#0068FF] hover:text-white",
                  !isShopee && !isFb && !isZalo && "hover:bg-white/20",
                ]}
              >
                {isShopee ? (
                  <svg class="size-4.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15.9414 17.9633c.229-1.879-.981-3.077-4.1758-4.0969-1.548-.528-2.277-1.22-2.26-2.1719.065-1.056 1.048-1.825 2.352-1.85a5.2898 5.2898 0 0 1 2.8838.89c.116.072.197.06.263-.039.09-.145.315-.494.39-.62.051-.081.061-.187-.068-.281-.185-.1369-.704-.4149-.983-.5319a6.4697 6.4697 0 0 0-2.5118-.514c-1.909.008-3.4129 1.215-3.5389 2.826-.082 1.1629.494 2.1078 1.73 2.8278.262.152 1.6799.716 2.2438.892 1.774.552 2.695 1.5419 2.478 2.6969-.197 1.047-1.299 1.7239-2.818 1.7439-1.2039-.046-2.2878-.537-3.1278-1.19l-.141-.11c-.104-.08-.218-.075-.287.03-.05.077-.376.547-.458.67-.077.108-.035.168.045.234.35.293.817.613 1.134.775a6.7097 6.7097 0 0 0 2.8289.727 4.9048 4.9048 0 0 0 2.0759-.354c1.095-.465 1.8029-1.394 1.9449-2.554zM11.9986 1.4009c-2.068 0-3.7539 1.95-3.8329 4.3899h7.6657c-.08-2.44-1.765-4.3899-3.8328-4.3899zm7.8516 22.5981-.08.001-15.7843-.002c-1.074-.04-1.863-.91-1.971-1.991l-.01-.195L1.298 6.2858a.459.459 0 0 1 .45-.494h4.9748C6.8448 2.568 9.1607 0 11.9996 0c2.8388 0 5.1537 2.5689 5.2757 5.7898h4.9678a.459.459 0 0 1 .458.483l-.773 15.5883-.007.131c-.094 1.094-.979 1.9769-2.0709 2.0059z" />
                  </svg>
                ) : (
                  s.label
                )}
              </a>
            );
          })
        }
      </div>
    </div>

    <!-- Vị trí logo chứng nhận: ISO, HACCP, Sở / Bộ Công Thương (dưới phần tư vấn bán hàng và chính sách bán hàng) -->
    {
      badges.length > 0 && (
        <div class="border-t border-white/12 pt-6 md:col-span-2 lg:col-start-2 lg:col-span-2">
          <div class="flex flex-col gap-3">
            {certTitle && (
              <span class="text-tiny font-semibold tracking-wide text-white/50 uppercase">
                {certTitle}
              </span>
            )}
            <div class="flex flex-wrap items-center gap-4.5 pt-1 md:gap-6">
              <slot name="certifications">
                {badges.map((item) => (
                  <CertBadge {...item} />
                ))}
              </slot>
            </div>
          </div>
        </div>
      )
    }
  </div>

  <div class="border-t border-white/12">
    <div class="site-container py-5">
      <p class="text-meta text-white/50">
        © {new Date().getFullYear()} {b.short}{b.legalName && b.legalName !== b.short ? ` — ${b.legalName}` : ""}
      </p>
    </div>
  </div>
</footer>
