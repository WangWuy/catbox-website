---
/**
 * Header riêng của CFC — Bố cục 2 dòng theo phong cách 2T Print (INDUSTRIAL FAST-COMMERCE):
 * - Dòng trên: Nền sáng — Logo CFC bên trái, bên phải gồm nút Hotline bo tròn + cụm icon Facebook, TikTok.
 * - Dòng dưới: Nền nâu Kraft đặc trưng (--color-primary-deep #3E2723) — Nút "SẢN PHẨM" nổi bật
 *   màu cam (--color-primary #E67E22) mở Mega Menu, dải menu in hoa (TRANG CHỦ, GIỚI THIỆU,
 *   TIN TỨC, LIÊN HỆ), góc phải thanh tìm kiếm SearchBox với nút kính lúp.
 * - Mobile: Hiển thị tinh gọn với Drawer Hamburger (chứa search + menu accordion), Logo, Hotline.
 * - Hỗ trợ thanh sticky clone thu gọn trượt xuống khi cuộn chuột.
 */
import { Icon } from "astro-icon/components";
import { BRANDS } from "@config/brands";
import type { NavEntry } from "@config/nav";
import BrandLogo from "@ui/brand/fnb/BrandLogo.astro";
import MobileNav from "@ui/brand/fnb/MobileNav.astro";

interface Props {
  items?: NavEntry[];
  current?: string;
  isStickyClone?: boolean;
}

const { items = [], current = "/", isStickyClone = false } = Astro.props;
const brand = "cfc";
const b = BRANDS[brand];

const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);

// Tách mục Sản phẩm (có Mega Menu) và các mục còn lại
const productsItem = items.find((i) => i.href === "/products") || items[0];
const otherItems = items.filter((i) => i !== productsItem);

// Liên kết mạng xã hội (Facebook, TikTok)
const fbSocial = b.social.find(
  (s) => s.label.toLowerCase() === "f" || s.label.toLowerCase().includes("face"),
);
const spSocial = b.social.find((s) => s.label.toLowerCase().includes("shopee"));
const fbHref = fbSocial?.href && fbSocial.href !== "#" ? fbSocial.href : "https://facebook.com";
const spHref = spSocial?.href && spSocial.href !== "#" ? spSocial.href : "https://shopee.vn";

// Định dạng số điện thoại tách cụm 4 - 2 - 4 (vd: 0947 89 5599)
const formatHotline = (phone: string) => {
  const digits = phone.replace(/\D/g, "");
  if (digits.length === 10) {
    return `${digits.slice(0, 4)} ${digits.slice(4, 6)} ${digits.slice(6)}`;
  }
  return phone;
};
const displayHotline = formatHotline(b.hotline);
---

<header
  data-sticky-clone={isStickyClone ? "" : undefined}
  data-header-drop={isStickyClone ? undefined : ""}
  class:list={[
    "transition-colors",
    isStickyClone
      ? "fixed top-0 left-0 right-0 z-(--z-header) -translate-y-full bg-primary-deep text-white shadow-(--shadow-header) transition-transform duration-(--duration-base) ease-(--ease-out-soft)"
      : "sticky top-0 z-(--z-header) w-full",
  ]}
>
  {
    /* =========================================================================
     * DESKTOP: BỐ CỤC 2 DÒNG (md:flex)
     * ========================================================================= */
  }
  {
    !isStickyClone ? (
      <>
        {/* DÒNG TRÊN: Logo bên trái + Hotline & Mạng xã hội bên phải (Chiều cao 70px, nền trắng trong suốt nhẹ) */}
        <div class="hidden h-[70px] border-b border-black/5 bg-white/92 md:flex md:items-center">
          <div class="site-container flex w-full items-center justify-between gap-4">
            {/* Logo */}
            <a
              href="/"
              class="flex flex-none items-center gap-3 transition-opacity hover:opacity-95 [&_img]:max-h-[52px] [&_img]:w-auto"
              aria-label={`${b.name} — trang chủ`}
            >
              <BrandLogo brand="cfc" transparent />
            </a>

            {/* Bên phải: Hotline + Biểu tượng Facebook / TikTok */}
            <div class="flex items-center gap-4">
              {/* Nút Hotline bo tròn nổi bật */}
              <a
                href={b.hotlineHref || `tel:${b.hotline.replace(/\D/g, "")}`}
                data-analytics="click_hotline"
                class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-1.5 text-sm font-bold text-white shadow-xs transition-all hover:bg-primary-hover hover:scale-[1.02]"
              >
                <Icon name="lucide:phone" class="size-3.5 fill-current" aria-hidden="true" />
                <span>{displayHotline}</span>
              </a>

              {/* Biểu tượng Facebook / TikTok */}
              <div class="flex items-center gap-2">
                <a
                  href={fbHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="CFC Facebook"
                  class="flex size-8 items-center justify-center rounded-full bg-surface-alt text-ink-muted transition-all hover:bg-[#1877F2] hover:text-white"
                >
                  <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                  </svg>
                </a>
                <a
                  href={spHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="CFC Shopee"
                  class="flex size-8 items-center justify-center rounded-full bg-surface-alt text-ink-muted transition-all hover:bg-[#EE4D2D] hover:text-white"
                >
                  <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15.9414 17.9633c.229-1.879-.981-3.077-4.1758-4.0969-1.548-.528-2.277-1.22-2.26-2.1719.065-1.056 1.048-1.825 2.352-1.85a5.2898 5.2898 0 0 1 2.8838.89c.116.072.197.06.263-.039.09-.145.315-.494.39-.62.051-.081.061-.187-.068-.281-.185-.1369-.704-.4149-.983-.5319a6.4697 6.4697 0 0 0-2.5118-.514c-1.909.008-3.4129 1.215-3.5389 2.826-.082 1.1629.494 2.1078 1.73 2.8278.262.152 1.6799.716 2.2438.892 1.774.552 2.695 1.5419 2.478 2.6969-.197 1.047-1.299 1.7239-2.818 1.7439-1.2039-.046-2.2878-.537-3.1278-1.19l-.141-.11c-.104-.08-.218-.075-.287.03-.05.077-.376.547-.458.67-.077.108-.035.168.045.234.35.293.817.613 1.134.775a6.7097 6.7097 0 0 0 2.8289.727 4.9048 4.9048 0 0 0 2.0759-.354c1.095-.465 1.8029-1.394 1.9449-2.554zM11.9986 1.4009c-2.068 0-3.7539 1.95-3.8329 4.3899h7.6657c-.08-2.44-1.765-4.3899-3.8328-4.3899zm7.8516 22.5981-.08.001-15.7843-.002c-1.074-.04-1.863-.91-1.971-1.991l-.01-.195L1.298 6.2858a.459.459 0 0 1 .45-.494h4.9748C6.8448 2.568 9.1607 0 11.9996 0c2.8388 0 5.1537 2.5689 5.2757 5.7898h4.9678a.459.459 0 0 1 .458.483l-.773 15.5883-.007.131c-.094 1.094-.979 1.9769-2.0709 2.0059z" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* DÒNG DƯỚI: Nền Nâu — SẢN PHẨM (Button Cam) + Menu Viết Hoa + Thanh Tìm Kiếm */}
        <div class="hidden bg-primary-deep text-white shadow-md md:block">
          <div class="site-container flex h-12 items-center justify-between gap-4">
            {/* Nhóm Điều Hướng Trái */}
            <div class="flex h-full items-center gap-2 lg:gap-6 min-w-0">
              {/* Button SẢN PHẨM (Màu Cam) mở Mega Menu */}
              <div class="group/prod-nav relative flex h-full items-center">
                <a
                  href="/products"
                  class="flex h-full items-center gap-2.5 bg-primary px-5 text-(length:--text-header-nav) font-semibold tracking-wider text-white uppercase select-none transition-colors hover:bg-primary-hover"
                >
                  <Icon name="lucide:layout-grid" class="size-4" aria-hidden="true" />
                  <span>SẢN PHẨM</span>
                  <Icon
                    name="lucide:chevron-down"
                    class="size-3.5 text-white/80 transition-transform duration-200 group-hover/prod-nav:rotate-180"
                    aria-hidden="true"
                  />
                </a>

                {/* Dropdown Mega Menu Danh Mục */}
                {productsItem?.megaParents && productsItem.megaParents.length > 0 && (
                  <div class="mega-menu-wrapper pointer-events-none absolute top-full left-0 z-(--z-header) w-[920px] max-w-[calc(100vw-2rem)] opacity-0 shadow-2xl transition-all duration-200 before:absolute before:-top-2 before:left-0 before:right-0 before:h-2 group-hover/prod-nav:pointer-events-auto group-hover/prod-nav:opacity-100">
                    <div class="mega-menu-card min-h-(--height-mega-min) flex overflow-hidden rounded-b-xl border border-line bg-surface-input shadow-2xl text-ink">
                      {/* Cột trái: Danh mục cha */}
                      <div class="w-(--width-mega-sidebar) lg:w-(--width-mega-sidebar-lg) flex shrink-0 flex-col gap-1.5 border-r border-line bg-surface-input py-3">
                        {productsItem.megaParents.map((parent, idx) => (
                          <a
                            href={parent.href}
                            data-parent-target={parent.slug}
                            data-active={idx === 0 ? "true" : "false"}
                            class="mega-parent-btn group/parent flex cursor-pointer select-none items-center justify-between gap-3 px-6 py-3 text-sm font-medium text-ink transition-all duration-(--duration-fast) data-[active=false]:hover:bg-surface-hover data-[active=true]:bg-surface-hover data-[active=true]:text-ink data-[active=true]:shadow-xs"
                          >
                            <div class="flex min-w-0 items-center gap-3">
                              {parent.icon && (
                                <Icon
                                  name={parent.icon}
                                  class="size-4.5 shrink-0 text-ink-muted transition-colors"
                                  aria-hidden="true"
                                />
                              )}
                              <span class="truncate">{parent.label}</span>
                            </div>
                            <Icon
                              name="lucide:chevron-right"
                              class="size-4 shrink-0 text-ink-faint transition-all group-data-[active=true]/parent:translate-x-0.5 group-hover/parent:translate-x-0.5"
                              aria-hidden="true"
                            />
                          </a>
                        ))}
                      </div>

                      {/* Khung phải: Danh mục con & Sản phẩm */}
                      <div class="flex flex-1 min-w-0 flex-col justify-between bg-surface-input p-6">
                        {productsItem.megaParents.map((parent, idx) => (
                          <div
                            data-parent-panel={parent.slug}
                            data-active={idx === 0 ? "true" : "false"}
                            class={`mega-panel h-full flex-col justify-between ${idx === 0 ? "flex" : "hidden"}`}
                          >
                            <div class="grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-3">
                              {parent.subcategories.map((sub) => (
                                <div class="flex min-w-0 flex-col gap-2">
                                  <a
                                    href={sub.href}
                                    class="group/sub flex items-start justify-between gap-1 border-b border-line-soft pb-1.5 text-sm font-bold text-ink transition-colors hover:text-primary"
                                  >
                                    <div class="flex items-start gap-1.5">
                                      {sub.icon && (
                                        <Icon
                                          name={sub.icon}
                                          class="mt-0.5 size-4 shrink-0 text-primary"
                                          aria-hidden="true"
                                        />
                                      )}
                                      <span>{sub.label}</span>
                                    </div>
                                    <Icon
                                      name="lucide:arrow-right"
                                      class="mt-0.5 size-3 shrink-0 text-primary opacity-0 transition-opacity group-hover/sub:opacity-100"
                                      aria-hidden="true"
                                    />
                                  </a>

                                  <ul class="flex flex-col gap-1.5 pt-0.5">
                                    {sub.items.length > 0 ? (
                                      sub.items.map((p) => (
                                        <li class="min-w-0">
                                          <a
                                            href={p.href}
                                            class="block py-0.5 text-(length:--text-meta) leading-snug text-ink-muted transition-all duration-(--duration-fast) hover:translate-x-0.5 hover:text-primary"
                                          >
                                            {p.label}
                                          </a>
                                        </li>
                                      ))
                                    ) : (
                                      <li>
                                        <a
                                          href={sub.href}
                                          class="text-xs italic text-ink-faint hover:text-primary"
                                        >
                                          Xem chi tiết nhóm →
                                        </a>
                                      </li>
                                    )}
                                  </ul>
                                </div>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* Dải menu: TRANG CHỦ, GIỚI THIỆU, TIN TỨC, LIÊN HỆ */}
              <nav aria-label="Menu chính" class="flex h-full items-center gap-1 lg:gap-3">
                {otherItems.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      "relative flex h-full select-none items-center px-3.5 text-(length:--text-header-nav) font-semibold tracking-wider uppercase transition-colors lg:px-4",
                      isActive(item.href)
                        ? "text-primary font-bold after:absolute after:bottom-0 after:left-3.5 after:right-3.5 after:h-0.75 after:bg-primary"
                        : "text-white/90 hover:bg-white/5 hover:text-white",
                    ]}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </div>

            {/* Góc bên phải: Thanh tìm kiếm */}
            <form
              role="search"
              action="/search"
              method="get"
              class="relative flex h-8.5 overflow-hidden border border-white/10 shadow-xs"
            >
              <label for="cfc-search" class="sr-only">
                Tìm kiếm
              </label>
              <input
                id="cfc-search"
                type="search"
                name="q"
                placeholder={b.searchPlaceholder || "Tìm kiếm sản phẩm..."}
                autocomplete="off"
                class="h-full w-44 bg-white px-3 text-xs text-ink placeholder:text-ink-faint focus:outline-none md:w-52 lg:w-64"
              />
              <button
                type="submit"
                aria-label="Tìm kiếm"
                class="flex h-full flex-none items-center justify-center bg-primary px-3.5 text-white transition-colors hover:bg-primary-hover"
              >
                <Icon name="lucide:search" class="size-4" aria-hidden="true" />
              </button>
            </form>
          </div>
        </div>
      </>
    ) : (
      /* =========================================================================
       * DESKTOP: STICKY CLONE HEADER (Thu gọn trượt xuống khi cuộn)
       * ========================================================================= */
      <div class="site-container hidden h-12 items-center justify-between gap-4 md:flex">
        {/* Bên trái: Logo compact + SẢN PHẨM button */}
        <div class="flex h-full items-center gap-4">
          <a
            href="/"
            class="flex flex-none items-center gap-2 transition-opacity hover:opacity-95 max-h-8 [&_img]:max-h-8"
            aria-label={`${b.name} — trang chủ`}
          >
            <BrandLogo brand="cfc" compact />
          </a>

          <a
            href="/products"
            class="flex h-full items-center gap-2 bg-primary px-4 text-xs font-semibold tracking-wider text-white uppercase transition-colors hover:bg-primary-hover"
          >
            <Icon name="lucide:layout-grid" class="size-3.5" aria-hidden="true" />
            <span>SẢN PHẨM</span>
          </a>

          {/* Dải link gọn */}
          <nav aria-label="Menu cuộn" class="flex h-full items-center gap-1">
            {otherItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "flex h-full select-none items-center px-2.5 text-xs font-semibold tracking-wider uppercase transition-colors",
                  isActive(item.href)
                    ? "text-primary font-bold"
                    : "text-white/90 hover:text-white",
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        {/* Bên phải: Hotline + Search box */}
        <div class="flex items-center gap-3">
          <a
            href={b.hotlineHref || `tel:${b.hotline.replace(/\D/g, "")}`}
            class="hidden items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-bold text-white transition-colors hover:bg-white/20 lg:inline-flex"
          >
            <Icon name="lucide:phone" class="size-3 fill-current text-primary" aria-hidden="true" />
            <span>{displayHotline}</span>
          </a>

          <form
            role="search"
            action="/search"
            method="get"
            class="relative flex h-7.5 overflow-hidden border border-white/10 shadow-xs"
          >
            <input
              type="search"
              name="q"
              placeholder="Tìm kiếm..."
              autocomplete="off"
              class="h-full w-36 bg-white px-2.5 text-xs text-ink placeholder:text-ink-faint focus:outline-none lg:w-48"
            />
            <button
              type="submit"
              aria-label="Tìm kiếm"
              class="flex h-full flex-none items-center justify-center bg-primary px-2.5 text-white transition-colors hover:bg-primary-hover"
            >
              <Icon name="lucide:search" class="size-3.5" aria-hidden="true" />
            </button>
          </form>
        </div>
      </div>
    )
  }

  {
    /* =========================================================================
     * MOBILE HEADER (md:hidden): Tinh gọn Logo + Drawer Hamburger + Hotline
     * ========================================================================= */
  }
  <div
    class:list={[
      "site-container flex items-center justify-between gap-3 md:hidden",
      isStickyClone ? "h-12 bg-surface text-ink border-b border-line-soft" : "h-14 bg-surface",
    ]}
  >
    {/* Trái: Drawer Hamburger */}
    <div class="flex-none">
      {items.length > 0 && <MobileNav {brand} {items} {current} />}
    </div>

    {/* Giữa: Logo */}
    <a
      href="/"
      class="flex flex-1 items-center justify-center min-w-0"
      aria-label={`${b.name} — trang chủ`}
    >
      <BrandLogo brand="cfc" compact />
    </a>

    {/* Phải: Hotline gọi ngay */}
    <a
      href={b.hotlineHref || `tel:${b.hotline.replace(/\D/g, "")}`}
      data-analytics="click_hotline"
      class="inline-flex flex-none items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 text-xs font-bold text-white shadow-xs transition-colors hover:bg-primary-hover"
      aria-label="Gọi hotline"
    >
      <Icon name="lucide:phone" class="size-3.5 text-white" aria-hidden="true" />
      <span>Hotline</span>
    </a>
  </div>
</header>

<script is:inline>
  // Chuyển đổi tab Danh mục cha -> Khung sản phẩm trong Mega Menu
  document.addEventListener("DOMContentLoaded", () => {
    const wrappers = document.querySelectorAll(".mega-menu-wrapper");
    wrappers.forEach((wrapper) => {
      const buttons = wrapper.querySelectorAll(".mega-parent-btn");
      const panels = wrapper.querySelectorAll(".mega-panel");
      const firstSlug = buttons[0]?.getAttribute("data-parent-target");

      function activate(targetSlug) {
        buttons.forEach((btn) => {
          const isTarget = btn.getAttribute("data-parent-target") === targetSlug;
          btn.setAttribute("data-active", isTarget ? "true" : "false");
        });

        panels.forEach((panel) => {
          const isTarget = panel.getAttribute("data-parent-panel") === targetSlug;
          panel.setAttribute("data-active", isTarget ? "true" : "false");
          if (isTarget) {
            panel.classList.remove("hidden");
            panel.classList.add("flex");
          } else {
            panel.classList.add("hidden");
            panel.classList.remove("flex");
          }
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener("mouseenter", () => {
          const slug = btn.getAttribute("data-parent-target");
          if (slug) activate(slug);
        });

        btn.addEventListener("focus", () => {
          const slug = btn.getAttribute("data-parent-target");
          if (slug) activate(slug);
        });
      });

      if (firstSlug) activate(firstSlug);
    });
  });
</script>
