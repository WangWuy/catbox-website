---
/**
 * Category Navigation — Mega Menu 3 cấp phân tầng theo mẫu chuẩn E-commerce:
 * 1. Cột trái: Danh mục cha (Parent categories) với icon và mũi tên >
 * 2. Khung phải: Danh mục con (Subcategory Header) + Sản phẩm / Phân loại chi tiết bên dưới
 * 3. Footer menu: Lối tắt xem tất cả sản phẩm
 *
 * Chạy bằng <details> kết hợp script chuyển tab tức thì trên hover (0 KB dependencies).
 *
 * CHỈ hiện từ `md` trở lên. Dưới md, toàn bộ menu nằm trong drawer của
 * `MobileNav` — nút mở drawer đã chuyển lên `MainHeader`, nên thanh này không
 * còn gì để hiển thị trên điện thoại (menu ngang và pill khuyến mãi vốn đã ẩn).
 *
 * `items` do `BaseLayout` dựng sẵn qua `buildNavEntries` rồi truyền xuống —
 * không tự dựng ở đây nữa, vì `MainHeader` cũng cần đúng danh sách này cho
 * drawer và hai nơi dựng bằng hai logic khác nhau thì nội dung sẽ lệch.
 */
import { Icon } from "astro-icon/components";
import type { NavEntry } from "@config/nav";
import { BRANDS, type FnbBrandId } from "@config/brands";

interface Props {
  brand: FnbBrandId;
  /** Pathname hiện tại để tô mục đang xem */
  current?: string;
  /** Menu đã dựng sẵn ở BaseLayout (`buildNavEntries`) */
  items?: NavEntry[];
}

const { brand, current = "/", items = [] } = Astro.props;
const b = BRANDS[brand];

const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<nav
  aria-label="Danh mục chính"
  class="relative z-(--z-catnav) hidden border-b border-line bg-surface md:block"
>
  <div
    class="site-container flex h-(--height-catnav) items-center justify-between gap-6"
  >
    <ul class="flex items-center gap-4 lg:gap-6">
      {
        items.map((item) => (
          <li class="flex-none">
            {item.isMega && item.megaParents && item.megaParents.length > 0 ? (
              <details class="group/nav-item [&[open]>summary>.chev]:rotate-180">
                <summary
                  class={`flex cursor-pointer list-none items-center gap-1.5 text-nav whitespace-nowrap select-none transition-colors ${
                    isActive(item.href) ? "font-bold text-primary" : "font-medium text-ink hover:text-primary"
                  }`}
                >
                  {item.icon && <Icon name={item.icon} class="size-4" aria-hidden="true" />}
                  {item.label}
                  <Icon
                    name="lucide:chevron-down"
                    class="chev size-3.5 text-ink-faint transition-transform duration-(--duration-fast)"
                    aria-hidden="true"
                  />
                </summary>

                {/* Dropdown Mega Menu */}
                <div class="mega-menu-wrapper absolute top-full left-0 z-(--z-catnav) w-full">
                  <div class="site-container py-4">
                    {/* Bố cục 2 cột. Chỉ tồn tại từ md trở lên — cả thẻ <nav>
                        bọc ngoài đã `hidden md:block`; dưới md là drawer của
                        MobileNav (mở từ nút trên MainHeader) lo. */}
                    <div class="mega-menu-card flex rounded-2xl border border-line bg-surface-input shadow-lg overflow-hidden min-h-(--height-mega-min)">

                      {/* CỘT TRÁI: Danh mục cha (Parent Categories Sidebar) */}
                      <div class="w-(--width-mega-sidebar) lg:w-(--width-mega-sidebar-lg) shrink-0 border-r border-line bg-surface-input py-3 flex flex-col gap-1.5">
                        {item.megaParents.map((parent, idx) => (
                          <a
                            href={parent.href}
                            data-parent-target={parent.slug}
                            data-active={idx === 0 ? "true" : "false"}
                            class="mega-parent-btn group/parent flex items-center justify-between gap-3 px-6 py-3 font-medium transition-all duration-(--duration-fast) text-sm cursor-pointer select-none text-ink data-[active=true]:bg-surface-hover data-[active=true]:text-ink data-[active=true]:shadow-xs data-[active=false]:hover:bg-surface-hover"
                          >
                            <div class="flex items-center gap-3 min-w-0">
                              {parent.icon && (
                                <Icon
                                  name={parent.icon}
                                  class="size-4.5 shrink-0 transition-colors text-ink-muted"
                                  aria-hidden="true"
                                />
                              )}
                              <span class="truncate">{parent.label}</span>
                            </div>
                            <Icon
                              name="lucide:chevron-right"
                              class="size-4 shrink-0 transition-all text-ink-faint group-data-[active=true]/parent:translate-x-0.5 group-hover/parent:translate-x-0.5"
                              aria-hidden="true"
                            />
                          </a>
                        ))}
                      </div>

                      {/* KHUNG PHẢI: Danh mục con & Sản phẩm (Child Groups & Products) */}
                      <div class="flex-1 min-w-0 p-6 bg-surface-input flex flex-col justify-between">
                        {item.megaParents.map((parent, idx) => (
                          <div
                            data-parent-panel={parent.slug}
                            data-active={idx === 0 ? "true" : "false"}
                            class={`mega-panel flex-col justify-between h-full ${idx === 0 ? "flex" : "hidden"}`}
                          >
                            {/* Lưới các cột Danh mục con */}
                            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-6">
                              {parent.subcategories.map((sub) => (
                                <div class="flex flex-col gap-2 min-w-0">
                                  {/* Tiêu đề Danh mục con (Bold Header) */}
                                  <a
                                    href={sub.href}
                                    class="group/sub font-bold text-sm text-ink hover:text-primary transition-colors flex items-start justify-between gap-1 pb-1.5 border-b border-line-soft"
                                  >
                                    <div class="flex items-start gap-1.5">
                                      {sub.icon && <Icon name={sub.icon} class="size-4 text-primary shrink-0 mt-0.5" aria-hidden="true" />}
                                      <span>{sub.label}</span>
                                    </div>
                                    <Icon name="lucide:arrow-right" class="size-3 text-primary opacity-0 group-hover/sub:opacity-100 transition-opacity shrink-0 mt-0.5" aria-hidden="true" />
                                  </a>

                                  {/* Danh sách Sản phẩm / Phân loại chi tiết */}
                                  <ul class="flex flex-col gap-1.5 pt-0.5">
                                    {sub.items.length > 0 ? (
                                      sub.items.map((p) => (
                                        <li class="min-w-0">
                                          <a
                                            href={p.href}
                                            class="text-(length:--text-meta) leading-snug text-ink-muted hover:text-primary hover:translate-x-0.5 transition-all duration-(--duration-fast) block py-0.5"
                                          >
                                            {p.label}
                                          </a>
                                        </li>
                                      ))
                                    ) : (
                                      <li>
                                        <a href={sub.href} class="text-xs text-ink-faint hover:text-primary italic">
                                          Xem chi tiết nhóm →
                                        </a>
                                      </li>
                                    )}
                                  </ul>
                                </div>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>

                    </div>

                  </div>
                </div>
              </details>
            ) : item.fallbackGroups && item.fallbackGroups.length > 0 ? (
              <details class="group [&[open]>summary>.chev]:rotate-180">
                <summary
                  class={`flex cursor-pointer list-none items-center gap-1.5 text-nav whitespace-nowrap ${
                    isActive(item.href) ? "font-bold text-primary" : "font-medium text-ink"
                  }`}
                >
                  {item.icon && <Icon name={item.icon} class="size-4" aria-hidden="true" />}
                  {item.label}
                  <Icon
                    name="lucide:chevron-down"
                    class="chev size-3.5 text-ink-faint transition-transform duration-(--duration-fast)"
                    aria-hidden="true"
                  />
                </summary>
                <div class="absolute top-full left-0 z-(--z-catnav) w-full border-y border-line bg-surface shadow-lg">
                  <div class="site-container grid gap-x-6 gap-y-4 py-5 sm:grid-cols-2 lg:grid-cols-4">
                    {item.fallbackGroups.map((g) => (
                      <div class="min-w-0">
                        {g.items.map((c) => (
                          <a
                            href={c.href}
                            class="block rounded-chip px-3 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-tint hover:text-primary"
                          >
                            {c.label}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class={`flex items-center gap-1.5 text-nav whitespace-nowrap ${
                  isActive(item.href) ? "font-bold text-primary" : "font-medium text-ink"
                }`}
              >
                {item.icon && <Icon name={item.icon} class="size-4" aria-hidden="true" />}
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <span
      class="pill hidden h-8 flex-none border border-line bg-surface-chip px-4 text-promo-pill font-bold text-ink-muted whitespace-nowrap lg:inline-flex"
    >
      {b.promoPill}
    </span>
  </div>
</nav>

<script is:inline>
  // Chuyển đổi tab Danh mục cha -> Khung sản phẩm tức thì khi rê chuột (0 KB lib)
  document.addEventListener("DOMContentLoaded", () => {
    const wrappers = document.querySelectorAll(".mega-menu-wrapper");
    wrappers.forEach((wrapper) => {
      const buttons = wrapper.querySelectorAll(".mega-parent-btn");
      const panels = wrapper.querySelectorAll(".mega-panel");
      const firstSlug = buttons[0]?.getAttribute("data-parent-target");
      const details = wrapper.closest("details");

      function activate(targetSlug) {
        buttons.forEach((btn) => {
          const isTarget = btn.getAttribute("data-parent-target") === targetSlug;
          btn.setAttribute("data-active", isTarget ? "true" : "false");
        });

        panels.forEach((panel) => {
          const isTarget = panel.getAttribute("data-parent-panel") === targetSlug;
          panel.setAttribute("data-active", isTarget ? "true" : "false");
          if (isTarget) {
            panel.classList.remove("hidden");
            panel.classList.add("flex");
          } else {
            panel.classList.add("hidden");
            panel.classList.remove("flex");
          }
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener("mouseenter", () => {
          const slug = btn.getAttribute("data-parent-target");
          if (slug) activate(slug);
        });

        btn.addEventListener("focus", () => {
          const slug = btn.getAttribute("data-parent-target");
          if (slug) activate(slug);
        });
      });

      if (details && firstSlug) {
        details.addEventListener("toggle", () => {
          if (details.open) activate(firstSlug);
        });
      }
    });

    // Đóng dropdown khi click ra ngoài nội dung thực (summary/card), kể cả vào vùng đệm trống quanh mega menu, hoặc click vào link bên trong
    document.addEventListener("click", (e) => {
      const openDetails = document.querySelectorAll("nav[aria-label='Danh mục chính'] details[open]");
      openDetails.forEach((details) => {
        const hasCard = details.querySelector(".mega-menu-card");
        const insideContent = hasCard
          ? e.target.closest("summary")?.parentElement === details ||
            (e.target.closest(".mega-menu-card") && details.contains(e.target))
          : details.contains(e.target);
        if (!insideContent || e.target.closest("a")) {
          details.removeAttribute("open");
        }
      });
    });
  });
</script>


