---
/**
 * Category Navigation — Mega Menu 3 cấp phân tầng theo mẫu chuẩn E-commerce:
 * 1. Cột trái: Danh mục cha (Parent categories) với icon và mũi tên >
 * 2. Khung phải: Danh mục con (Subcategory Header) + Sản phẩm / Phân loại chi tiết bên dưới
 * 3. Footer menu: Lối tắt xem tất cả sản phẩm
 *
 * Chạy bằng <details> kết hợp script chuyển tab tức thì trên hover (0 KB dependencies).
 */
import { Icon } from "astro-icon/components";
import { NAV, type NavItem } from "@config/nav";
import {
  buildMegaMenuTree,
  type CategoryEntryLike,
  type ProductEntryLike,
  type MegaMenuParent,
} from "@config/categories";
import { BRANDS, type FnbBrandId } from "@config/brands";

interface Props {
  brand: FnbBrandId;
  /** Pathname hiện tại để tô mục đang xem */
  current?: string;
  /**
   * Toàn bộ collection `categories` của site.
   */
  categories?: CategoryEntryLike[];
  /**
   * Toàn bộ collection `products` của site.
   */
  products?: ProductEntryLike[];
}

const { brand, current = "/", categories, products = [] } = Astro.props;
const b = BRANDS[brand];

/** Kiểu fallback cho site dùng NAV tĩnh */
type FallbackGroup = {
  heading?: { label: string; href: string; icon?: string };
  items: { label: string; href: string }[];
};

type NavEntry = {
  label: string;
  href: string;
  icon?: string;
  isMega?: boolean;
  megaParents?: MegaMenuParent[];
  fallbackGroups?: FallbackGroup[];
};

const megaParents: MegaMenuParent[] =
  categories && categories.length > 0
    ? buildMegaMenuTree(categories, products)
    : [];

/** Fallback cho site chưa có collection categories */
const fromNav = (nav: NavItem[]): NavEntry[] =>
  nav.map((item) => ({
    label: item.label,
    href: item.href,
    icon: item.icon,
    fallbackGroups: item.children?.length
      ? [{ items: item.children }]
      : [],
  }));

const items: NavEntry[] =
  categories && categories.length > 0
    ? [
        { label: "Trang chủ", href: "/", icon: b.icon },
        {
          label: "Sản phẩm",
          href: "/products",
          icon: "lucide:package",
          isMega: true,
          megaParents,
        },
        {
          label: "Năng lực sản xuất",
          href: "/nang-luc-san-xuat",
          icon: "lucide:factory",
        },
        { label: "Tin tức", href: "/blog", icon: "lucide:newspaper" },
        { label: "Liên hệ", href: "/contact", icon: "lucide:phone" },
      ]
    : fromNav(NAV[brand]);

const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<nav aria-label="Danh mục chính" class="relative z-30 border-b border-line bg-surface">
  <div class="site-container flex h-(--height-catnav) items-center justify-between gap-6">
    <ul class="flex items-center gap-4 lg:gap-6">
      {
        items.map((item) => (
          <li class="flex-none">
            {item.isMega && item.megaParents && item.megaParents.length > 0 ? (
              <details class="group/nav-item [&[open]>summary>.chev]:rotate-180">
                <summary
                  class={`flex cursor-pointer list-none items-center gap-1.5 text-nav whitespace-nowrap select-none transition-colors ${
                    isActive(item.href) ? "font-bold text-primary" : "font-medium text-ink hover:text-primary"
                  }`}
                >
                  {item.icon && <Icon name={item.icon} class="size-4" aria-hidden="true" />}
                  {item.label}
                  <span class="chev text-caret text-ink-faint transition-transform duration-200">▼</span>
                </summary>

                {/* Dropdown Mega Menu */}
                <div class="mega-menu-wrapper absolute top-full left-0 z-40 w-full border-y border-line bg-surface shadow-2xl backdrop-blur-md">
                  <div class="site-container py-4">
                    {/* Bố cục Desktop (>= 768px): 2 Cột chuẩn như Ảnh 1 */}
                    <div class="hidden md:flex rounded-2xl border border-line bg-surface shadow-lg overflow-hidden min-h-[420px]">
                      
                      {/* CỘT TRÁI: Danh mục cha (Parent Categories Sidebar) */}
                      <div class="w-[260px] lg:w-[280px] shrink-0 border-r border-line bg-surface-alt/40 p-3 flex flex-col gap-1.5">
                        <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-ink-muted">
                          Danh mục chính
                        </div>
                        {item.megaParents.map((parent, idx) => (
                          <a
                            href={parent.href}
                            data-parent-target={parent.slug}
                            data-active={idx === 0 ? "true" : "false"}
                            class={`mega-parent-btn group/parent flex items-center justify-between gap-3 px-3.5 py-3 rounded-xl transition-all duration-150 text-sm cursor-pointer select-none ${
                              idx === 0
                                ? "bg-primary/10 text-primary font-bold shadow-xs"
                                : "text-ink font-medium hover:bg-surface-tint hover:text-primary"
                            }`}
                          >
                            <div class="flex items-center gap-3 min-w-0">
                              {parent.icon && (
                                <Icon
                                  name={parent.icon}
                                  class={`size-4.5 shrink-0 transition-colors ${
                                    idx === 0 ? "text-primary" : "text-ink-muted group-hover/parent:text-primary"
                                  }`}
                                  aria-hidden="true"
                                />
                              )}
                              <span class="truncate">{parent.label}</span>
                            </div>
                            <Icon
                              name="lucide:chevron-right"
                              class={`size-4 shrink-0 transition-all ${
                                idx === 0
                                  ? "text-primary translate-x-0.5"
                                  : "text-ink-faint group-hover/parent:text-primary group-hover/parent:translate-x-0.5"
                              }`}
                              aria-hidden="true"
                            />
                          </a>
                        ))}
                      </div>

                      {/* KHUNG PHẢI: Danh mục con & Sản phẩm (Child Groups & Products) */}
                      <div class="flex-1 min-w-0 p-6 bg-surface flex flex-col justify-between">
                        {item.megaParents.map((parent, idx) => (
                          <div
                            data-parent-panel={parent.slug}
                            data-active={idx === 0 ? "true" : "false"}
                            class={`mega-panel flex-col justify-between h-full ${idx === 0 ? "flex" : "hidden"}`}
                          >
                            {/* Lưới các cột Danh mục con */}
                            <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
                              {parent.subcategories.map((sub) => (
                                <div class="flex flex-col gap-2 min-w-0">
                                  {/* Tiêu đề Danh mục con (Bold Header) */}
                                  <a
                                    href={sub.href}
                                    class="group/sub font-bold text-sm text-ink hover:text-primary transition-colors flex items-center justify-between gap-1 pb-1.5 border-b border-line-soft"
                                  >
                                    <div class="flex items-center gap-1.5 truncate">
                                      {sub.icon && <Icon name={sub.icon} class="size-4 text-primary shrink-0" aria-hidden="true" />}
                                      <span class="truncate">{sub.label}</span>
                                    </div>
                                    <Icon name="lucide:arrow-right" class="size-3 text-primary opacity-0 group-hover/sub:opacity-100 transition-opacity shrink-0" aria-hidden="true" />
                                  </a>

                                  {/* Danh sách Sản phẩm / Phân loại chi tiết */}
                                  <ul class="flex flex-col gap-1.5 pt-0.5">
                                    {sub.items.length > 0 ? (
                                      sub.items.map((p) => (
                                        <li class="min-w-0">
                                          <a
                                            href={p.href}
                                            class="text-[13px] leading-snug text-ink-muted hover:text-primary hover:translate-x-0.5 transition-all block py-0.5 truncate"
                                            title={p.label}
                                          >
                                            {p.label}
                                          </a>
                                        </li>
                                      ))
                                    ) : (
                                      <li>
                                        <a href={sub.href} class="text-xs text-ink-faint hover:text-primary italic">
                                          Xem chi tiết nhóm →
                                        </a>
                                      </li>
                                    )}
                                  </ul>
                                </div>
                              ))}
                            </div>

                            {/* Footer của panel */}
                            <div class="mt-6 pt-3.5 border-t border-line flex items-center justify-between text-xs">
                              <a
                                href={parent.href}
                                class="font-bold text-primary hover:underline flex items-center gap-1"
                              >
                                Xem tất cả sản phẩm trong {parent.label} →
                              </a>
                              <a
                                href="/products"
                                class="font-medium text-ink-muted hover:text-primary transition-colors"
                              >
                                Xem tất cả sản phẩm CFC →
                              </a>
                            </div>
                          </div>
                        ))}
                      </div>

                    </div>

                    {/* Bố cục Mobile (< 768px): Dạng danh mục xếp tầng trực quan */}
                    <div class="md:hidden flex flex-col gap-3 py-2 max-h-[70vh] overflow-y-auto">
                      {item.megaParents.map((parent) => (
                        <details class="group/m-parent border border-line rounded-xl p-3 bg-surface-alt/20">
                          <summary class="flex items-center justify-between cursor-pointer font-bold text-sm text-ink list-none">
                            <div class="flex items-center gap-2">
                              {parent.icon && <Icon name={parent.icon} class="size-4 text-primary" aria-hidden="true" />}
                              <span>{parent.label}</span>
                            </div>
                            <span class="text-xs text-ink-faint group-open/m-parent:rotate-180 transition-transform">▼</span>
                          </summary>
                          <div class="mt-3 pt-3 border-t border-line flex flex-col gap-4 pl-2">
                            {parent.subcategories.map((sub) => (
                              <div class="flex flex-col gap-1.5">
                                <a href={sub.href} class="font-semibold text-xs text-primary flex items-center gap-1">
                                  {sub.label} →
                                </a>
                                <div class="flex flex-wrap gap-2 pt-1">
                                  {sub.items.map((p) => (
                                    <a
                                      href={p.href}
                                      class="rounded-chip bg-surface px-2.5 py-1 text-xs text-ink-muted border border-line-soft hover:text-primary hover:border-primary transition-colors"
                                    >
                                      {p.label}
                                    </a>
                                  ))}
                                </div>
                              </div>
                            ))}
                          </div>
                        </details>
                      ))}
                      <div class="pt-2 text-center">
                        <a href="/products" class="text-xs font-bold text-primary hover:underline">
                          Xem tất cả sản phẩm →
                        </a>
                      </div>
                    </div>

                  </div>
                </div>
              </details>
            ) : item.fallbackGroups && item.fallbackGroups.length > 0 ? (
              <details class="group [&[open]>summary>.chev]:rotate-180">
                <summary
                  class={`flex cursor-pointer list-none items-center gap-1.5 text-nav whitespace-nowrap ${
                    isActive(item.href) ? "font-bold text-primary" : "font-medium text-ink"
                  }`}
                >
                  {item.icon && <Icon name={item.icon} class="size-4" aria-hidden="true" />}
                  {item.label}
                  <span class="chev text-caret text-ink-faint transition-transform">▼</span>
                </summary>
                <div class="absolute top-full left-0 z-30 w-full border-y border-line bg-surface shadow-lg">
                  <div class="site-container grid gap-x-6 gap-y-4 py-5 sm:grid-cols-2 lg:grid-cols-4">
                    {item.fallbackGroups.map((g) => (
                      <div class="min-w-0">
                        {g.items.map((c) => (
                          <a
                            href={c.href}
                            class="block rounded-chip px-3 py-2 text-sm font-medium text-ink transition-colors hover:bg-surface-tint hover:text-primary"
                          >
                            {c.label}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class={`flex items-center gap-1.5 text-nav whitespace-nowrap ${
                  isActive(item.href) ? "font-bold text-primary" : "font-medium text-ink"
                }`}
              >
                {item.icon && <Icon name={item.icon} class="size-4" aria-hidden="true" />}
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <span
      class="pill hidden h-8 flex-none border border-line bg-surface-chip px-4 text-xs-nav font-semibold text-ink-muted whitespace-nowrap lg:inline-flex"
    >
      {b.promoPill}
    </span>
  </div>
</nav>

<script is:inline>
  // Chuyển đổi tab Danh mục cha -> Khung sản phẩm tức thì khi rê chuột (0 KB lib)
  document.addEventListener("DOMContentLoaded", () => {
    const wrappers = document.querySelectorAll(".mega-menu-wrapper");
    wrappers.forEach((wrapper) => {
      const buttons = wrapper.querySelectorAll(".mega-parent-btn");
      const panels = wrapper.querySelectorAll(".mega-panel");

      function activate(targetSlug) {
        buttons.forEach((btn) => {
          const isTarget = btn.getAttribute("data-parent-target") === targetSlug;
          btn.setAttribute("data-active", isTarget ? "true" : "false");
          if (isTarget) {
            btn.classList.add("bg-primary/10", "text-primary", "font-bold", "shadow-xs");
            btn.classList.remove("text-ink", "font-medium", "hover:bg-surface-tint");
          } else {
            btn.classList.remove("bg-primary/10", "text-primary", "font-bold", "shadow-xs");
            btn.classList.add("text-ink", "font-medium", "hover:bg-surface-tint");
          }
        });

        panels.forEach((panel) => {
          const isTarget = panel.getAttribute("data-parent-panel") === targetSlug;
          panel.setAttribute("data-active", isTarget ? "true" : "false");
          if (isTarget) {
            panel.classList.remove("hidden");
            panel.classList.add("flex");
          } else {
            panel.classList.add("hidden");
            panel.classList.remove("flex");
          }
        });
      }

      buttons.forEach((btn) => {
        btn.addEventListener("mouseenter", () => {
          const slug = btn.getAttribute("data-parent-target");
          if (slug) activate(slug);
        });

        btn.addEventListener("focus", () => {
          const slug = btn.getAttribute("data-parent-target");
          if (slug) activate(slug);
        });
      });
    });

    // Đóng dropdown khi click ra ngoài hoặc click vào link bên trong
    document.addEventListener("click", (e) => {
      const openDetails = document.querySelectorAll("nav[aria-label='Danh mục chính'] details[open]");
      openDetails.forEach((details) => {
        if (!details.contains(e.target) || e.target.closest("a")) {
          details.removeAttribute("open");
        }
      });
    });
  });
</script>


