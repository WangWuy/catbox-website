---
/**
 * Hero — banner full-width bo góc, có lớp phủ chứa headline + CTA.
 *
 * Mockup CFC dùng một banner ảnh lớn (cao 520px, padding 8px hai bên) thay cho
 * hero 2 cột của mẫu Thái Dương. Giữ đúng mockup, nhưng thêm lớp text đè lên
 * để trang có H1 thật — banner ảnh trơn thì SEO không có gì để đọc.
 *
 * Dải stat (nếu truyền `stats`) nằm ở một lớp absolute riêng NGOÀI khối ảnh
 * overflow-hidden (không chung container với ảnh) rồi chờm xuống dưới mép
 * banner — nếu đặt chung container overflow-hidden, phần bo góc/rìa dưới sẽ
 * cắt mất góc thẻ khi thẻ chờm ra ngoài.
 */
import { Icon } from "astro-icon/components";
import type { AssetMap } from "../lib/images";
import SmartImage from "@ui/primitives/SmartImage.astro";
import PackagingIcon from "@ui/primitives/PackagingIcon.astro";

export interface HeroStat {
  icon: string;
  num?: string;
  label: string;
  href?: string;
}

interface Props {
  assets: AssetMap;
  image?: string;
  eyebrow?: string;
  /** Phần headline in thường */
  title: string;
  /** Phần headline tô màu thương hiệu (thường là tên brand) */
  titleAccent?: string;
  subtitle?: string;
  hashtag?: string;
  /** Thẻ thống kê hoặc danh mục đè lên đáy banner */
  stats?: HeroStat[];
}

const { assets, image, eyebrow, title, titleAccent, subtitle, hashtag, stats } = Astro.props;
---

{/* Banner full màn hình — ảnh tràn viền edge-to-edge, các thẻ danh mục không bo góc theo mẫu 2T Print */}
<section class:list={["w-full", stats && stats.length > 0 && "pb-12 sm:pb-14 lg:pb-16"]}>
  <div class="relative w-full">
    <div class="relative overflow-hidden bg-surface-tint">
      <SmartImage
        {assets}
        src={image}
        alt=""
        width={1920}
        height={1080}
        ratio="16x9"
        priority
        sizes="100vw"
        class="h-(--height-hero-mobile) w-full object-cover sm:h-(--height-hero-sm) md:h-(--height-hero) md:min-h-(--height-hero-min,400px)"
      />

      <!-- Gradient từ trái sang giúp chữ đọc được trên mọi ảnh khách gửi sau -->
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-r from-black/72 via-black/45 to-transparent"
      >
      </div>

      {
        stats && stats.length > 0 && (
          <div
            aria-hidden="true"
            class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/60 to-transparent md:h-36"
          />
        )
      }

      <div class:list={["absolute inset-0 flex items-center", stats && stats.length > 0 && "pb-10 sm:pb-12 lg:pb-14"]}>
        <div class="site-container">
          {/* Hiệu ứng VÀO TRANG (không phải cuộn): hero luôn nằm trong khung
              nhìn đầu tiên nên lượt quét lần-vẽ-đầu ở BaseLayout gắn `in` cho
              mấy dòng này ngay, không chờ cuộn. `--reveal-delay` tăng dần để
              bốn dòng hiện lần lượt từ trên xuống. */}
          <div class="flex max-w-2xl flex-col items-start gap-4 md:gap-5">
            {
              eyebrow && (
                <span
                  data-reveal
                  class="pill bg-white/15 px-3 py-1.5 sm:px-4 sm:py-2 text-tiny tracking-eyebrow text-white uppercase backdrop-blur-sm"
                >
                  {eyebrow}
                </span>
              )
            }

            <h1
              data-reveal
              style="--reveal-delay: var(--stagger-reveal)"
              class="text-(length:--text-hero-mobile) leading-(--text-hero--line-height) font-extrabold tracking-tight text-white uppercase md:text-hero"
            >
              {title}
              {titleAccent && <span class="text-primary"> {titleAccent}</span>}
            </h1>

            {
              subtitle && (
                <p
                  data-reveal
                  style="--reveal-delay: calc(var(--stagger-reveal) * 2)"
                  class="max-w-lg text-body leading-relaxed text-white/85 text-xs sm:text-sm md:text-base line-clamp-2 sm:line-clamp-none"
                >
                  {subtitle}
                </p>
              )
            }

            {
              hashtag && (
                <p
                  data-reveal
                  style="--reveal-delay: calc(var(--stagger-reveal) * 3)"
                  class="text-xs sm:text-sm font-semibold text-white/80"
                >
                  #nhận nhiều <span class="text-cta">{hashtag}</span>
                </p>
              )
            }
          </div>
        </div>
      </div>
    </div>

    {
      stats && stats.length > 0 && (
        /* 5 ô danh mục — bố cục chân banner, không bo góc (rounded-none), chỉ đổ bóng shadow khi hover, không dịch chuyển vị trí */
        <div class="absolute inset-x-0 -bottom-8 sm:-bottom-10 lg:-bottom-12 z-10 px-2 sm:px-4">
          <div
            data-reveal-group
            style="--duration-reveal: 1500ms; --stagger-reveal: 120ms;"
            class="mx-auto grid max-w-4xl grid-cols-5 gap-1.5 sm:gap-3 lg:gap-4"
          >
            {stats.map((s) => {
              const Tag = s.href ? "a" : "div";
              return (
                <div class="h-full">
                  <Tag
                    href={s.href}
                    class:list={[
                      "group flex h-full flex-col items-center justify-center gap-1.5 sm:gap-2.5 rounded-none border border-black/5 bg-white/95 px-1 py-2 sm:px-3 sm:py-4.5 text-center shadow-[0_4px_16px_rgba(0,0,0,0.06)] backdrop-blur-md transition-shadow duration-300 ease-out hover:shadow-[0_16px_32px_-4px_rgba(0,0,0,0.18)] hover:border-black/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
                      s.href && "cursor-pointer"
                    ]}
                  >
                    {/* Icon bao bì custom duotone — không dịch chuyển khi hover */}
                    <div class="flex size-7 sm:size-9 lg:size-10 items-center justify-center text-primary">
                      <PackagingIcon name={s.icon} class="size-6 sm:size-7 lg:size-8 text-primary" />
                    </div>

                    {/* Con số thống kê (nếu có) */}
                    {s.num && (
                      <span class="font-display text-sm sm:text-lg lg:text-xl font-semibold tracking-tight text-ink">
                        {s.num}
                      </span>
                    )}

                    {/* Tên danh mục */}
                    <span class="font-display text-[9px] sm:text-xs lg:text-sm font-bold tracking-wider text-ink uppercase group-hover:text-primary transition-colors leading-tight">
                      {s.label}
                    </span>
                  </Tag>
                </div>
              );
            })}
          </div>
        </div>
      )
    }
  </div>
</section>
