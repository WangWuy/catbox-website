---
/**
 * Hero — banner full-width bo góc, có lớp phủ chứa headline + CTA.
 *
 * Mockup CFC dùng một banner ảnh lớn (cao 520px, padding 8px hai bên) thay cho
 * hero 2 cột của mẫu Thái Dương. Giữ đúng mockup, nhưng thêm lớp text đè lên
 * để trang có H1 thật — banner ảnh trơn thì SEO không có gì để đọc.
 *
 * Dải stat (nếu truyền `stats`) nằm ở một lớp absolute riêng NGOÀI khối ảnh
 * overflow-hidden (không chung container với ảnh) rồi chờm xuống dưới mép
 * banner — nếu đặt chung container overflow-hidden, phần bo góc/rìa dưới sẽ
 * cắt mất góc thẻ khi thẻ chờm ra ngoài.
 */
import { Icon } from "astro-icon/components";
import type { AssetMap } from "../lib/images";
import SmartImage from "@ui/primitives/SmartImage.astro";
import PackagingIcon from "@ui/primitives/PackagingIcon.astro";

export interface HeroStat {
  icon: string;
  num?: string;
  label: string;
  href?: string;
}

interface Props {
  assets: AssetMap;
  image?: string;
  eyebrow?: string;
  /** Phần headline in thường */
  title: string;
  /** Phần headline tô màu thương hiệu (thường là tên brand) */
  titleAccent?: string;
  subtitle?: string;
  hashtag?: string;
  /** Nút CTA bên cạnh hashtag */
  cta?: { label?: string; href?: string };
  /** Thẻ thống kê hoặc danh mục đè lên đáy banner */
  stats?: HeroStat[];
}

const { assets, image, eyebrow, title, titleAccent, subtitle, hashtag, cta, stats } = Astro.props;
const ctaLabel = cta?.label || "Liên hệ";
const ctaHref = cta?.href || "/contact";
---

{/* Banner full màn hình — ảnh tràn viền edge-to-edge */}
<section class="w-full relative">
  <div class="relative w-full">
    <div class="relative overflow-hidden bg-surface-tint md:max-h-[500px]">
      <SmartImage
        {assets}
        src={image}
        alt=""
        width={1920}
        height={1080}
        ratio="16x9"
        priority
        sizes="100vw"
        class="h-(--height-hero-mobile) w-full object-cover sm:h-(--height-hero-sm) md:h-[500px] md:max-h-[500px] lg:h-[500px] lg:max-h-[500px]"
      />

      <!-- Gradient từ trái sang giúp chữ đọc được trên mọi ảnh khách gửi sau -->
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-r from-black/72 via-black/45 to-transparent"
      >
      </div>

      {
        stats && stats.length > 0 && (
          <div
            aria-hidden="true"
            class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/60 to-transparent md:h-36"
          />
        )
      }

      <div class:list={["absolute inset-0 flex items-center", stats && stats.length > 0 && "pb-14 sm:pb-12 lg:pb-14"]}>
        <div class="site-container">
          {/* Hiệu ứng VÀO TRANG (không phải cuộn): hero luôn nằm trong khung
              nhìn đầu tiên nên lượt quét lần-vẽ-đầu ở BaseLayout gắn `in` cho
              mấy dòng này ngay, không chờ cuộn. `--reveal-delay` tăng dần để
              bốn dòng hiện lần lượt từ trên xuống. */}
          <div class="flex max-w-2xl flex-col items-start gap-4 md:gap-5">
            {
              eyebrow && (
                <span
                  data-reveal
                  class="pill bg-white/15 px-3 py-1.5 sm:px-4 sm:py-2 text-tiny tracking-eyebrow text-white uppercase backdrop-blur-sm"
                >
                  {eyebrow}
                </span>
              )
            }

            <h1
              data-reveal
              style="--reveal-delay: var(--stagger-reveal)"
              class="text-(length:--text-hero-mobile) leading-(--text-hero--line-height) font-extrabold tracking-tight text-white uppercase md:text-hero"
            >
              {title}
              {titleAccent && <span class="text-primary"> {titleAccent}</span>}
            </h1>

            {
              subtitle && (
                <p
                  data-reveal
                  style="--reveal-delay: calc(var(--stagger-reveal) * 2)"
                  class="max-w-lg text-body leading-relaxed text-white/85 text-xs sm:text-sm md:text-base line-clamp-2 sm:line-clamp-none"
                >
                  {subtitle}
                </p>
              )
            }

            <div
              data-reveal
              style="--reveal-delay: calc(var(--stagger-reveal) * 3)"
              class="flex flex-wrap items-center gap-3.5 pt-1 sm:gap-4.5"
            >
              <a
                href={ctaHref}
                data-analytics="click_hero_contact"
                class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-2.5 text-xs sm:text-sm font-bold text-white shadow-md transition-all duration-200 hover:scale-[1.03] hover:bg-primary-hover hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                {ctaLabel}
              </a>

              {
                hashtag && (
                  <p class="text-xs sm:text-sm font-semibold text-white/85">
                    #nhận nhiều <span class="text-cta font-bold">{hashtag}</span>
                  </p>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{
  stats && stats.length > 0 && (
    /* Dải nền xám cao 184px chứa 5 card nổi chuẩn 100% 2T Print (bg-[#f6f6f6], height: 184px, margin-top: -100px) */
    <section class="w-full bg-[#f6f6f6] md:h-[184px] flow-root relative">
      <div class="site-container relative z-10 -mt-[100px] pb-8 md:pb-0">
        <div
          data-reveal-group
          style="--duration-reveal: 1500ms; --stagger-reveal: 120ms;"
          class="mx-auto flex flex-wrap items-center justify-center gap-3 sm:gap-4 lg:gap-[18px] max-w-[1240px]"
        >
          {stats.map((s, idx) => {
            const Tag = s.href ? "a" : "div";
            return (
              <div class:list={["w-[calc(50%-8px)] sm:w-[178.73px] h-[214.81px] relative hover:z-10", idx >= 4 && "hidden sm:block"]}>
                <Tag
                  href={s.href}
                  class:list={[
                    "group relative flex w-full h-[214.81px] flex-col items-center justify-center rounded-none bg-white pt-[20px] pb-[10px] px-2 text-center shadow-[0_1px_3px_-2px_rgba(0,0,0,0.12),0_1px_2px_rgba(0,0,0,0.20)] transition-all duration-300 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
                    s.href &&
                      "cursor-pointer hover:z-10 hover:shadow-[0_10px_20px_rgba(0,0,0,0.15),0_6px_6px_rgba(0,0,0,0.18)]"
                  ]}
                >
                  {/* Icon bao bì duotone chiếm ~45% card, phóng to nhẹ 1.1x khi hover theo chuẩn image-zoom của 2T Print */}
                  <div class="flex h-[80px] w-full items-center justify-center text-primary transition-transform duration-500 ease-out group-hover:scale-110">
                    <PackagingIcon name={s.icon} class="size-12 text-primary" />
                  </div>

                  {/* Con số thống kê: bọc trong thẻ h3, font-weight 800 (font-extrabold), cỡ 20px */}
                  {s.num && (
                    <h3 class="font-display text-[20px] font-extrabold tracking-tight text-ink mt-2 mb-0.5">
                      <span style="font-size: 100%;">{s.num}</span>
                    </h3>
                  )}

                  {/* Tên danh mục / Đơn vị: thẻ p, chữ 16px */}
                  <p
                    class:list={[
                      "font-display text-[16px] font-medium tracking-normal text-ink-muted leading-snug transition-colors duration-200",
                      s.href && "group-hover:text-primary"
                    ]}
                  >
                    {s.label}
                  </p>
                </Tag>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
