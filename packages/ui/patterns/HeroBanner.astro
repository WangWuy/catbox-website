---
/**
 * Hero — banner full-width bo góc, có lớp phủ chứa headline + CTA.
 *
 * Mockup CFC dùng một banner ảnh lớn (cao 520px, padding 8px hai bên) thay cho
 * hero 2 cột của mẫu Thái Dương. Giữ đúng mockup, nhưng thêm lớp text đè lên
 * để trang có H1 thật — banner ảnh trơn thì SEO không có gì để đọc.
 *
 * Dải stat (nếu truyền `stats`) nằm ở một lớp absolute riêng NGOÀI khối ảnh
 * overflow-hidden (không chung container với ảnh) rồi chờm xuống dưới mép
 * banner — nếu đặt chung container overflow-hidden, phần bo góc/rìa dưới sẽ
 * cắt mất góc thẻ khi thẻ chờm ra ngoài.
 */
import { Icon } from "astro-icon/components";
import type { AssetMap } from "../lib/images";
import SmartImage from "@ui/primitives/SmartImage.astro";

export interface HeroStat {
  icon: string;
  num: string;
  label: string;
}

interface Props {
  assets: AssetMap;
  image?: string;
  eyebrow?: string;
  /** Phần headline in thường */
  title: string;
  /** Phần headline tô màu thương hiệu (thường là tên brand) */
  titleAccent?: string;
  subtitle?: string;
  hashtag?: string;
  /** Thẻ thống kê đè lên đáy banner, ví dụ số liệu năng lực sản xuất */
  stats?: HeroStat[];
}

const { assets, image, eyebrow, title, titleAccent, subtitle, hashtag, stats } = Astro.props;
---

{/* Padding đáy chỉ chừa từ `lg` — đó là bề ngang duy nhất dải stat hiện ra
    (dưới `lg` khối stat bị ẩn hẳn, xem chú thích ở khối stat bên dưới). */}
<section class:list={["px-2 pt-2", stats && stats.length > 0 && "lg:pb-14"]}>
  <div class="relative">
    <div class="relative overflow-hidden rounded-panel bg-surface-tint">
      <SmartImage
        {assets}
        src={image}
        alt=""
        width={1536}
        height={1024}
        ratio="16x10"
        priority
        sizes="100vw"
        class="h-(--height-hero-mobile) w-full object-cover sm:h-(--height-hero-sm) md:h-(--height-hero)"
      />

      <!-- Gradient từ trái sang giúp chữ đọc được trên mọi ảnh khách gửi sau -->
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-r from-black/72 via-black/45 to-transparent"
      >
      </div>

      {
        stats && stats.length > 0 && (
          <div
            aria-hidden="true"
            class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/70 to-transparent md:h-40"
          />
        )
      }

      <div class:list={["absolute inset-0 flex items-center", stats && stats.length > 0 && "lg:pb-16"]}>
        <div class="site-container">
          {/* Hiệu ứng VÀO TRANG (không phải cuộn): hero luôn nằm trong khung
              nhìn đầu tiên nên lượt quét lần-vẽ-đầu ở BaseLayout gắn `in` cho
              mấy dòng này ngay, không chờ cuộn. `--reveal-delay` tăng dần để
              bốn dòng hiện lần lượt từ trên xuống. */}
          <div class="flex max-w-2xl flex-col items-start gap-5">
            {
              eyebrow && (
                <span
                  data-reveal
                  class="pill bg-white/15 px-4 py-2 text-tiny tracking-eyebrow text-white uppercase backdrop-blur-sm"
                >
                  {eyebrow}
                </span>
              )
            }

            <h1
              data-reveal
              style="--reveal-delay: var(--stagger-reveal)"
              class="text-3xl leading-(--text-hero--line-height) font-extrabold tracking-tight text-white uppercase sm:text-4xl md:text-hero"
            >
              {title}
              {titleAccent && <span class="text-primary"> {titleAccent}</span>}
            </h1>

            {
              subtitle && (
                <p
                  data-reveal
                  style="--reveal-delay: calc(var(--stagger-reveal) * 2)"
                  class="max-w-lg text-body leading-relaxed text-white/85 md:text-base"
                >
                  {subtitle}
                </p>
              )
            }

            {
              hashtag && (
                <p
                  data-reveal
                  style="--reveal-delay: calc(var(--stagger-reveal) * 3)"
                  class="text-sm font-semibold text-white/80"
                >
                  #nhận nhiều <span class="text-cta">{hashtag}</span>
                </p>
              )
            }
          </div>
        </div>
      </div>
    </div>

    {
      stats && stats.length > 0 && (
        /* Chỉ hiện từ `lg` — bề ngang duy nhất 5 thẻ xếp gọn MỘT hàng chờm lên
           banner. Dưới `lg` ẩn hẳn: xếp 2–3 cột thì dải stat cao ~280px, đẩy
           hero xuống và ngốn trọn khung nhìn đầu tiên trên mobile. */
        <div class="hidden px-2 lg:absolute lg:inset-x-0 lg:-bottom-14 lg:block">
          <div class="site-container">
            <div data-reveal-group class="grid grid-cols-5 gap-4">
              {stats.map((s) => (
                <div class="flex flex-col items-center gap-1.5 rounded-panel bg-white/95 px-3 py-4 text-center backdrop-blur-sm">
                  <Icon name={s.icon} class="size-8 text-primary" aria-hidden="true" />
                  <span class="font-display text-2xl font-extrabold tracking-tight text-ink">
                    {s.num}
                  </span>
                  <span class="text-(length:--text-meta) text-ink-muted">{s.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
