---
/**
 * Banner đầu trang cho các trang trong (/about-us, /products, /danh-muc...).
 *
 * Banner ảnh full-width tràn 2 viền màn hình (edge-to-edge) giống HeroBanner
 * của Trang chủ. Bên trên có lớp phủ gradient tối giúp tiêu đề trắng và
 * breadcrumb đọc rõ trên mọi ảnh nền.
 */
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import type { AssetMap } from "../lib/images";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  /** Đường dẫn breadcrumb, KHÔNG gồm "Trang chủ" (Breadcrumb tự thêm) */
  crumbs: Crumb[];
  /** Ảnh nền banner; cần `assets` đi kèm mới hiện */
  assets?: AssetMap;
  image?: string;
  imageAlt?: string;
}

const { title, crumbs, assets, image, imageAlt = "" } = Astro.props;

const showImage = !!assets && !!image;
---

<section class="relative w-full overflow-hidden bg-(--color-surface-page-hero)">
  {
    showImage && (
      <div class="absolute inset-0 z-0">
        <SmartImage
          assets={assets!}
          src={image}
          alt={imageAlt}
          width={1920}
          height={600}
          priority
          sizes="100vw"
          class="h-full w-full object-cover"
        />
        {/* Gradient từ trái sang tương tự HeroBanner Trang chủ giúp chữ đọc rõ ràng */}
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"
        />
      </div>
    )
  }

  <div
    class="site-container relative z-10 flex min-h-(--height-page-hero) flex-col justify-center gap-3 py-8 sm:py-10 md:py-12"
  >
    <h1
      class="text-(length:--text-page-hero-title-mobile) font-extrabold tracking-tight text-balance text-white md:text-(length:--text-page-hero-title)"
    >
      {title}
    </h1>

    <Breadcrumb items={crumbs} bare tone="dark" />
  </div>
</section>

