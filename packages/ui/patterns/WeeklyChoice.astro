---
/**
 * LỰA CHỌN CỦA TUẦN — 3 card sản phẩm bên trái + 1 ảnh vuông lớn có hotspot
 * bên phải (Island #5).
 *
 * Toạ độ hotspot là % trong frontmatter MDX, nên khi thay ảnh thật chỉ cần
 * chỉnh số, không đụng code.
 */
import type { AssetMap } from "../lib/images";
import ProductCard, { type ProductCardData } from "@ui/primitives/ProductCard.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import SectionHeader from "@ui/primitives/SectionHeader.astro";

export interface Hotspot {
  x: number;
  y: number;
  title: string;
  desc?: string;
  href?: string;
}

interface Props {
  assets: AssetMap;
  title?: string;
  subtitle?: string;
  items: ProductCardData[];
  showcaseImage?: string;
  showcaseAlt?: string;
  hotspots?: Hotspot[];
}

const {
  assets,
  title = "Lựa chọn của tuần",
  subtitle = "Những sản phẩm bán chạy nhất tuần qua",
  items,
  showcaseImage,
  showcaseAlt = "Bộ sản phẩm nổi bật trong tuần",
  hotspots = [],
} = Astro.props;
---

<section class="site-container">
  <SectionHeader {title} {subtitle} />

  <div class="grid gap-5 lg:grid-cols-[1.6fr_1fr]">
    <div class="grid gap-4 sm:grid-cols-3">
      {items.slice(0, 3).map((p, i) => <ProductCard {assets} {...p} variant={i + 4} />)}
    </div>

    <div class="relative overflow-hidden rounded-panel bg-surface-tint" data-hotspot-wrap>
      <SmartImage
        {assets}
        src={showcaseImage}
        alt={showcaseAlt}
        width={800}
        height={800}
        ratio="1x1"
        variant={5}
        class="aspect-square w-full object-cover"
      />

      {
        hotspots.map((h, i) => (
          <div class="absolute" style={`left:${h.x}%;top:${h.y}%;transform:translate(-50%,-50%)`}>
            <button
              type="button"
              data-hotspot={i}
              aria-expanded="false"
              aria-label={`Xem chi tiết: ${h.title}`}
              class="grid size-8 place-items-center rounded-full border-2 border-white bg-primary text-sm font-bold text-white transition-transform hover:scale-110"
            >
              +
            </button>

            <div
              data-hotspot-panel={i}
              hidden
              class="absolute bottom-[calc(100%+10px)] left-1/2 z-10 w-56 -translate-x-1/2 rounded-chip border border-line bg-surface p-3.5 text-left"
            >
              <p class="text-label font-bold">{h.title}</p>
              {h.desc && <p class="mt-1 text-micro leading-relaxed text-ink-muted">{h.desc}</p>}
              {h.href && (
                <a href={h.href} class="mt-2 inline-block text-micro font-bold text-primary">
                  Xem sản phẩm →
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Island #5 — Hotspot. Mở/đóng bằng click, đóng khi bấm ra ngoài hoặc Esc.
  document.querySelectorAll<HTMLElement>("[data-hotspot-wrap]").forEach((wrap) => {
    const closeAll = () => {
      wrap.querySelectorAll<HTMLElement>("[data-hotspot-panel]").forEach((p) => (p.hidden = true));
      wrap
        .querySelectorAll("[data-hotspot]")
        .forEach((b) => b.setAttribute("aria-expanded", "false"));
    };

    wrap.querySelectorAll<HTMLButtonElement>("[data-hotspot]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const id = btn.dataset.hotspot!;
        const panel = wrap.querySelector<HTMLElement>(`[data-hotspot-panel="${id}"]`);
        const wasOpen = panel ? !panel.hidden : false;
        closeAll();
        if (panel && !wasOpen) {
          panel.hidden = false;
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", closeAll);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAll();
    });
  });
</script>
