---
import type { AssetMap } from "../lib/images";
import SmartImage from "@ui/primitives/SmartImage.astro";

export interface SidebarProductItem {
  id?: string;
  title?: string;
  href?: string;
  image?: string;
  price?: string;
  moq?: string;
  data?: {
    title: string;
    image?: string;
    moq?: string;
    [key: string]: unknown;
  };
}

export interface SidebarArticleItem {
  id?: string;
  title?: string;
  href?: string;
  cover?: string;
  data?: {
    title: string;
    cover?: string;
    [key: string]: unknown;
  };
}

interface Props {
  assets: AssetMap;
  products?: SidebarProductItem[];
  articles?: SidebarArticleItem[];
  productHeading?: string;
  articleHeading?: string;
  class?: string;
}

const {
  assets,
  products = [],
  articles = [],
  productHeading = "Sản phẩm HOT",
  articleHeading = "Bài viết hay",
  class: className = "",
} = Astro.props;
---

<aside class:list={["flex flex-col gap-10", className]}>
  {
    products.length > 0 && (
      <div>
        <div class="mb-5">
          <h2 class="relative font-display text-base font-bold uppercase tracking-wider text-ink">
            {productHeading}
            <span
              class="absolute -bottom-2 left-0 h-0.5 w-10 bg-primary"
              aria-hidden="true"
            />
          </h2>
        </div>

        <ul class="flex flex-col">
          {products.map((p, i) => {
            const title = p.title ?? p.data?.title ?? "";
            const href = p.href ?? (p.id ? `/products/${p.id}` : "#");
            const image = p.image ?? p.data?.image;
            const price =
              p.price ??
              (p.moq ? `MOQ: ${p.moq}` : p.data?.moq ? `MOQ: ${p.data.moq}` : "Giá sỉ tận xưởng");

            return (
              <li class="border-b border-dashed border-line py-3.5 first:pt-0 last:border-0 last:pb-0">
                <a href={href} class="group flex items-center gap-3">
                  <div class="size-16 shrink-0 overflow-hidden bg-surface-tint transition-shadow duration-(--duration-base) group-hover:shadow-(--shadow-media-hover)">
                    <SmartImage
                      {assets}
                      src={image}
                      alt={title}
                      width={128}
                      height={128}
                      ratio="1x1"
                      variant={(i % 6) + 1}
                      class="size-full object-cover"
                    />
                  </div>
                  <div class="flex flex-1 flex-col justify-center min-w-0">
                    <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-primary">
                      {title}
                    </h3>
                    <span class="mt-1 text-sm font-bold text-primary">
                      {price}
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  {
    articles.length > 0 && (
      <div>
        <div class="mb-5">
          <h2 class="relative font-display text-base font-bold uppercase tracking-wider text-ink">
            {articleHeading}
            <span
              class="absolute -bottom-2 left-0 h-0.5 w-10 bg-primary"
              aria-hidden="true"
            />
          </h2>
        </div>

        <ul class="flex flex-col">
          {articles.map((a, i) => {
            const title = a.title ?? a.data?.title ?? "";
            const href = a.href ?? (a.id ? `/blog/${a.id}` : "#");
            const cover = a.cover ?? a.data?.cover;

            return (
              <li class="border-b border-dashed border-line py-3.5 first:pt-0 last:border-0 last:pb-0">
                <a href={href} class="group flex items-center gap-3">
                  <div class="size-16 shrink-0 overflow-hidden bg-surface-tint transition-shadow duration-(--duration-base) group-hover:shadow-(--shadow-media-hover)">
                    <SmartImage
                      {assets}
                      src={cover}
                      alt={title}
                      width={128}
                      height={128}
                      ratio="1x1"
                      variant={(i % 6) + 1}
                      class="size-full object-cover"
                    />
                  </div>
                  <div class="flex flex-1 flex-col justify-center min-w-0">
                    <h3 class="line-clamp-3 text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-primary">
                      {title}
                    </h3>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</aside>

