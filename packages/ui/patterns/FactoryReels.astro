---
/**
 * Khối video trước Footer — MỘT cửa sổ video dạng viên thuốc (pill), khung
 * 1000 × 399.2 bo tròn hai đầu, canh giữa trong site-container; không tiêu đề,
 * không mô tả, không CTA.
 *
 * Khai `--aspect-reel-pill` chứ không chốt chiều cao 399.2px: dưới 1000px khung
 * co theo bề ngang màn hình và vẫn giữ đúng dáng viên thuốc.
 *
 * Không nền riêng và không đệm phía TRÊN — khối dính liền khối bên trên. Chỉ
 * chừa đệm phía DƯỚI để khung video (`primary-ink`) không dán vào Footer
 * (`primary-deep`), vì hai màu nâu đậm này sát nhau sẽ mất ranh giới.
 *
 * Video hiện tại là reel quay DỌC 9:16 lấy từ fanpage: trong khung ngang dẹt
 * này `object-cover` sẽ cắt mất gần hết khung hình, nên vẫn dùng
 * `object-contain` — video nằm giữa với hai mảng `primary-ink` hai bên, đúng
 * dáng viên thuốc. Khi có video ngang thật, thay file là khung tự lấp đầy.
 *
 * `controls` bị bỏ: thanh điều khiển mặc định của trình duyệt là một dải chữ
 * nhật chạy sát đáy khung, hai đầu của nó bị chính đường bo tròn cắt cụt. Video
 * đã `muted` + `loop` + tự phát theo khung nhìn nên không còn nút nào cần bấm.
 *
 * Tự phát khi cuộn tới, dừng khi cuộn qua — IntersectionObserver thuần, theo
 * đúng cách `data-reveal` đang làm ở BaseLayout (xem chú thích ở đó): `muted`
 * là điều kiện bắt buộc để trình duyệt cho `play()` chạy không cần thao tác
 * người dùng, `loop` để video ngắn không dừng khựng giữa lúc đang xem.
 * `preload="metadata"` thay vì `"none"`: cần biết kích thước khung hình ngay
 * và phải có đủ dữ liệu để bắt đầu phát ngay khi vào khung nhìn, nhưng vẫn
 * không tải cả file lúc trang chưa cuộn tới.
 *
 * Chưa có video thì rơi về ảnh tĩnh — KHÔNG vẽ nút play giả, vì một nút bấm
 * không ra gì tệ hơn là không có nút.
 */
import type { AssetMap } from "../lib/images";
import SmartImage from "@ui/primitives/SmartImage.astro";

interface Props {
  assets: AssetMap;
  /** Tên gọi cho trình đọc màn hình — không hiển thị trên trang */
  label: string;
  /** Video trong public/ — khung pill dẹt, video dọc sẽ có viền tối hai bên */
  video?: string;
  /** Ảnh hiển thị trước khi bấm play (public/) */
  poster?: string;
  /** Ảnh tĩnh thay thế khi chưa có video (src/assets qua SmartImage) */
  image?: string;
}

const { assets, label, video, poster, image } = Astro.props;
---

<section class="pb-8 md:pb-12" aria-label={label} data-reveal>
  <div class="site-container">
    {
      video ? (
        <video
          preload="metadata"
          playsinline
          muted
          loop
          poster={poster}
          class="mx-auto aspect-(--aspect-reel-pill) w-full max-w-(--width-reel-pill) rounded-(--radius-reel-pill) bg-primary-ink object-contain"
          aria-label={label}
          data-factory-reel
        >
          <source src={video} type="video/mp4" />
          Trình duyệt của bạn không phát được video này.
        </video>
      ) : (
        <SmartImage
          {assets}
          src={image}
          alt={label}
          width={1000}
          height={399}
          ratio="16x9"
          variant={4}
          class="mx-auto aspect-(--aspect-reel-pill) w-full max-w-(--width-reel-pill) rounded-(--radius-reel-pill) bg-primary-ink object-cover"
        />
      )
    }
  </div>
</section>

{
  video && (
    <script>
      // Tự phát/dừng theo khung nhìn — cùng cách `data-reveal` đang làm ở
      // BaseLayout (IntersectionObserver thuần, không thư viện). Dừng thay vì
      // để chạy ngầm khi cuộn qua: video ngoài khung nhìn vẫn tốn CPU giải mã
      // nếu không pause, và người dùng bấm "controls" tạm dừng thủ công cũng
      // không nên bị observer tự bấm play lại lần sau nó lọt vào khung nhìn.
      (() => {
        const videos = document.querySelectorAll<HTMLVideoElement>("[data-factory-reel]");
        if (!videos.length || !("IntersectionObserver" in window)) return;

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) {
                el.play().catch(() => {});
              } else {
                el.pause();
              }
            });
          },
          { threshold: 0.5 },
        );

        videos.forEach((el) => io.observe(el));
      })();
    </script>
  )
}
