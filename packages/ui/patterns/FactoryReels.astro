---
/**
 * Khối video xưởng / giới thiệu — player tương tác độc lập, tỉ lệ 21:9, đủ nút
 * Play/Pause, thanh tiến trình, Bật/Tắt âm thanh, volume và Fullscreen; tự phát
 * khi cuộn tới. Mặc định tràn viền (Trang chủ); `framed` thu về khung giữa trang
 * tối đa --width-reel-framed (Về chúng tôi).
 */
import { Icon } from "astro-icon/components";
import type { AssetMap } from "../lib/images";
import SmartImage from "@ui/primitives/SmartImage.astro";

interface Props {
  assets: AssetMap;
  /** Tên gọi cho trình đọc màn hình — không hiển thị trên trang */
  label: string;
  /** Video trong public/ — khung framed hoặc player có controls */
  video?: string;
  /** Ảnh hiển thị trước khi bấm play (public/) */
  poster?: string;
  /** Ảnh tĩnh thay thế khi chưa có video (src/assets qua SmartImage) */
  image?: string;
  /** Thu khung về max-w-(--width-reel-framed), không tràn viền (Về chúng tôi) */
  framed?: boolean;
}

const { assets, label, video, poster, image, framed = false } = Astro.props;
---

{
  (
    <section class={framed ? "pb-8 md:pb-12" : "pb-10 md:pb-16"} aria-label={label} data-reveal>
      <div class={framed ? "site-container" : undefined}>
      <div
        class:list={[
          "custom-video-player group relative aspect-(--aspect-reel-cinematic) w-full overflow-hidden border border-line-soft/40 bg-primary-ink shadow-xl",
          framed && "mx-auto max-w-(--width-reel-framed)",
        ]}
        data-custom-player
        tabindex="0"
      >
          {video ? (
            <>
              <video
                preload="metadata"
                playsinline
                muted
                loop
                poster={poster}
                class="video-element h-full w-full object-contain cursor-pointer"
                aria-label={label}
              >
                <source src={video} type="video/mp4" />
                Trình duyệt của bạn không phát được video này.
              </video>

              {/* Nút Play to ở giữa khi đang tạm dừng */}
              <button
                type="button"
                class="center-play-btn absolute inset-0 m-auto flex size-16 md:size-20 items-center justify-center rounded-full bg-primary/90 text-white shadow-xl backdrop-blur-xs transition-all duration-300 hover:scale-110 hover:bg-primary active:scale-95 focus:outline-hidden"
                aria-label="Phát video"
              >
                <Icon name="lucide:play" class="ml-1 size-8 md:size-9" aria-hidden="true" />
              </button>

              {/* Thanh điều khiển Controls Bar nổi ở đáy */}
              <div class="controls-bar absolute inset-x-0 bottom-0 z-10 flex flex-col gap-2.5 bg-gradient-to-t from-black/90 via-black/60 to-transparent p-3.5 md:p-5 transition-opacity duration-300">
                {/* Thanh tiến trình / Seek bar */}
                <div
                  class="progress-container group/progress relative flex h-3 w-full cursor-pointer items-center py-1"
                  role="slider"
                  aria-label="Tiến trình video"
                >
                  <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-white/25 transition-all group-hover/progress:h-2">
                    <div class="progress-bar absolute inset-y-0 left-0 w-0 bg-primary transition-all duration-75" />
                  </div>
                  <div
                    class="progress-thumb pointer-events-none absolute size-3.5 -translate-x-1/2 rounded-full bg-white shadow-md opacity-0 transition-opacity group-hover/progress:opacity-100"
                    style="left: 0%;"
                  />
                </div>

                {/* Các nút bấm điều khiển */}
                <div class="flex items-center justify-between gap-3 text-white">
                  <div class="flex items-center gap-3 md:gap-4">
                    {/* Play / Pause toggle */}
                    <button
                      type="button"
                      class="btn-play-pause p-1 text-white transition-colors hover:text-primary focus:outline-hidden cursor-pointer"
                      aria-label="Phát / Tạm dừng"
                    >
                      <Icon name="lucide:play" class="icon-play size-5 md:size-6" aria-hidden="true" />
                      <Icon name="lucide:pause" class="icon-pause hidden size-5 md:size-6" aria-hidden="true" />
                    </button>

                    {/* Mute & Volume Slider */}
                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        class="btn-mute p-1 text-white transition-colors hover:text-primary focus:outline-hidden cursor-pointer"
                        aria-label="Bật / Tắt âm thanh"
                      >
                        <Icon name="lucide:volume-2" class="icon-volume size-5" aria-hidden="true" />
                        <Icon name="lucide:volume-x" class="icon-muted hidden size-5" aria-hidden="true" />
                      </button>
                      <input
                        type="range"
                        min="0"
                        max="1"
                        step="0.05"
                        value="1"
                        class="volume-slider hidden sm:block h-1 w-14 lg:w-20 cursor-pointer appearance-none rounded-full bg-white/30 accent-primary"
                        aria-label="Âm lượng"
                      />
                    </div>

                    {/* Hiển thị thời gian */}
                    <div class="time-display select-none font-mono text-xs text-white/80">
                      <span class="time-current">0:00</span>
                      <span class="text-white/40"> / </span>
                      <span class="time-duration">0:00</span>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <span class="hidden select-none text-xs text-white/60 md:inline-block max-w-xs truncate">
                      {label}
                    </span>

                    {/* Fullscreen */}
                    <button
                      type="button"
                      class="btn-fullscreen p-1 text-white transition-colors hover:text-primary focus:outline-hidden cursor-pointer"
                      aria-label="Toàn màn hình"
                    >
                      <Icon name="lucide:maximize" class="icon-maximize size-5" aria-hidden="true" />
                      <Icon name="lucide:minimize" class="icon-minimize hidden size-5" aria-hidden="true" />
                    </button>
                  </div>
                </div>
              </div>
            </>
          ) : (
            <SmartImage
              {assets}
              src={image}
              alt={label}
              width={1000}
              height={399}
              ratio="16x9"
              variant={4}
              class="h-full w-full object-cover"
            />
          )}
      </div>
      </div>
    </section>
  )
}

<script is:inline>
  (() => {
    function initVideoComponents() {
      // Custom Player có Controls
      const players = document.querySelectorAll("[data-custom-player]");
      players.forEach((player) => {
        const video = player.querySelector(".video-element");
        if (!video) return;

        const centerPlayBtn = player.querySelector(".center-play-btn");
        const controlsBar = player.querySelector(".controls-bar");
        const btnPlayPause = player.querySelector(".btn-play-pause");
        const iconPlay = player.querySelector(".icon-play");
        const iconPause = player.querySelector(".icon-pause");
        const btnMute = player.querySelector(".btn-mute");
        const iconVolume = player.querySelector(".icon-volume");
        const iconMuted = player.querySelector(".icon-muted");
        const volumeSlider = player.querySelector(".volume-slider");
        const progressContainer = player.querySelector(".progress-container");
        const progressBar = player.querySelector(".progress-bar");
        const progressThumb = player.querySelector(".progress-thumb");
        const timeCurrent = player.querySelector(".time-current");
        const timeDuration = player.querySelector(".time-duration");
        const btnFullscreen = player.querySelector(".btn-fullscreen");
        const iconMaximize = player.querySelector(".icon-maximize");
        const iconMinimize = player.querySelector(".icon-minimize");

        let userManuallyPaused = false;

        function formatTime(sec) {
          if (!sec || isNaN(sec)) return "0:00";
          const m = Math.floor(sec / 60);
          const s = Math.floor(sec % 60);
          return `${m}:${s < 10 ? "0" : ""}${s}`;
        }

        function togglePlay() {
          if (video.paused || video.ended) {
            userManuallyPaused = false;
            video.play().catch(() => {});
          } else {
            userManuallyPaused = true;
            video.pause();
          }
        }

        let hideTimeout;
        function resetHideTimer() {
          if (controlsBar) controlsBar.style.opacity = "1";
          clearTimeout(hideTimeout);
          if (!video.paused) {
            hideTimeout = setTimeout(() => {
              if (controlsBar) controlsBar.style.opacity = "0";
            }, 2500);
          }
        }

        function updatePlayState() {
          if (video.paused) {
            if (centerPlayBtn) {
              centerPlayBtn.style.opacity = "1";
              centerPlayBtn.style.pointerEvents = "auto";
            }
            iconPlay?.classList.remove("hidden");
            iconPause?.classList.add("hidden");
            if (controlsBar) controlsBar.style.opacity = "1";
          } else {
            if (centerPlayBtn) {
              centerPlayBtn.style.opacity = "0";
              centerPlayBtn.style.pointerEvents = "none";
            }
            iconPlay?.classList.add("hidden");
            iconPause?.classList.remove("hidden");
            resetHideTimer();
          }
        }

        video.addEventListener("play", updatePlayState);
        video.addEventListener("pause", updatePlayState);

        video.addEventListener("click", togglePlay);
        centerPlayBtn?.addEventListener("click", togglePlay);
        btnPlayPause?.addEventListener("click", togglePlay);

        video.addEventListener("timeupdate", () => {
          if (!video.duration) return;
          const pct = (video.currentTime / video.duration) * 100;
          if (progressBar) progressBar.style.width = `${pct}%`;
          if (progressThumb) progressThumb.style.left = `${pct}%`;
          if (timeCurrent) timeCurrent.textContent = formatTime(video.currentTime);
        });

        video.addEventListener("loadedmetadata", () => {
          if (timeDuration) timeDuration.textContent = formatTime(video.duration);
        });

        // Seek
        function seek(e) {
          if (!progressContainer || !video.duration) return;
          const rect = progressContainer.getBoundingClientRect();
          const clientX = e.touches ? e.touches[0].clientX : e.clientX;
          const pos = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
          video.currentTime = pos * video.duration;
        }

        progressContainer?.addEventListener("click", seek);

        // Mute & Volume
        function updateVolumeUI() {
          if (video.muted || video.volume === 0) {
            iconVolume?.classList.add("hidden");
            iconMuted?.classList.remove("hidden");
            if (volumeSlider) volumeSlider.value = "0";
          } else {
            iconVolume?.classList.remove("hidden");
            iconMuted?.classList.add("hidden");
            if (volumeSlider) volumeSlider.value = String(video.volume);
          }
        }

        btnMute?.addEventListener("click", () => {
          video.muted = !video.muted;
          updateVolumeUI();
        });

        volumeSlider?.addEventListener("input", (e) => {
          const val = parseFloat(e.target.value);
          video.volume = val;
          video.muted = val === 0;
          updateVolumeUI();
        });

        // Fullscreen
        function toggleFullscreen() {
          if (!document.fullscreenElement) {
            if (player.requestFullscreen) {
              player.requestFullscreen();
            } else if (player.webkitRequestFullscreen) {
              player.webkitRequestFullscreen();
            }
          } else {
            if (document.exitFullscreen) {
              document.exitFullscreen();
            }
          }
        }

        btnFullscreen?.addEventListener("click", toggleFullscreen);
        document.addEventListener("fullscreenchange", () => {
          const isFull = !!document.fullscreenElement;
          iconMaximize?.classList.toggle("hidden", isFull);
          iconMinimize?.classList.toggle("hidden", !isFull);
        });

        player.addEventListener("mousemove", resetHideTimer);
        player.addEventListener("mouseleave", () => {
          if (!video.paused && controlsBar) {
            controlsBar.style.opacity = "0";
          }
        });

        // Phím tắt Space / M / F
        player.addEventListener("keydown", (e) => {
          if (e.code === "Space" || e.code === "KeyK") {
            e.preventDefault();
            togglePlay();
          } else if (e.code === "KeyM") {
            e.preventDefault();
            video.muted = !video.muted;
            updateVolumeUI();
          } else if (e.code === "KeyF") {
            e.preventDefault();
            toggleFullscreen();
          }
        });

        // Khởi tạo UI volume ban đầu
        updateVolumeUI();

        // Tự động phát khi cuộn tới, tạm dừng khi cuộn qua
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            ([entry]) => {
              if (entry.isIntersecting) {
                if (!userManuallyPaused) {
                  video.play().catch(() => {});
                }
              } else {
                video.pause();
              }
            },
            { threshold: 0.35 },
          );
          io.observe(player);
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initVideoComponents);
    } else {
      initVideoComponents();
    }
  })();
</script>
