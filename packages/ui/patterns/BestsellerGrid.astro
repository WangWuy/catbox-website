---
/**
 * BÁN CHẠY — tabs cố định lọc theo nhóm danh mục + lưới 5 cột × 2 dòng = 10 thẻ/trang,
 * pagination riêng cho từng tab.
 *
 * SEO-safe: TOÀN BỘ sản phẩm render trong HTML ngay từ đầu; JS chỉ
 * ẩn/hiện bằng `hidden` theo tab đang chọn + trang hiện tại, không fetch thêm.
 *
 * `tabGroups`: mảng { label, slugs[] } — mỗi tab có thể gom nhiều category slug.
 * Nếu không truyền, fallback về behaviour cũ (1 tab = 1 category label).
 */
import type { AssetMap } from "../lib/images";
import ProductCard, { type ProductCardData } from "@ui/primitives/ProductCard.astro";
import SectionHeader from "@ui/primitives/SectionHeader.astro";

export interface TabGroup {
  label: string;
  /** Danh sách category slug thuộc tab này */
  slugs: string[];
}

interface Props {
  assets: AssetMap;
  title?: string;
  action?: { label: string; href: string };
  /**
   * Danh sách tab cố định với nhiều slug / tab.
   * Nếu truyền `tabGroups`, prop `tabs` bị bỏ qua.
   */
  tabGroups?: TabGroup[];
  /** @deprecated Dùng tabGroups thay thế */
  tabs?: string[];
  items: (ProductCardData & { category: string; categorySlug: string })[];
  /** Số item mỗi trang, mặc định 10 (2 dòng × 5 cột) */
  perPage?: number;
}

const {
  assets,
  title = "Bán chạy",
  action,
  tabGroups,
  tabs = [],
  items,
  perPage = 10,
} = Astro.props;

// Nếu có tabGroups thì dùng; fallback về tabs cũ
const resolvedTabGroups: TabGroup[] = tabGroups
  ? tabGroups
  : tabs.map((t) => ({ label: t, slugs: [t] }));

const allGroups: TabGroup[] = [
  { label: "Tất cả", slugs: [] }, // slugs rỗng = hiện hết
  ...resolvedTabGroups,
];
---

<section class="site-container" aria-labelledby="bestseller-heading" data-reveal>
  <SectionHeader {title} {action} class="mb-5" />

  <div
    role="tablist"
    aria-label="Lọc theo danh mục"
    class="mb-7 flex items-center gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-bs-tabs
  >
    {
      allGroups.map((g, i) => (
        <button
          type="button"
          role="tab"
          data-bs-tab={g.label}
          data-bs-tab-slugs={JSON.stringify(g.slugs)}
          aria-selected={i === 0}
          class="pill h-9 flex-none cursor-pointer border border-transparent px-4 text-label font-semibold whitespace-nowrap text-ink-muted transition-colors hover:text-ink aria-selected:border-primary aria-selected:text-primary"
        >
          {g.label}
        </button>
      ))
    }
  </div>

  <!-- Lưới sản phẩm: 2 cột mobile → 3 cột md → 5 cột lg -->
  <div
    class="grid grid-cols-2 gap-x-5 gap-y-9 md:grid-cols-3 lg:grid-cols-5"
    data-bs-grid
    data-bs-per={perPage}
    data-reveal-group
  >
    {
      items.map((p, i) => (
        <ProductCard
          {assets}
          {...p}
          layout="minimal"
          variant={(i % perPage) + 1}
          filterData={{ categorySlug: p.categorySlug, bsIndex: String(i) }}
        />
      ))
    }
  </div>

  <p data-bs-empty hidden class="py-10 text-center text-ink-muted">
    Chưa có sản phẩm trong danh mục này.
  </p>

  <!-- Pagination -->
  <nav
    aria-label="Phân trang sản phẩm bán chạy"
    class="mt-10 flex items-center justify-center gap-1.5"
    data-bs-pagination
    hidden
  ></nav>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-bs-grid]").forEach((grid) => {
    const section = grid.closest("section");
    if (!section) return;

    const perPage = parseInt(grid.dataset.bsPer ?? "10", 10);
    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-product]"));
    const tabsBar = section.querySelector<HTMLElement>("[data-bs-tabs]");
    const tabButtons = tabsBar
      ? Array.from(tabsBar.querySelectorAll<HTMLButtonElement>("[data-bs-tab]"))
      : [];
    const pagination = section.querySelector<HTMLElement>("[data-bs-pagination]");
    const emptyMsg = section.querySelector<HTMLElement>("[data-bs-empty]");

    // activeSlugs rỗng = hiện tất cả (tab "Tất cả")
    let activeSlugs: string[] = [];
    let current = 0;

    function matchesTab(card: HTMLElement) {
      if (activeSlugs.length === 0) return true;
      return activeSlugs.includes(card.dataset.categorySlug ?? "");
    }

    function renderPaginationButtons(totalPages: number) {
      if (!pagination) return;
      pagination.innerHTML = "";

      if (totalPages <= 1) {
        pagination.hidden = true;
        return;
      }
      pagination.hidden = false;

      for (let i = 0; i < totalPages; i++) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.dataset.bsPage = String(i);
        btn.setAttribute("aria-label", `Trang ${i + 1}`);
        btn.textContent = String(i + 1);
        btn.addEventListener("click", () => showPage(i, true, true));
        pagination.appendChild(btn);
      }

      const nextBtn = document.createElement("button");
      nextBtn.type = "button";
      nextBtn.dataset.bsNext = "";
      nextBtn.setAttribute("aria-label", "Trang tiếp theo");
      nextBtn.innerHTML =
        '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      nextBtn.addEventListener("click", () => showPage(current + 1, true, true));
      pagination.appendChild(nextBtn);
    }

    function updatePaginationStyles(totalPages: number) {
      if (!pagination) return;
      const pageBtns = Array.from(
        pagination.querySelectorAll<HTMLButtonElement>("[data-bs-page]")
      );
      pageBtns.forEach((btn) => {
        const p = parseInt(btn.dataset.bsPage ?? "0", 10);
        const active = p === current;
        btn.setAttribute("aria-current", active ? "page" : "false");
        btn.className = [
          "size-9 cursor-pointer rounded-full text-sm font-semibold transition-colors",
          active
            ? "bg-primary text-white"
            : "border border-line bg-surface text-ink-muted hover:border-primary hover:text-primary",
        ].join(" ");
      });

      const nextBtn = pagination.querySelector<HTMLButtonElement>("[data-bs-next]");
      if (nextBtn) {
        nextBtn.className =
          "flex size-9 cursor-pointer items-center justify-center rounded-full border border-line bg-surface text-ink-muted transition-colors hover:border-primary hover:text-primary";
        const disabled = current >= totalPages - 1;
        nextBtn.disabled = disabled;
        nextBtn.classList.toggle("opacity-40", disabled);
        nextBtn.classList.toggle("pointer-events-none", disabled);
      }
    }

    // Số thẻ mỗi hàng ở lưới rộng nhất (lg:grid-cols-5): độ trễ so le tính theo
    // cột chứ không theo thứ tự cả trang, để thẻ cuối trang 2 hàng không phải
    // chờ 9 × stagger rồi mới hiện.
    const STAGGER_COLS = 5;

    function showPage(page: number, shouldScroll = false, animate = false) {
      const filtered = cards.filter(matchesTab);
      const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
      current = Math.max(0, Math.min(page, totalPages - 1));
      const start = current * perPage;
      const end = start + perPage;

      let visibleIdx = 0;
      const entering: HTMLElement[] = [];
      cards.forEach((card) => {
        card.removeAttribute("data-bs-enter");
        if (!matchesTab(card)) {
          card.hidden = true;
          return;
        }
        card.hidden = visibleIdx < start || visibleIdx >= end;
        if (!card.hidden) entering.push(card);
        visibleIdx++;
      });

      // `hidden` → hiện lại không chạy transition (display:none không có
      // trạng thái đầu), nên dùng keyframe, gắn sau một lần reflow để animation
      // chạy lại dù thẻ vừa có thuộc tính này ở lần bấm trước.
      if (animate) {
        void grid.offsetWidth;
        entering.forEach((card, i) => {
          card.style.setProperty("--bs-enter-index", String(i % STAGGER_COLS));
          card.setAttribute("data-bs-enter", "");
        });
      }

      if (emptyMsg) emptyMsg.hidden = filtered.length > 0;

      renderPaginationButtons(totalPages);
      updatePaginationStyles(totalPages);

      if (shouldScroll) {
        section?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const rawSlugs = btn.dataset.bsTabSlugs ?? "[]";
        activeSlugs = JSON.parse(rawSlugs) as string[];
        tabButtons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
        showPage(0, false, true);
      });
    });

    // Khởi tạo trang đầu, tab "Tất cả" (không tự cuộn khi load)
    showPage(0, false);
  });
</script>

<style is:global>
  /* Thẻ hiện lại sau khi đổi tab / sang trang: trồi lên + mờ dần, so le theo
     cột. Dùng đúng token của khối reveal khi cuộn để hai hiệu ứng cùng nhịp.
     Khối prefers-reduced-motion ở base.css đã rút animation-duration về gần 0. */
  @keyframes bs-enter {
    from {
      opacity: 0;
      transform: translateY(var(--distance-reveal));
    }
  }

  [data-bs-grid] > [data-bs-enter] {
    animation: bs-enter var(--duration-base) var(--ease-out-soft) backwards;
    animation-delay: calc(var(--bs-enter-index, 0) * var(--stagger-reveal));
  }
</style>
