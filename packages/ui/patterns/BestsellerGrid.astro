---
/**
 * BÁN CHẠY — Island #3: tabs lọc + lưới 4 cột thẻ tối giản (ảnh + tên).
 *
 * Quan trọng cho SEO (§9, rủi ro "Filter làm hỏng SEO"): TOÀN BỘ sản phẩm được
 * render trong HTML ngay từ đầu. Tab chỉ bật/tắt `hidden` bằng CSS, không xoá
 * DOM, không fetch. Crawler thấy đủ mọi sản phẩm dù đang ở tab nào.
 */
import type { AssetMap } from "../lib/images";
import ProductCard, { type ProductCardData } from "@ui/primitives/ProductCard.astro";
import SectionHeader from "@ui/primitives/SectionHeader.astro";

interface Props {
  assets: AssetMap;
  title?: string;
  action?: { label: string; href: string };
  /** Nhãn tab; tab đầu tiên luôn là "Tất cả" */
  tabs: string[];
  items: (ProductCardData & { category: string })[];
}

const { assets, title = "Bán chạy", action, tabs, items } = Astro.props;
const allTabs = ["Tất cả", ...tabs];
---

<section class="site-container" aria-labelledby="bestseller-heading">
  <SectionHeader {title} {action} class="mb-5" />

  <div
    role="tablist"
    aria-label="Lọc theo danh mục"
    class="mb-7 flex items-center gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-tabs
  >
    {
      allTabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          data-tab={t}
          aria-selected={i === 0}
          class="pill h-9 flex-none border border-transparent px-4 text-label font-semibold whitespace-nowrap text-ink-muted transition-colors hover:text-ink aria-selected:border-primary aria-selected:text-primary"
        >
          {t}
        </button>
      ))
    }
  </div>

  <div class="grid grid-cols-2 gap-x-5 gap-y-9 md:grid-cols-3 lg:grid-cols-4" data-product-grid>
    {
      items.map((p, i) => (
        <ProductCard
          {assets}
          {...p}
          layout="minimal"
          variant={i + 1}
          filterData={{ category: p.category }}
        />
      ))
    }
  </div>

  <p data-empty hidden class="py-10 text-center text-ink-muted">
    Chưa có sản phẩm trong danh mục này.
  </p>
</section>

<script>
  // Island #3 — Bestseller tabs. ~1 KB, không phụ thuộc framework.
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((tablist) => {
    const section = tablist.closest("section");
    if (!section) return;
    const cards = section.querySelectorAll<HTMLElement>("[data-product]");
    const empty = section.querySelector<HTMLElement>("[data-empty]");

    const apply = (tab: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = tab === "Tất cả" || card.dataset.category === tab;
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    };

    tablist.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        tablist
          .querySelectorAll("[data-tab]")
          .forEach((b) => b.setAttribute("aria-selected", "false"));
        btn.setAttribute("aria-selected", "true");
        apply(btn.dataset.tab!);
      });
    });
  });
</script>
