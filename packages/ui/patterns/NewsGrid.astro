---
/**
 * TIN TỨC — Khối bài viết trên trang chủ CFC dạng dãy thẻ trượt ngang (CSS scroll-snap),
 * cuộn mượt từ trái qua phải trên mọi kích thước màn hình.
 *
 * Cuối dãy trượt ngang là thẻ "Khám phá thêm" (action) dẫn tới trang /blog,
 * thay thế nút bấm đặt phía dưới trước đây.
 */
import type { AssetMap } from "../lib/images";
import SectionHeader from "@ui/primitives/SectionHeader.astro";
import PostCard from "@ui/primitives/PostCard.astro";
import PillButton from "@ui/primitives/PillButton.astro";
import { Icon } from "astro-icon/components";

export interface NewsItem {
  title: string;
  href: string;
  date: Date;
  cover?: string;
  description?: string;
}

interface Props {
  assets: AssetMap;
  title?: string;
  action?: { label: string; href: string };
  items: NewsItem[];
}

const { assets, title = "Tin tức", action, items } = Astro.props;
---

<section class="site-container" aria-labelledby="news-heading" data-reveal>
  <SectionHeader id="news-heading" {title} titleClass="text-[1.25rem] md:text-[1.625rem]" />

  <div class="relative" data-carousel>
    <div
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-4 pt-1 items-stretch [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-carousel-track
    >
      {
        items.map((a, i) => (
          <div class="w-[280px] shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] md:w-[calc((100%-3rem)/3)]">
            <PostCard
              {assets}
              title={a.title}
              href={a.href}
              date={a.date}
              cover={a.cover}
              description={a.description}
              variant={i + 1}
              showDate={false}
              ratio="16x9"
              class="h-full"
            />
          </div>
        ))
      }

      {
        action && (
          <div class="w-[280px] shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] md:w-[calc((100%-3rem)/3)]">
            <div class="group relative flex h-full min-h-[340px] flex-col items-center justify-center p-6 text-center md:p-8">
              <h3 class="mb-3 text-(length:--text-post-card-title) font-bold text-ink transition-colors group-hover:text-primary">
                Xem tất cả bài viết
              </h3>
              <p class="mb-6 max-w-[26ch] text-(length:--text-post-card-excerpt) leading-relaxed text-ink-muted text-pretty">
                Khám phá thêm xu hướng thiết kế và kiến thức bao bì F&B
              </p>
              <PillButton
                text={action.label}
                href={action.href}
                tone="solid"
                class="after:absolute after:inset-0 pointer-events-auto"
              />
            </div>
          </div>
        )
      }
    </div>

    <button
      type="button"
      data-carousel-prev
      aria-label="Xem tin trước"
      hidden
      class="absolute top-[80px] sm:top-[100px] md:top-[110px] left-1 sm:left-0 -translate-y-1/2 sm:-translate-x-1/2 grid place-items-center rounded-full border border-line bg-surface text-ink shadow-header transition-colors hover:bg-surface-alt size-(--size-carousel-nav) z-10 cursor-pointer focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary"
    >
      <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Xem tin tiếp theo"
      class="absolute top-[80px] sm:top-[100px] md:top-[110px] right-1 sm:right-0 -translate-y-1/2 sm:translate-x-1/2 grid place-items-center rounded-full border border-line bg-surface text-ink shadow-header transition-colors hover:bg-surface-alt size-(--size-carousel-nav) z-10 cursor-pointer focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary"
    >
      <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  // Điều khiển carousel: track cuộn bằng CSS scroll-snap,
  // JS lo 2 nút mũi tên + cập nhật trạng thái ẩn/hiện theo vị trí cuộn.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    if (root.dataset.carouselReady) return;
    root.dataset.carouselReady = "true";

    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (!track || !prev || !next) return;

    // Cuộn đúng bề ngang 1 card + gap để mép snap khít vào card kế tiếp
    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "24");
      return first.getBoundingClientRect().width + gap;
    };

    const updateButtons = () => {
      const max = track.scrollWidth - track.clientWidth;
      const canScroll = max > 4;
      prev.hidden = !canScroll || track.scrollLeft <= 4;
      next.hidden = !canScroll || track.scrollLeft >= max - 4;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();

    // Đồng bộ lại khi ảnh/layout hoàn tất
    requestAnimationFrame(updateButtons);
    setTimeout(updateButtons, 300);
  });
</script>
