---
/**
 * TIN TỨC — lưới 4 bài trên trang chủ, dựng bằng `PostCard` (card dùng chung
 * với /blog, /blog/tag và khối bài liên quan).
 *
 * Card không có khung nền nên ảnh dán thẳng lên nền hoạ tiết của trang chủ,
 * đúng concept CFC.
 *
 * Bật `dense` vì lưới 4 cột cho card chỉ ~293px — hẹp hơn max-width mặc định
 * của tiêu đề/mô tả, nên nếu không đổi sang token `*-dense` thì chữ tràn sát
 * mép ảnh và mất dáng tháp (khác hẳn cùng card ở /blog, lưới 3 cột rộng hơn).
 */
import type { AssetMap } from "../lib/images";
import SectionHeader from "@ui/primitives/SectionHeader.astro";
import PostCard from "@ui/primitives/PostCard.astro";

export interface NewsItem {
  title: string;
  href: string;
  date: Date;
  cover?: string;
  description?: string;
}

interface Props {
  assets: AssetMap;
  title?: string;
  action?: { label: string; href: string };
  items: NewsItem[];
}

const { assets, title = "Tin tức", action, items } = Astro.props;
---

<section class="site-container" aria-labelledby="news-heading" data-reveal>
  <SectionHeader {title} {action} />

  {/* Thêm nấc md: trước đây nhảy thẳng 2 → 4 cột nên ở 1024–1200px bốn card
      chỉ còn ~283px, hẹp hơn cả ngưỡng mà token `-dense` được tính cho. */}
  <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4" data-reveal-group>
    {
      items.map((a, i) => (
        <PostCard
          {assets}
          title={a.title}
          href={a.href}
          date={a.date}
          cover={a.cover}
          description={a.description}
          variant={i + 1}
          width={480}
          dense
        />
      ))
    }
  </div>
</section>
