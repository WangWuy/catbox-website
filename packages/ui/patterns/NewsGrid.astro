---
/**
 * TIN TỨC — lưới 3 cột trên trang chủ, dựng bằng `PostCard` (card dùng chung
 * với /blog, /blog/tag và khối bài liên quan).
 *
 * Mobile (`<md:`): carousel cuộn ngang scroll-snap thay cho lưới — cùng pattern
 * với `ProductCarousel` (track + 2 nút mũi tên), card khít đúng 2/trang qua
 * `--width-news-carousel-card` (KHÔNG hé mép card thứ 3 — card đó chỉ có ảnh
 * nên hé một dải mỏng trông như vỡ layout, không phải gợi ý cuộn tiếp). Card
 * carousel ẩn mô tả (`hideExcerptMobile`), chỉ còn ảnh + tiêu đề vì bề ngang
 * không đủ chỗ. Nút mũi tên hiện luôn ở mobile (khác ProductCarousel chỉ hiện
 * từ md:) vì đây là cách điều hướng chính trên màn hẹp. Từ `md:` trở lên
 * carousel ẩn, quay lại lưới 3 cột tĩnh như cũ.
 */
import type { AssetMap } from "../lib/images";
import SectionHeader from "@ui/primitives/SectionHeader.astro";
import PostCard from "@ui/primitives/PostCard.astro";
import PillButton from "@ui/primitives/PillButton.astro";
import { Icon } from "astro-icon/components";

export interface NewsItem {
  title: string;
  href: string;
  date: Date;
  cover?: string;
  description?: string;
}

interface Props {
  assets: AssetMap;
  title?: string;
  action?: { label: string; href: string };
  items: NewsItem[];
}

const { assets, title = "Tin tức", action, items } = Astro.props;
---

<section class="site-container" aria-labelledby="news-heading" data-reveal>
  <SectionHeader id="news-heading" {title} />

  {/* Mobile: carousel cuộn ngang. `md:hidden` gỡ hẳn khỏi layout thay vì chỉ
      ẩn — nếu không track vẫn chiếm chỗ và JS vẫn gắn scroll listener thừa. */}
  <div class="relative md:hidden" data-carousel>
    <div
      class="flex snap-x snap-mandatory gap-(--space-news-carousel-gap) overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      data-carousel-track
    >
      {
        items.map((a, i) => (
          <div class="w-(--width-news-carousel-card) shrink-0 snap-start">
            <PostCard
              {assets}
              title={a.title}
              href={a.href}
              date={a.date}
              cover={a.cover}
              description={a.description}
              variant={i + 1}
              showDate={false}
              hideExcerptMobile
              ratio="16x9"
            />
          </div>
        ))
      }
    </div>

    <button
      type="button"
      data-carousel-prev
      aria-label="Xem tin trước"
      hidden
      class="absolute top-1/3 left-0 grid -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border border-line bg-surface text-ink shadow-header transition-colors hover:bg-surface-alt size-(--size-carousel-nav)"
    >
      <Icon name="lucide:chevron-left" class="size-4" aria-hidden="true" />
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Xem tin tiếp theo"
      class="absolute top-1/3 right-0 grid -translate-y-1/2 translate-x-1/2 place-items-center rounded-full border border-line bg-surface text-ink shadow-header transition-colors hover:bg-surface-alt size-(--size-carousel-nav)"
    >
      <Icon name="lucide:chevron-right" class="size-4" aria-hidden="true" />
    </button>
  </div>

  {/* Từ md: trở lên: lưới 3 cột tĩnh như cũ */}
  <div class="hidden gap-x-6 gap-y-10 md:grid md:grid-cols-3" data-reveal-group>
    {
      items.map((a, i) => (
        <PostCard
          {assets}
          title={a.title}
          href={a.href}
          date={a.date}
          cover={a.cover}
          description={a.description}
          variant={i + 1}
          showDate={false}
          ratio="16x9"
        />
      ))
    }
  </div>

  {
    action && (
      <div class="mt-10 flex justify-center">
        <PillButton text={action.label} href={action.href} tone="solid" />
      </div>
    )
  }
</section>

<script>
  // Cùng logic điều khiển carousel với ProductCarousel: track cuộn bằng CSS
  // scroll-snap, JS chỉ lo 2 nút mũi tên + ẩn/hiện theo vị trí cuộn. Chọn theo
  // `data-carousel` nên nhiều carousel trên cùng trang không đụng nhau.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    if (!track || !prev || !next) return;

    // Cuộn đúng bề ngang 1 card + gap (không phải 0.9 * clientWidth như
    // ProductCarousel): card ở đây khít 2/trang, cuộn lệch tỉ lệ sẽ dừng giữa
    // card kế tiếp thay vì đúng mép snap, lộ crop xấu như card thứ 3 trước đây.
    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0");
      return first.getBoundingClientRect().width + gap;
    };

    const updateButtons = () => {
      const max = track.scrollWidth - track.clientWidth;
      const canScroll = max > 4;
      prev.hidden = !canScroll || track.scrollLeft <= 4;
      next.hidden = !canScroll || track.scrollLeft >= max - 4;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    track.addEventListener("scroll", updateButtons, { passive: true });
    window.addEventListener("resize", updateButtons);
    updateButtons();
  });
</script>
