---
/**
 * PartnerStrip — dải logo đối tác tự động trượt liên tục (marquee), dừng khi
 * hover/focus. Danh sách logo được nhân đôi trong DOM để animation loop liền
 * mạch bằng transform: translateX(-50%) — nửa đầu và nửa sau giống hệt nhau
 * nên lúc animation "reset" về 0% trông như đang trượt tiếp, không giật.
 *
 * Thiết kế: nền trắng, border trên/dưới mỏng, logo grayscale → màu khi hover.
 *
 * Props:
 *  - title/accent : nhãn nhỏ bên trái, "CFC" tô màu primary tách biệt
 *  - partners     : mảng { name, logo, href? }
 *    logo: đường dẫn nội bộ (/partners/...) hoặc URL tuyệt đối.
 */

interface Partner {
  name: string;
  /** Đường dẫn tới file ảnh logo (relative /... hoặc URL tuyệt đối) */
  logo: string;
  /** URL trang web đối tác; bỏ trống thì không wrap thẻ <a> */
  href?: string;
}

interface Props {
  /** Nhãn nhỏ bên trái (ví dụ "Đối tác tin cậy của") */
  title?: string;
  /** Phần đuôi tô màu primary, tách biệt khỏi `title` (ví dụ tên brand "CFC") */
  accent?: string;
  partners: Partner[];
}

const { title = "Đối tác tin cậy của", accent = "CFC", partners } = Astro.props;

// Nhân đôi để track dài gấp 2 danh sách gốc — animation trượt đúng 50% rồi
// lặp lại là ghép liền vào bản sao, mắt không nhận ra điểm nối.
const track = [...partners, ...partners];
---

<div class="partner-strip-wrapper border-y border-border bg-white py-5">
  <div class="site-container flex items-center gap-4">
    {/* Label bên trái — ẩn trên mobile */}
    {
      title && (
        <p class="hidden shrink-0 text-xs font-semibold uppercase tracking-widest text-ink-muted md:block">
          {title} {accent && <span class="text-primary">{accent}</span>}
        </p>
      )
    }

    {/* Viewport cắt phần logo tràn ra ngoài — track bên trong chạy marquee */}
    <div class="marquee-viewport flex-1 overflow-hidden" style="mask-image:linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);">
      <div class="marquee-track flex w-max items-center gap-8">
        {
          track.map((p) => {
            const img = (
              <img
                src={p.logo}
                alt={p.name}
                width="120"
                height="48"
                loading="lazy"
                class="h-10 w-auto max-w-[120px] cursor-pointer object-contain grayscale transition duration-300 hover:grayscale-0"
              />
            );
            return (
              <div class="flex shrink-0 items-center justify-center px-2" aria-hidden="true">
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener noreferrer" tabindex={-1} class="block">
                    {img}
                  </a>
                ) : (
                  img
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-track {
    animation: partner-marquee var(--duration-marquee) linear infinite;
  }

  /* Dừng khi rê chuột hoặc focus vào một logo bên trong (bàn phím) — người
     dùng cần thời gian đọc/bấm mà không bị trôi mất mục tiêu. */
  .marquee-viewport:hover .marquee-track,
  .marquee-track:has(:focus-visible) {
    animation-play-state: paused;
  }

  @keyframes partner-marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* Track dài gấp đôi (danh sách nhân đôi) nên lùi đúng nửa track là
         khớp lại điểm bắt đầu ban đầu, loop liền mạch. */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
