---
/**
 * Nút pill bo tròn dùng chung (VD: "Xem tất cả →" ở SectionHeader, "Xem thêm
 * tin →" ở NewsGrid). Render <a> nếu có href, ngược lại <button> để gắn sự
 * kiện client (onclick, data-*...) qua rest props.
 */
export interface Props extends astroHTML.JSX.HTMLAttributes {
  text: string;
  href?: string;
  /** Nền nút — mặc định `white`; `default` cho nền phụ (surface-alt); `solid` nền primary chữ trắng, không viền (CTA nổi bật, vd. "Khám phá thêm" ở NewsGrid) */
  tone?: "default" | "white" | "solid";
  class?: string;
}

const { text, href, tone = "white", class: className = "", ...rest } = Astro.props;

const toneClass =
  tone === "solid"
    ? "border-transparent bg-primary text-white hover:bg-primary-hover"
    : tone === "white"
      ? "border-line bg-white text-ink-muted hover:bg-surface-alt"
      : "border-line bg-surface-alt text-ink-muted hover:bg-surface-tint";
const pillClass = `pill h-10 border px-5 text-label font-semibold transition-colors ${toneClass} ${className}`;
---

{
  href ? (
    <a href={href} class={pillClass} {...rest}>
      {text}
    </a>
  ) : (
    <button type="button" class={pillClass} {...rest}>
      {text}
    </button>
  )
}
