---
/**
 * Island #1 — Search box (TECH_STACK_v2 §3).
 *
 * Form GET thuần sang `/search?q=...`; trang đó dựng Pagefind UI và đọc `q`.
 * Không thay thế ô nhập tại chỗ (từng làm ô search biến mất khi focus).
 * Index Pagefind sinh lúc build (`pagefind --site dist`), dev chưa có index.
 */
interface Props {
  placeholder: string;
  class?: string;
}

const { placeholder, class: className } = Astro.props;
---

<form
  role="search"
  action="/search"
  method="get"
  class={`flex h-(--height-search) items-center gap-2.5 rounded-input border border-line bg-surface-input px-5 ${className ?? ""}`}
>
  <svg width="17" height="17" viewBox="0 0 17 17" aria-hidden="true" class="flex-none">
    <circle cx="7" cy="7" r="5.4" fill="none" stroke="currentColor" stroke-width="1.6" class="text-ink-faint"></circle>
    <line x1="11.2" y1="11.2" x2="15.4" y2="15.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="text-ink-faint"></line>
  </svg>
  <label class="sr-only" for="site-search">Tìm kiếm sản phẩm</label>
  <input
    id="site-search"
    type="search"
    name="q"
    placeholder={placeholder}
    autocomplete="off"
    class="w-full flex-1 border-0 bg-transparent text-nav text-ink outline-none placeholder:text-ink-faint"
  />
</form>
