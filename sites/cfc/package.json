{
  "name": "@catbox/site-cfc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "normalize-images": "node scripts/normalize-images.mjs",
    "predev": "node scripts/normalize-images.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/normalize-images.mjs",
    "build": "astro build && pagefind --site dist",
    "build:vercel": "node scripts/normalize-images.mjs && KEYSTATIC_ADMIN=vercel astro build && pagefind --site dist/client && cp -r dist/client/pagefind .vercel/output/static/pagefind",
    "preview": "astro preview",
    "astro": "astro",
    "dev:admin": "KEYSTATIC_ADMIN=node astro dev",
    "build:admin": "node scripts/normalize-images.mjs && KEYSTATIC_ADMIN=cloudflare astro build",
    "deploy:admin": "node scripts/normalize-images.mjs && KEYSTATIC_ADMIN=cloudflare astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@catbox/config": "workspace:*",
    "@catbox/tokens": "workspace:*",
    "@catbox/ui": "workspace:*",
    "@iconify-json/circle-flags": "^1.2.0",
    "@iconify-json/lucide": "^1.2.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@tailwindcss/vite": "^4.1.14",
    "astro": "^7.2.9",
    "astro-icon": "^1.1.5",
    "pagefind": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/node": "11.1.4",
    "@astrojs/vercel": "^11.0.11",
    "wrangler": "^4.127.1"
  }
}
