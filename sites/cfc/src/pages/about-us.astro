---
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import StatsBar from "@ui/patterns/StatsBar.astro";
import { BRANDS } from "@config/brands";

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const b = BRANDS.cfc;

/** Nguồn duy nhất trong `brands.ts` — /contact cũng đọc đúng bộ số này. */
const stats = b.stats;

/**
 * TODO(nội dung): hai đoạn dưới là KHUNG CHỜ do khách chưa cung cấp câu tầm
 * nhìn / sứ mệnh chính thức. Thay bằng văn bản thật trước khi lên production.
 */
const purpose = [
  {
    icon: "lucide:eye",
    title: "Tầm nhìn",
    body: "— cần khách cung cấp nội dung chính thức —",
  },
  {
    icon: "lucide:target",
    title: "Sứ mệnh",
    body: "— cần khách cung cấp nội dung chính thức —",
  },
];

/** Ba trang con của mục "Về chúng tôi" */
const sections = [
  {
    icon: "lucide:factory",
    title: "Năng lực sản xuất",
    desc: "Hai dây chuyền Offset và Flexo đặt tại KCN Đồng Văn, Hà Nam.",
    href: "/nang-luc-san-xuat",
  },
  {
    icon: "lucide:workflow",
    title: "Quy trình làm việc",
    desc: "Mua mẫu có sẵn hay đặt in riêng — kèm chính sách thiết kế.",
    href: "/quy-trinh",
  },
  {
    icon: "lucide:file-text",
    title: "Chính sách công ty",
    desc: "Thanh toán, đổi trả & bảo hành, điều khoản sử dụng.",
    href: "/chinh-sach",
  },
];

const description =
  "CFC là xưởng sản xuất bao bì giấy F&B trực tiếp tại KCN Đồng Văn, Hà Nam. 10+ năm kinh nghiệm, đạt chuẩn ATVSTP và HACCP, thành viên hệ sinh thái Catbox Packaging.";
---

<Layout title="Về chúng tôi" {description}>
  <Breadcrumb items={[{ label: "Về chúng tôi" }]} />

  <div class="flex flex-col gap-16 pb-16">
    <section class="site-container grid items-center gap-10 lg:grid-cols-2">
      <div class="flex flex-col gap-5">
        <h1 class="text-3xl font-extrabold tracking-tight uppercase md:text-section">
          Xưởng sản xuất trực tiếp, không qua trung gian
        </h1>
        <p class="leading-relaxed text-ink-muted">
          CFC vận hành nhà máy riêng tại KCN Đồng Văn, Duy Tiên, Hà Nam. Toàn bộ khâu in flexo, bế
          và gấp dán đều làm tại chỗ — nên khách nhận đúng giá xưởng và kiểm soát được tiến độ thay
          vì phụ thuộc một bên thứ ba.
        </p>
        <p class="leading-relaxed text-ink-muted">
          Chúng tôi phục vụ chuỗi bánh mì, quán ăn nhanh và thương hiệu F&B cần bao bì giấy in
          thương hiệu với số lượng lớn, giá ổn định và giao đúng lịch.
        </p>
        <div class="flex flex-wrap gap-2.5">
          {
            b.certifications.map((c) => (
              <span class="pill flex items-center gap-1.5 border border-line bg-surface-alt px-4 py-2 text-micro text-ink-muted">
                <Icon name="lucide:check" class="size-(--size-icon-inline)" aria-hidden="true" /> {c}
              </span>
            ))
          }
        </div>
      </div>

      <div class="overflow-hidden rounded-panel bg-surface-tint">
        <SmartImage
          {assets}
          src="brand/hero-banner.png"
          alt="Xưởng sản xuất bao bì giấy CFC"
          width={1200}
          height={800}
          ratio="4x3"
          priority
          class="aspect-4/3 w-full object-cover"
        />
      </div>
    </section>

    <StatsBar {stats} />

    <section class="site-container grid gap-6 md:grid-cols-2" aria-label="Tầm nhìn và sứ mệnh">
      {
        purpose.map((p) => (
          <article class="flex flex-col gap-4 rounded-panel bg-surface-alt p-8 md:p-10">
            <span class="flex size-(--size-icon-panel-box) items-center justify-center rounded-panel bg-surface text-primary">
              <Icon name={p.icon} class="size-(--size-icon-panel)" aria-hidden="true" />
            </span>
            <h2 class="font-display text-2xl font-bold">{p.title}</h2>
            <p class="leading-relaxed text-ink-muted">{p.body}</p>
          </article>
        ))
      }
    </section>

    <section class="site-container flex flex-col gap-7">
      <h2 class="text-2xl font-extrabold tracking-tight uppercase md:text-section">Tìm hiểu thêm</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {
          sections.map((s) => (
            <a
              href={s.href}
              class="group flex flex-col gap-3 rounded-panel border border-line bg-surface p-6 transition-colors hover:border-primary"
            >
              <span class="flex size-(--size-icon-panel-box) items-center justify-center rounded-panel bg-surface-tint text-primary">
                <Icon name={s.icon} class="size-(--size-icon-panel)" aria-hidden="true" />
              </span>
              <h3 class="font-display text-card-title font-bold">{s.title}</h3>
              <p class="text-meta leading-relaxed text-ink-muted">{s.desc}</p>
              <span class="mt-auto flex items-center gap-1.5 pt-2 text-label font-semibold text-primary">
                Xem chi tiết
                <Icon
                  name="lucide:arrow-right"
                  class="size-(--size-icon-inline) transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="site-container">
      <div class="flex flex-col gap-4 rounded-panel bg-surface-alt p-8 md:p-10">
        <h2 class="font-display text-2xl font-bold">Pháp nhân</h2>
        <p class="leading-relaxed text-ink-muted">
          {b.legalName}<br />
          Nhà máy: KCN Đồng Văn, Duy Tiên, Hà Nam<br />
          Văn phòng: Số 12 Nguyễn Trãi, Hà Đông, Hà Nội
        </p>
        <a
          href="/contact"
          class="pill mt-2 h-12 w-fit bg-cta px-7 text-white transition-colors hover:bg-cta-hover"
        >
          Liên hệ nhận báo giá
        </a>
      </div>
    </section>
  </div>
</Layout>
