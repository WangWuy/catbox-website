---
export const prerender = true;

/**
 * Trang "Về chúng tôi".
 *
 * Toàn bộ chữ đọc từ singleton "Trang giới thiệu" trong Keystatic
 * (`src/content/pages-data/about.json`). Ba khối trước đây mang chú thích
 * TODO(nội dung) — tổng quan, tầm nhìn/sứ mệnh, giá trị cốt lõi + mục tiêu
 * chiến lược — giờ khách tự điền, không phải nhờ dev thay chuỗi trong code nữa.
 */
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { parseAbout } from "@config/pages";
import Layout from "../layouts/Layout.astro";
import aboutData from "../content/pages-data/about.json";
import PageHero from "@ui/patterns/PageHero.astro";
import SectionHeader from "@ui/primitives/SectionHeader.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import CoreValues from "@ui/patterns/CoreValues.astro";
import FlipCard from "@ui/patterns/FlipCard.astro";
import StrategicGoals from "@ui/patterns/StrategicGoals.astro";
import FactoryReels from "@ui/patterns/FactoryReels.astro";

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const about = parseAbout(aboutData);
const description = about.seo.description;
---

<Layout title={about.seo.title} {description}>
  <PageHero
    title={about.hero.title}
    crumbs={[{ label: about.hero.title }]}
    {assets}
    image={about.hero.image}
    imageAlt={about.hero.imageAlt}
  />

  <div class="flex flex-col gap-16 pt-16 pb-16">
    <section class="site-container grid items-center gap-10 lg:grid-cols-2">
      <div class="grid grid-cols-2 gap-4">
        {
          about.overview.images.map((img, i) => (
            <div class="overflow-hidden rounded-image-soft bg-surface-tint">
              <SmartImage
                {assets}
                src={img.src}
                alt={img.alt}
                width={800}
                height={600}
                ratio="4x3"
                priority={i === 0}
                class="aspect-4/3 w-full object-cover"
              />
            </div>
          ))
        }
      </div>

      <div class="flex flex-col gap-5">
        <SectionHeader
          title={about.overview.title}
          accent={about.overview.accent}
          rule
          spacing="none"
        />
        <p class="leading-relaxed text-ink-muted">{about.overview.body}</p>
      </div>
    </section>

    <section class="site-container flex flex-col gap-7" aria-label="Tầm nhìn và sứ mệnh" data-reveal>
      <SectionHeader
        title={about.purpose.title}
        accent={about.purpose.accent}
        rule
        spacing="none"
      />
      <div class="grid gap-6 md:grid-cols-2">
        {
          about.purpose.items.map((p, i) => (
            <FlipCard
              icon={p.icon}
              title={p.title}
              body={p.body}
              glowFrom={i === 0 ? "top-right" : "top-left"}
            />
          ))
        }
      </div>
    </section>

    <CoreValues
      title={about.coreValues.title}
      accent={about.coreValues.accent}
      values={about.coreValues.items}
    />

    <StrategicGoals
      title={about.strategicGoals.title}
      accent={about.strategicGoals.accent}
      label={about.strategicGoals.label}
      goals={about.strategicGoals.items}
    />

    <div class="flex flex-col gap-7">
      <SectionHeader
        title={about.video.title}
        accent={about.video.accent}
        rule
        spacing="none"
        class="site-container"
      />
      <FactoryReels
        {assets}
        label={about.video.reels.label}
        video={about.video.reels.video}
        poster={about.video.reels.poster}
        variant="pill"
      />
    </div>

    <section class="site-container flex flex-col gap-7" data-reveal>
      <SectionHeader
        title={about.sections.title}
        accent={about.sections.accent}
        rule
        spacing="none"
      />
      <div class="grid gap-4 md:grid-cols-3" data-reveal-group>
        {
          about.sections.items.map((s) => (
            <a
              href={s.href}
              class="group flex flex-col gap-3 rounded-panel border border-line bg-surface p-6 transition-colors hover:border-primary"
            >
              <span class="flex size-(--size-icon-panel-box) items-center justify-center rounded-panel bg-surface-tint text-primary">
                <Icon name={s.icon} class="size-(--size-icon-panel)" aria-hidden="true" />
              </span>
              <h3 class="font-display text-card-title font-bold">{s.title}</h3>
              <p class="text-meta leading-relaxed text-ink-muted">{s.desc}</p>
              <span class="mt-auto flex items-center gap-1.5 pt-2 text-label font-semibold text-primary">
                Xem chi tiết
                <Icon
                  name="lucide:arrow-right"
                  class="size-(--size-icon-inline) transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
