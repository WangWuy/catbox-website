---
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "@ui/seo/Breadcrumb.astro";
import SmartImage from "@ui/media/SmartImage.astro";
import StatsBar from "@ui/home/StatsBar.astro";
import { BRANDS } from "@config/brands";

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const b = BRANDS.cfc;

const stats = [
  { num: "10+", label: "Năm kinh nghiệm" },
  { num: "5.000+", label: "Khách hàng đối tác" },
  { num: "20.000+", label: "Đơn hàng thành phẩm" },
  { num: "100%", label: "Đảm bảo chất lượng", highlight: true },
];

const process = [
  { num: "01", title: "Tiếp nhận yêu cầu", desc: "Ghi nhận loại bao bì, kích thước, chất liệu và số lượng." },
  { num: "02", title: "Báo giá & duyệt mẫu", desc: "Báo giá trong 30 phút; in mẫu thật nếu khách cần xem trước." },
  { num: "03", title: "Dàn file & canh khuôn", desc: "Xưởng dàn file, canh khuôn bế và tràn lề — miễn phí." },
  { num: "04", title: "In flexo cuộn", desc: "In 1–4 màu bằng mực gốc nước đạt chuẩn tiếp xúc thực phẩm." },
  { num: "05", title: "Bế, gấp dán, kiểm tra", desc: "Gấp dán tự động, kiểm tra ngẫu nhiên theo lô trước khi đóng gói." },
  { num: "06", title: "Đóng gói & giao hàng", desc: "Giao toàn quốc; khu vực Hà Nội / Hà Nam giao trong 24–48h." },
];

const description =
  "CFC là xưởng sản xuất bao bì giấy F&B trực tiếp tại KCN Đồng Văn, Hà Nam. 10+ năm kinh nghiệm, đạt chuẩn ATVSTP và HACCP, thành viên hệ sinh thái Catbox Packaging.";
---

<Layout title="Về chúng tôi" {description}>
  <Breadcrumb items={[{ label: "Về chúng tôi" }]} />

  <div class="flex flex-col gap-16 pb-16">
    <section class="site-container grid items-center gap-10 lg:grid-cols-2">
      <div class="flex flex-col gap-5">
        <h1 class="text-3xl font-extrabold tracking-tight uppercase md:text-section">
          Xưởng sản xuất trực tiếp, không qua trung gian
        </h1>
        <p class="leading-relaxed text-ink-muted">
          CFC vận hành nhà máy riêng tại KCN Đồng Văn, Duy Tiên, Hà Nam. Toàn bộ khâu in flexo, bế
          và gấp dán đều làm tại chỗ — nên khách nhận đúng giá xưởng và kiểm soát được tiến độ thay
          vì phụ thuộc một bên thứ ba.
        </p>
        <p class="leading-relaxed text-ink-muted">
          Chúng tôi phục vụ chuỗi bánh mì, quán ăn nhanh và thương hiệu F&B cần bao bì giấy in
          thương hiệu với số lượng lớn, giá ổn định và giao đúng lịch.
        </p>
        <div class="flex flex-wrap gap-2.5">
          {
            b.certifications.map((c) => (
              <span class="pill border border-line bg-surface-alt px-4 py-2 text-[12.5px] text-ink-muted">
                ✓ {c}
              </span>
            ))
          }
        </div>
      </div>

      <div class="overflow-hidden rounded-panel bg-surface-tint">
        <SmartImage
          {assets}
          src="brand/hero-banner.png"
          alt="Xưởng sản xuất bao bì giấy CFC"
          width={1200}
          height={800}
          ratio="4x3"
          priority
          class="aspect-4/3 w-full object-cover"
        />
      </div>
    </section>

    <StatsBar {stats} />

    <section class="site-container" id="nang-luc">
      <h2 class="mb-7 text-2xl font-extrabold tracking-tight uppercase md:text-section">
        Quy trình 6 bước
      </h2>
      <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          process.map((s) => (
            <li class="flex flex-col gap-2.5 rounded-panel border border-line bg-surface p-6 shadow-card">
              <span class="font-display text-3xl leading-none font-extrabold text-primary/25">
                {s.num}
              </span>
              <h3 class="font-display text-[17px] font-bold">{s.title}</h3>
              <p class="text-sm leading-relaxed text-ink-muted">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="site-container">
      <div class="flex flex-col gap-4 rounded-panel bg-surface-alt p-8 md:p-10">
        <h2 class="font-display text-2xl font-bold">Pháp nhân</h2>
        <p class="leading-relaxed text-ink-muted">
          {b.legalName}<br />
          Nhà máy: KCN Đồng Văn, Duy Tiên, Hà Nam<br />
          Văn phòng: Số 12 Nguyễn Trãi, Hà Đông, Hà Nội
        </p>
        <a
          href="/contact"
          class="pill mt-2 h-12 w-fit bg-cta px-7 text-white transition-colors hover:bg-cta-hover"
        >
          Liên hệ nhận báo giá
        </a>
      </div>
    </section>
  </div>
</Layout>
