---
export const prerender = true;

import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { parseBlogPage } from "@config/pages";
import Layout from "../../layouts/Layout.astro";
import blogData from "../../content/pages-data/blog.json";
import PageHero from "@ui/patterns/PageHero.astro";
import PostCard from "@ui/primitives/PostCard.astro";

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, z) => z.data.date.getTime() - a.data.date.getTime(),
);

const page = parseBlogPage(blogData);

// Chỉ còn dùng cho <meta name="description"> ở Layout — banner không hiện mô tả.
const description = page.seo.description;
---

<Layout title={page.seo.title} {description}>
  <PageHero
    title={page.heroTitle}
    crumbs={[{ label: page.crumbLabel }]}
    {assets}
    image={page.heroImage}
  />

  <div class="site-container pt-10 pb-16">
    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((p, i) => (
          <PostCard
            {assets}
            as="h2"
            title={p.data.title}
            href={`/blog/${p.id}`}
            date={p.data.date}
            cover={p.data.cover}
            description={p.data.description}
            variant={i + 1}
          />
        ))
      }
    </div>
  </div>
</Layout>
