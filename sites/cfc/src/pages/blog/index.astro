---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import DateBadge from "@ui/primitives/DateBadge.astro";
import { collectTags, tagHref } from "@config/blog";

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, z) => z.data.date.getTime() - a.data.date.getTime(),
);

const tags = collectTags(posts);

const fmt = (d: Date) =>
  d.toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" });

const description =
  "Cẩm nang bao bì giấy cho chuỗi F&B: so sánh chất liệu, kích thước chuẩn, kinh nghiệm đặt in và bảng giá tham khảo.";
---

<Layout title="Tin tức & Cẩm nang" {description}>
  <Breadcrumb items={[{ label: "Tin tức" }]} />

  <div class="site-container pb-16">
    <h1 class="mb-2 text-3xl font-extrabold tracking-tight uppercase md:text-section">
      Tin tức & Cẩm nang
    </h1>
    <p class="mb-6 max-w-2xl text-ink-muted">{description}</p>

    {
      tags.length > 0 && (
        <ul class="mb-8 flex flex-wrap gap-2" aria-label="Lọc theo thẻ">
          {tags.map((t) => (
            <li>
              <a
                href={tagHref(t.slug)}
                class="pill inline-flex h-8 items-center border border-line bg-surface-chip px-4 text-meta font-semibold text-ink-muted transition-colors hover:bg-surface-alt hover:text-primary"
              >
                {t.label} ({t.count})
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((p, i) => (
          <article class="group flex flex-col overflow-hidden rounded-card border border-line bg-surface">
            <a href={`/blog/${p.id}`} class="relative block bg-surface-tint">
              <SmartImage
                {assets}
                src={p.data.cover}
                alt={p.data.title}
                width={600}
                height={375}
                ratio="16x10"
                variant={i + 1}
                class="aspect-16/10 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <DateBadge date={p.data.date} />
            </a>
            <div class="flex flex-1 flex-col gap-2.5 p-5">
              {/* Ngày đã hiện ở badge trên ảnh; thẻ <time> ẩn giữ giá trị máy đọc được */}
              <time datetime={p.data.date.toISOString()} class="sr-only">
                {fmt(p.data.date)}
              </time>
              <h2 class="text-card-title leading-snug font-bold">
                <a href={`/blog/${p.id}`} class="transition-colors hover:text-primary">
                  {p.data.title}
                </a>
              </h2>
              <p class="flex-1 text-body leading-relaxed text-ink-muted">{p.data.description}</p>
              <span class="text-meta font-bold text-primary-hover">Đọc tiếp →</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Layout>
