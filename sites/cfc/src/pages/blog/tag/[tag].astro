---
export const prerender = true;

/**
 * Trang lọc bài theo thẻ — /blog/tag/<slug>
 *
 * Slug sinh từ `tagSlug()` chứ không phải tên file, vì thẻ là chuỗi khách gõ
 * tay trong Keystatic (xem `@config/blog`). Bài nào không có thẻ thì không
 * xuất hiện ở đây, nhưng vẫn nằm ở /blog.
 */
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PageHero from "@ui/patterns/PageHero.astro";
import PostCard from "@ui/primitives/PostCard.astro";
import { collectTags, postsByTag } from "@config/blog";
import { fillTemplate, parseBlogPage } from "@config/pages";
import blogData from "../../../content/pages-data/blog.json";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return collectTags(posts).map((t) => ({
    params: { tag: t.slug },
    props: { tag: t, posts: postsByTag(posts, t.slug) },
  }));
}

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const { tag, posts } = Astro.props;

const page = parseBlogPage(blogData);
const description = fillTemplate(page.tagDescriptionTemplate, {
  tag: tag.label,
  count: posts.length,
});
---

<Layout title={fillTemplate(page.tagTitleTemplate, { tag: tag.label })} {description}>
  <PageHero
    title={tag.label}
    crumbs={[{ label: page.crumbLabel, href: "/blog" }, { label: tag.label }]}
    {assets}
    image={page.heroImage}
  />

  <div class="site-container pt-10 pb-16">
    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((p, i) => (
          <PostCard
            {assets}
            as="h2"
            title={p.data.title}
            href={`/blog/${p.id}`}
            date={p.data.date}
            cover={p.data.cover}
            description={p.data.description}
            variant={i + 1}
          />
        ))
      }
    </div>

    <a
      href="/blog"
      class="mt-10 inline-flex text-meta font-bold text-primary-hover transition-colors hover:text-primary"
    >
      {page.backToAll}
    </a>
  </div>
</Layout>
