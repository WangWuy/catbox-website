---
import type { ImageMetadata } from "astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import DateBadge from "@ui/primitives/DateBadge.astro";
import { BRANDS } from "@config/brands";
import { relatedPosts, tagHref, tagSlug } from "@config/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((p) => ({
    params: { slug: p.id },
    props: { post: p, related: relatedPosts(posts, p) },
  }));
}

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const { post, related } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const b = BRANDS.cfc;

const fmt = (d: Date) =>
  d.toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" });

const fmtShort = (d: Date) =>
  d.toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" });

const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    ...(data.updated && { dateModified: data.updated.toISOString() }),
    author: { "@type": "Organization", name: data.author, url: b.site },
    publisher: { "@id": `${b.site}/#organization` },
    mainEntityOfPage: new URL(`/blog/${post.id}`, Astro.site).href,
  },
];

if (data.faq.length) {
  jsonLd.push({
    "@type": "FAQPage",
    mainEntity: data.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<Layout
  title={data.title}
  description={data.seoDescription ?? data.description}
  ogImage={data.ogImage ?? data.cover}
  ogType="article"
  {jsonLd}
>
  <Breadcrumb items={[{ label: "Tin tức", href: "/blog" }, { label: data.title }]} />

  <article class="site-container pb-16">
    <header class="mx-auto mb-8 flex max-w-3xl flex-col gap-4">
      <h1 class="text-3xl leading-tight font-extrabold tracking-tight md:text-(--text-article-title)">
        {data.title}
      </h1>
      <p class="text-lg leading-relaxed text-ink-muted">{data.description}</p>
      <div class="flex flex-wrap items-center gap-3 text-meta text-ink-faint">
        <time datetime={data.date.toISOString()}>{fmt(data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{data.author}</span>
      </div>

      {
        data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2" aria-label="Thẻ bài viết">
            {data.tags.map((t) => (
              <li>
                <a
                  href={tagHref(tagSlug(t))}
                  class="pill inline-flex h-8 items-center border border-line bg-surface-chip px-4 text-meta font-semibold text-ink-muted transition-colors hover:bg-surface-alt hover:text-primary"
                >
                  {t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      data.cover && (
        <div class="mx-auto mb-10 max-w-4xl overflow-hidden rounded-panel bg-surface-tint">
          <SmartImage
            {assets}
            src={data.cover}
            alt={data.title}
            width={1200}
            height={675}
            ratio="16x9"
            priority
            class="aspect-video w-full object-cover"
          />
        </div>
      )
    }

    <div class="prose-catbox mx-auto">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="mx-auto mt-14 max-w-4xl" aria-labelledby="related-heading">
          <h2 id="related-heading" class="mb-5 text-xl font-bold">
            Bài viết liên quan
          </h2>
          <div class="grid gap-5 sm:grid-cols-3">
            {related.map((p, i) => (
              <article class="group flex flex-col overflow-hidden rounded-card border border-line bg-surface">
                <a href={`/blog/${p.id}`} class="relative block bg-surface-tint">
                  <SmartImage
                    {assets}
                    src={p.data.cover}
                    alt={p.data.title}
                    width={400}
                    height={250}
                    ratio="16x10"
                    variant={i + 1}
                    class="aspect-16/10 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                  <DateBadge date={p.data.date} />
                </a>
                <div class="flex flex-1 flex-col gap-2 p-4">
                  {/* Ngày đã hiện ở badge trên ảnh; thẻ <time> ẩn giữ giá trị máy đọc được */}
                  <time datetime={p.data.date.toISOString()} class="sr-only">
                    {fmtShort(p.data.date)}
                  </time>
                  <h3 class="text-body leading-snug font-bold">
                    <a href={`/blog/${p.id}`} class="transition-colors hover:text-primary">
                      {p.data.title}
                    </a>
                  </h3>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <aside class="mx-auto mt-12 max-w-3xl rounded-panel bg-surface-alt p-8">
      <h2 class="font-display text-xl font-bold">Cần báo giá cho chuỗi của bạn?</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        Gửi số lượng và chất liệu mong muốn, xưởng báo giá trong 30 phút.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="pill h-11 bg-cta px-6 text-white transition-colors hover:bg-cta-hover"
        >
          Nhận báo giá
        </a>
        <a
          href={`tel:${b.hotline.replace(/\D/g, "")}`}
          data-analytics="click_hotline"
          class="pill flex h-11 items-center gap-2 border border-line px-6 text-ink transition-colors hover:bg-surface"
        >
          <Icon name="lucide:phone" class="size-4" aria-hidden="true" /> {b.hotline}
        </a>
      </div>
    </aside>
  </article>
</Layout>
