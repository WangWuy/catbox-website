---
export const prerender = true;

/**
 * Trang danh mục — lọc sẵn sản phẩm theo category, kèm nội dung MDX mô tả nhóm.
 *
 * Bố cục theo mockup trang danh mục (sidebar bộ lọc trái + lưới 3 cột + phân
 * trang): dùng chung `CatalogLayout` với `/products` để hai trang cùng là danh
 * sách sản phẩm thì trông như một, chỉ khác tập dữ liệu và widget sidebar.
 *
 * Bộ lọc ở đây chỉ dựng từ sản phẩm CỦA NHÁNH này, không phải toàn kho: đưa
 * lựa chọn "Túi có quai" vào trang mà cả nhánh không có cái nào thì bấm vào ra
 * lưới rỗng.
 */
import type { ImageMetadata } from "astro";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "@ui/patterns/PageHero.astro";
import CatalogLayout from "@ui/patterns/CatalogLayout.astro";
import ProductCard from "@ui/primitives/ProductCard.astro";
import type { FilterGroup } from "@ui/primitives/ProductFilter.astro";
import {
  categoryHref,
  categoryOrderIndex,
  categoryTitle,
  categoryTrail,
  descendantSlugs,
  normalizeSlug,
} from "@config/categories";
import { labelMap, parseCatalog } from "@config/pages";
import catalogData from "../../content/pages-data/catalog.json";

const catalog = parseCatalog(catalogData);

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  const products = await getCollection("products", ({ data }) => !data.draft);
  const live = categories.filter((c) => !c.data.draft);
  const catPos = categoryOrderIndex(categories);
  const pos = (slug: string) => catPos.get(slug) ?? Number.MAX_SAFE_INTEGER;

  return live.map((c) => {
    // Gom cả danh mục con: trang "Túi giấy thực phẩm" phải hiện luôn sản phẩm
    // gắn vào "Bao bánh mì que" nằm sâu 2 tầng bên dưới (theo sitemap).
    const branch = new Set(descendantSlugs(categories, c.id));

    return {
      params: { slug: c.id },
      props: {
        category: c,
        // Đường gốc → danh mục hiện tại, cho breadcrumb nhiều tầng.
        trail: categoryTrail(categories, c.id),
        // Danh mục con TRỰC TIẾP — widget điều hướng trong sidebar, giống cột
        // trái của mockup. Chỉ một tầng: cả nhánh sâu 3 tầng đổ ra một danh
        // sách phẳng thì không còn đọc được là con của ai.
        children: live
          .filter((k) => k.data.parent && normalizeSlug(k.data.parent) === normalizeSlug(c.id))
          .sort((a, z) => a.data.order - z.data.order)
          .map((k) => ({
            label: k.data.title,
            href: categoryHref(k.id),
            count: products.filter((p) =>
              new Set(descendantSlugs(categories, k.id)).has(p.data.category),
            ).length,
          })),
        items: products
          .filter((p) => branch.has(p.data.category))
          .sort(
            (a, z) =>
              pos(a.data.category) - pos(z.data.category) ||
              a.data.order - z.data.order ||
              a.data.title.localeCompare(z.data.title, "vi"),
          )
          .map((p) => ({ ...p, categoryLabel: categoryTitle(categories, p.data.category) })),
      },
    };
  });
}

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const { category, items, trail, children } = Astro.props;
const { data } = category;
const { Content } = await render(category);

const description = data.seoDescription ?? data.description ?? data.title;

/**
 * Tiêu đề khối điều hướng trong sidebar. Nói theo mặt hàng khách đang xem
 * ("LOẠI TÚI GIẤY") thay vì thuật ngữ cấu trúc dữ liệu ("Danh mục con") — khách
 * mua bao bì không nghĩ theo cây danh mục của CMS.
 */
const childrenHeading = `Loại ${data.navLabel ?? data.title}`;

// Từ vựng bộ lọc dùng chung với /products và trang chủ — xem `catalogSchema`.
const MATERIAL_LABEL = labelMap(catalog.materials);
const SHAPE_LABEL = labelMap(catalog.shapes);

/** Chỉ giữ lựa chọn có hàng trong nhánh này — xem chú thích đầu file. */
const optionsFor = (
  labels: Record<string, string>,
  valuesOf: (p: (typeof items)[number]) => string[],
) =>
  Object.entries(labels)
    .map(([value, label]) => ({
      value,
      label,
      count: items.filter((p) => valuesOf(p).includes(value)).length,
    }))
    .filter((o) => o.count > 0);

const groups: FilterGroup[] = [
  { key: "material", label: catalog.materialLabel, options: optionsFor(MATERIAL_LABEL, (p) => p.data.material) },
  { key: "shape", label: catalog.shapeLabel, options: optionsFor(SHAPE_LABEL, (p) => p.data.shape) },
].filter(
  (g) =>
    // Nhóm chỉ còn 1 lựa chọn thì không lọc được gì (bấm vào vẫn ra nguyên lưới).
    g.options.length > 1 &&
    // Và lựa chọn phải thực sự CHIA được tập sản phẩm: một danh mục 1 sản phẩm
    // vừa Kraft vừa MG trắng cho ra 2 lựa chọn, nhưng tick cái nào cũng hiện lại
    // đúng sản phẩm đó — sidebar khi ấy chỉ là nhiễu.
    g.options.some((o) => o.count < items.length),
);

const jsonLd = [
  {
    "@type": "CollectionPage",
    name: data.title,
    description,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: items.length,
      itemListElement: items.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.data.title,
        url: new URL(`/products/${p.id}`, Astro.site).href,
      })),
    },
  },
];
---

<Layout title={data.title} {description} {jsonLd}>
  <PageHero
    title={data.title}
    crumbs={[
      { label: "Sản phẩm", href: "/products" },
      // Tổ tiên có link, chính nó thì không (đang đứng ở đây).
      ...trail.map((c, i) => ({
        label: c.label,
        href: i < trail.length - 1 ? c.href : undefined,
      })),
    ]}
    {assets}
    image={data.image ?? catalog.categoryFallbackImage}
  />

  {/* Mô tả nhóm đặt ĐẦU trang, ngay dưới hero, trước lưới sản phẩm. */}
  <div class="site-container pt-10">
    <div class="prose-catbox max-w-none">
      {data.description && <p>{data.description}</p>}
      <Content />
    </div>
  </div>

  {
    items.length > 0 ? (
      <CatalogLayout {groups} total={items.length} columns={3}>
        {children.length > 0 && (
          <nav slot="sidebar-extra" class="mt-8" aria-label={childrenHeading}>
            <h2 class="mb-4 text-meta font-bold tracking-wide uppercase">{childrenHeading}</h2>
            <ul class="flex flex-col">
              {children.map((k) => (
                <li>
                  <a
                    href={k.href}
                    class="flex items-center justify-between gap-2 border-b border-line py-2.5 text-sm text-ink-muted transition-colors hover:text-primary"
                  >
                    <span>{k.label}</span>
                    <span class="text-(length:--text-micro) text-ink-faint">({k.count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {items.map((p, i) => (
          <ProductCard
            {assets}
            title={p.data.title}
            category={p.categoryLabel}
            href={`/products/${p.id}`}
            image={p.data.image}
            badge={p.data.badge}
            swatches={p.data.swatches}
            swatchNote={catalog.swatchNote}
            variant={i + 1}
            filterData={{
              material: p.data.material.join(","),
              shape: p.data.shape.join(","),
            }}
          />
        ))}
      </CatalogLayout>
    ) : (
      <div class="site-container pt-10 pb-16">
        <p class="rounded-panel bg-surface-alt p-8 text-center text-ink-muted">
          Nhóm sản phẩm này đang được cập nhật.{" "}
          <a href="/contact" class="font-semibold text-primary">
            Liên hệ để nhận tư vấn
          </a>
          .
        </p>
      </div>
    )
  }
</Layout>
