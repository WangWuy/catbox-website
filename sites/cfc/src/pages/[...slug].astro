---
export const prerender = true;

/**
 * Trang do khách TỰ TẠO trong CMS (mục "Trang"), ví dụ /khuyen-mai, /tuyen-dung.
 *
 * Vì sao route này an toàn dù đặt ở gốc: Astro ưu tiên route tĩnh (file thật)
 * hơn route rest-param, nên `/contact` luôn về `contact.astro`. Nhưng nếu khách
 * đặt slug trùng tên một trang có sẵn thì HAI route cùng sinh ra một đường dẫn
 * và build đổ — nên phải tự lọc, xem `RESERVED` bên dưới.
 */
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";

export async function getStaticPaths() {
  /**
   * Slug đã bị các trang có sẵn chiếm.
   *
   * Đọc thẳng từ thư mục `src/pages/` thay vì chép tay một danh sách: thêm một
   * file trang mới là danh sách này tự có thêm mục, không ai phải nhớ cập nhật.
   * `import.meta.glob` chạy lúc build nên không tốn gì ở runtime.
   */
  const RESERVED = new Set(
    Object.keys(import.meta.glob("./**/*.{astro,ts,js}"))
      // "./blog/index.astro" → "blog", "./about-us.astro" → "about-us"
      .map((f) => f.replace(/^\.\//, "").split("/")[0].replace(/\.(astro|ts|js)$/, ""))
      // Bỏ chính file này và trang chủ
      .filter((seg) => seg && !seg.startsWith("[") && seg !== "index"),
  );

  const pages = await getCollection("pages", ({ data }) => !data.draft);

  return pages
    .filter((p) => {
      if (!RESERVED.has(p.id)) return true;
      // Không ném lỗi: một trang đặt nhầm tên không đáng làm hỏng cả lần deploy.
      console.warn(
        `[pages] Bỏ qua trang "${p.id}" — đường dẫn /${p.id} đã thuộc về một trang có sẵn. Đổi tên trang trong CMS để nó lên site.`,
      );
      return false;
    })
    .map((p) => ({ params: { slug: p.id }, props: { page: p } }));
}

const { page } = Astro.props;
const { data } = page;
const { Content } = await render(page);

const fmt = (d: Date) =>
  d.toLocaleDateString("vi-VN", { day: "2-digit", month: "long", year: "numeric" });
---

<Layout
  title={data.title}
  description={data.seoDescription ?? data.description ?? data.title}
  noindex={data.noindex}
>
  <Breadcrumb items={[{ label: data.title }]} />

  <article class="site-container pb-16">
    <header class="mx-auto mb-8 flex max-w-3xl flex-col gap-2">
      <h1 class="text-(length:--text-policy-title-mobile) font-extrabold tracking-tight md:text-(length:--text-policy-title)">
        {data.title}
      </h1>
      {data.description && <p class="leading-relaxed text-ink-muted">{data.description}</p>}
      {data.updated && <p class="text-tiny text-ink-faint">Cập nhật {fmt(data.updated)}</p>}
    </header>
    <div class="prose-catbox mx-auto">
      <Content />
    </div>
  </article>
</Layout>
