---
export const prerender = true;

/**
 * Trang Liên hệ — dựng theo bố cục:
 *
 *   1. PageHero (banner nâu kraft + tiêu đề + breadcrumb) — dùng chung với
 *      /blog và /about-us để 3 trang trong cùng một dáng đầu trang
 *   2. Hàng 2 thẻ địa điểm (Nhà máy | Văn phòng): ảnh vuông + khối chữ bên cạnh
 *   3. Hàng 2 cột: form gửi yêu cầu | bản đồ Google Maps
 *   4. Khối nội dung công ty gập lại, mở bằng nút "Xem thêm"
 */
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { parseContact } from "@config/pages";
import Layout from "../layouts/Layout.astro";
import contactData from "../content/pages-data/contact.json";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import SmartImage from "@ui/primitives/SmartImage.astro";
import TrustPanel from "@ui/shared/TrustPanel.astro";
import { BRANDS } from "@config/brands";
import { formatAddress, formatHours } from "@config/settings";

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const b = BRANDS.cfc;
const page = parseContact(contactData);

const tel = (phone: string) => `tel:${phone.replace(/[^0-9+]/g, "")}`;

/**
 * Hai địa điểm, mỗi nơi có giờ làm việc + đầu mối liên hệ riêng — theo mockup
 * TD tách "Nhà Máy" và "VPĐD" thành 2 thẻ thay vì gộp một danh sách.
 *
 * Địa chỉ / giờ / ảnh lấy từ "Cài đặt" (`b.locations`), KHÔNG khai lại ở đây —
 * cùng bộ dữ liệu mà Footer và JSON-LD đang dùng, nên ba nơi không thể nói
 * khác nhau nữa (trước đây địa chỉ chép tay ở cả ba).
 *
 * Quy ước đầu mối liên hệ: cơ sở ĐẦU TIÊN là nơi nhận cuộc gọi chung nên hiện
 * hotline; các cơ sở sau hiện nhân viên sale, phân theo tệp khách như mockup TD
 * ("Khách lẻ ... / Khách sỉ ..."). Nhãn của cả hai nằm trong CMS.
 */
const places = b.locations.map((l, i) => ({
  title: l.label,
  image: l.image,
  address: formatAddress(l),
  hours: { days: l.hours?.days, time: formatHours(l) },
  email: b.email,
  lines:
    i === 0
      ? [{ label: page.places?.hotlineLabel ?? "Hotline", value: b.hotline, href: b.hotlineHref }]
      : b.salesReps.slice(0, page.places?.salesLabels.length ?? 0).map((r, j) => ({
          label: page.places?.salesLabels[j] ?? "Sale",
          value: `${r.phone} (${r.name})`,
          href: tel(r.phone),
        })),
}));

const description = page.seo.description;

const jsonLd = [
  {
    "@type": "LocalBusiness",
    name: b.name,
    "@id": `${b.site}/#localbusiness`,
    url: b.site,
    telephone: b.hotline,
    email: b.email,
    priceRange: page.business.priceRange,
    // Cùng cơ sở đầu tiên mà thẻ địa điểm phía trên đang hiển thị.
    ...(b.locations[0] && {
      address: {
        "@type": "PostalAddress",
        streetAddress: b.locations[0].streetAddress,
        addressLocality: b.locations[0].locality,
        addressCountry: b.locations[0].country,
      },
      openingHoursSpecification: {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: page.business.openingDays,
        opens: b.locations[0].hours?.opens,
        closes: b.locations[0].hours?.closes,
      },
    }),
  },
];

function extractIframeSrc(input?: string): string | undefined {
  if (!input) return undefined;
  const trimmed = input.trim();
  const match = trimmed.match(/src=["']([^"']+)["']/i);
  return match ? match[1] : trimmed;
}

const defaultMapUrl =
  "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d17829.05192815368!2d105.80006!3d20.996869!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3135ad2298500cbd%3A0x82b22a45c6855808!2zMlRwcmludCAtIEPDtG5nIHR5IFROSEggxJDhuqd1IFTGsCBWw6AgVGjGsMahbmcgTeG6oWkgMlQ!5e1!3m2!1svi!2sus!4v1773502804489!5m2!1svi!2sus";
const mapUrl = extractIframeSrc(page.map?.iframeUrl) || defaultMapUrl;
---

<Layout title={page.seo.title} {description} {jsonLd}>
  <Breadcrumb items={[{ label: page.seo.title }]} />

  {/* --- Khối năng lực & cam kết (TrustPanel) hoặc 2 thẻ địa điểm --------- */}
  {
    page.trust ? (
      <div class="mt-6 sm:mt-10">
        <TrustPanel
          brand="cfc"
          {assets}
          image={page.trust.image}
          imageAlt={page.trust.imageAlt}
          eyebrow={page.trust.eyebrow}
          heading={page.trust.title}
          headingColor={page.trust.titleColor}
          body={page.trust.body}
          stats={page.trust.stats}
          cta={page.trust.cta}
        />
      </div>
    ) : (
      <section class="site-container mt-16 grid gap-8 sm:grid-cols-2 sm:gap-10">
        {places.map((p) => (
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
            <div class="size-(--size-contact-place-image-sm) flex-none overflow-hidden rounded-full bg-surface-tint sm:size-(--size-contact-place-image)">
              <SmartImage
                {assets}
                src={p.image}
                alt={`${b.name} — ${p.title}`}
                width={580}
                height={580}
                ratio="1x1"
                class="aspect-square size-full object-cover"
              />
            </div>

            <div class="flex flex-col gap-3">
              <h2 class="text-(length:--text-contact-place-title) leading-snug font-extrabold">
                {p.title}
              </h2>

              <p class="text-body leading-relaxed text-ink-muted">{p.address}</p>

              <p class="text-body leading-relaxed text-ink-muted">
                <strong class="font-bold text-ink">{p.hours.days}</strong>
                <br />
                {p.hours.time}
              </p>

              <p class="flex flex-col gap-1 text-body leading-relaxed text-ink-muted">
                <a
                  href={`mailto:${p.email}`}
                  class="font-bold text-ink transition-colors hover:text-primary"
                >
                  {p.email}
                </a>
                {p.lines.map((l) => (
                  <a
                    href={l.href}
                    data-analytics="click_hotline"
                    class="transition-colors hover:text-primary"
                  >
                    {l.label} {l.value}
                  </a>
                ))}
              </p>
            </div>
          </div>
        ))}
      </section>
    )
  }

  {/* --- Hàng liên hệ & Bản đồ (Format theo mockup 2TPrint) ------------ */}
  <section id="contact-form" class="site-container mt-14 scroll-mt-10">
    <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-2 lg:gap-12">
      {/* Cột trái: Form gửi yêu cầu */}
      <div class="flex flex-col justify-center">
        <h2 class="text-center text-2xl font-bold tracking-tight text-ink sm:text-[26px]">
          {page.form.title}
        </h2>

        {/* Form 3 trường theo format mockup: Họ tên, Email, Nội dung */}
        <form
          method="post"
          action="/api/quote"
          data-contact-form
          class="mt-6 flex flex-col gap-4"
        >
          <input type="hidden" name="brand" value="cfc" />
          <input type="hidden" name="kind" value="contact" />
          {/* Bẫy bot: người thật không bao giờ điền */}
          <input
            type="text"
            name="company_website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="absolute -left-(--offset-offscreen) size-px"
          />

          <label class="sr-only" for="contact-name">Họ tên</label>
          <input
            id="contact-name"
            type="text"
            name="name"
            placeholder="Họ tên"
            required
            autocomplete="name"
            class="h-12 w-full border border-line bg-surface-alt px-4 text-nav text-ink outline-none transition-all placeholder:text-ink-muted/70 focus-visible:border-primary focus-visible:bg-surface focus-visible:ring-1 focus-visible:ring-primary"
          />

          <label class="sr-only" for="contact-email">Email</label>
          <input
            id="contact-email"
            type="email"
            name="email"
            placeholder="Email"
            required
            autocomplete="email"
            class="h-12 w-full border border-line bg-surface-alt px-4 text-nav text-ink outline-none transition-all placeholder:text-ink-muted/70 focus-visible:border-primary focus-visible:bg-surface focus-visible:ring-1 focus-visible:ring-primary"
          />

          <label class="sr-only" for="contact-message">Nội dung</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            placeholder="Nội dung"
            required
            class="w-full resize-y border border-line bg-surface-alt p-4 text-nav text-ink outline-none transition-all placeholder:text-ink-muted/70 focus-visible:border-primary focus-visible:bg-surface focus-visible:ring-1 focus-visible:ring-primary"
          ></textarea>

          <div class="mt-2 flex flex-col items-center gap-3">
            <button
              type="submit"
              data-analytics="submit_quote"
              class="flex h-11 min-w-[140px] items-center justify-center rounded-full bg-cta px-8 text-body font-bold text-white shadow-sm transition-all hover:bg-cta-hover hover:shadow-md disabled:opacity-60"
            >
              GỬI
            </button>
            <p data-form-msg role="status" class="text-center text-sm text-ink-muted"></p>
          </div>
        </form>
      </div>

      {/* Cột phải: Google Maps iframe */}
      <div class="h-full min-h-[380px] w-full overflow-hidden border border-line shadow-sm sm:min-h-[440px] lg:min-h-[480px]">
        <iframe
          src={mapUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Bản đồ vị trí"
          class="size-full min-h-[380px] sm:min-h-[440px] lg:min-h-[480px]"
        ></iframe>
      </div>
    </div>
  </section>

  {/* --- Nội dung công ty, gập lại sau nút "Xem thêm" --------------------- */}
  <section class="site-container mt-14 pb-16">
    <div data-collapsible class="flex flex-col gap-4">
      {/* Khối bị cắt chiều cao khi đang gập; mở ra thì bỏ giới hạn. Dải mờ ở
          mép dưới chỉ hiện lúc đang gập, để lộ ra là còn nội dung bên dưới. */}
      <div
        data-collapsible-body
        class="relative max-h-(--height-contact-collapsed) overflow-hidden"
      >
        <div class="flex flex-col gap-6">
          {
            page.company.blocks.map((c) => (
              <div class="flex flex-col gap-2">
                <h3 class="text-card-title font-bold">{c.title}</h3>
                {c.body.map((p) => (
                  <p class="text-meta leading-relaxed text-ink-muted">{p}</p>
                ))}
              </div>
            ))
          }
        </div>

        <span
          data-collapsible-fade
          class="pointer-events-none absolute inset-x-0 bottom-0 h-(--height-contact-fade) bg-gradient-to-b from-transparent to-surface"
          aria-hidden="true"></span>
      </div>

      <button
        type="button"
        data-collapsible-toggle
        aria-expanded="false"
        class="flex w-fit cursor-pointer items-center gap-2 text-label font-semibold text-primary transition-colors hover:text-primary-hover"
      >
        <span data-collapsible-label>Xem thêm</span>
        <Icon
          name="lucide:chevron-down"
          class="chev size-(--size-icon-inline) transition-transform"
          aria-hidden="true"
        />
      </button>
    </div>
  </section>
</Layout>

<script>
  // Gửi form không reload trang; tắt JS thì form vẫn POST bình thường.
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const msg = form.querySelector<HTMLElement>("[data-form-msg]");
    form.addEventListener("submit", async (e) => {
      if (!form.checkValidity()) return; // để trình duyệt hiện lỗi gốc
      e.preventDefault();
      const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
      btn.disabled = true;
      if (msg) msg.textContent = "Đang gửi…";
      try {
        const body = new FormData(form);
        body.set("page", location.pathname);
        const res = await fetch(form.action, {
          method: "POST",
          body,
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        if (msg) msg.textContent = "Đã nhận yêu cầu. Xưởng sẽ liên hệ trong 30 phút.";
        form.reset();
      } catch {
        if (msg) msg.textContent = "Gửi chưa được — bạn gọi hotline giúp mình nhé.";
      } finally {
        btn.disabled = false;
      }
    });
  });

  // Khối nội dung công ty gập/mở.
  document.querySelectorAll<HTMLElement>("[data-collapsible]").forEach((root) => {
    const body = root.querySelector<HTMLElement>("[data-collapsible-body]");
    const fade = root.querySelector<HTMLElement>("[data-collapsible-fade]");
    const btn = root.querySelector<HTMLButtonElement>("[data-collapsible-toggle]");
    const label = root.querySelector<HTMLElement>("[data-collapsible-label]");
    const chev = btn?.querySelector<HTMLElement>(".chev");
    if (!body || !btn) return;

    // Nội dung ngắn hơn mức cắt thì không cần nút — bỏ luôn cả nút lẫn dải mờ.
    if (body.scrollHeight <= body.clientHeight + 1) {
      btn.hidden = true;
      if (fade) fade.hidden = true;
      body.style.maxHeight = "none";
      return;
    }

    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!open));
      body.style.maxHeight = open ? "" : "none";
      if (fade) fade.hidden = !open;
      if (label) label.textContent = open ? "Xem thêm" : "Thu gọn";
      if (chev) chev.style.transform = open ? "" : "rotate(180deg)";
    });
  });
</script>
