---
/**
 * Bảng giá sỉ — trang riêng của CFC (§7 Pha 2, ngày 10).
 *
 * Giá hiển thị công khai theo bậc số lượng. Đây cũng là mồi GEO mạnh (§6B.3–4):
 * bảng có cấu trúc + đơn vị rõ ràng là dạng AI ưu tiên trích dẫn.
 *
 * ⚠️ Số liệu dưới đây là giá tham khảo dựng theo mockup — cần khách xác nhận
 * trước khi lên production (TECH_STACK_v2 §13.7).
 */
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import { BRANDS } from "@config/brands";

const b = BRANDS.cfc;
const products = (await getCollection("products", ({ data }) => !data.draft)).sort(
  (a, z) => a.data.order - z.data.order,
);

/** Bậc số lượng — càng nhiều càng rẻ, đúng logic xưởng chia chi phí set-up máy */
const TIERS = [
  { label: "2.000 – 5.000", factor: 1 },
  { label: "5.000 – 20.000", factor: 0.88 },
  { label: "20.000 – 50.000", factor: 0.78 },
  { label: "Trên 50.000", factor: 0.7 },
];

const vnd = (n: number) => new Intl.NumberFormat("vi-VN").format(Math.round(n)) + "đ";

const faq = [
  {
    q: "Giá trên bảng đã gồm phí in chưa?",
    a: "Đã gồm in flexo 1–2 màu. In 3–4 màu cộng thêm khoảng 8–15% tuỳ diện tích phủ mực.",
  },
  {
    q: "Số lượng tối thiểu là bao nhiêu?",
    a: "2.000 túi cho đơn in theo yêu cầu. Dưới mức đó có thể mua mẫu có sẵn không in, giao trong 48h.",
  },
  {
    q: "Có hỗ trợ đơn định kỳ hàng tháng không?",
    a: "Có. Đơn tháng hoặc quý được tính theo tổng số lượng cả kỳ, nên giá tốt hơn đặt lẻ từng lần.",
  },
  {
    q: "Thanh toán thế nào?",
    a: "Khu vực Hà Nội và Hà Nam thanh toán khi nhận hàng. Ngoài khu vực thanh toán trước khi giao.",
  },
];

const description =
  "Bảng giá sỉ túi giấy, giấy gói và hộp thực phẩm CFC theo bậc số lượng. Giá tận xưởng, không qua trung gian, MOQ từ 2.000 túi.";

const jsonLd = [
  {
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Layout title="Bảng giá sỉ" {description} {jsonLd}>
  <Breadcrumb items={[{ label: "Bảng giá sỉ" }]} />

  <div class="site-container flex flex-col gap-12 pb-16">
    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-extrabold tracking-tight uppercase md:text-section">Bảng giá sỉ</h1>
      <p class="max-w-2xl leading-relaxed text-ink-muted">
        Giá tận xưởng theo bậc số lượng, đã gồm in flexo 1–2 màu. Đặt càng nhiều đơn giá càng giảm
        vì chi phí set-up máy được chia trên số lượng lớn hơn.
      </p>
    </header>

    <div class="overflow-x-auto rounded-panel border border-line">
      <table class="w-full min-w-[720px] text-sm">
        <caption class="sr-only">Bảng giá sỉ theo số lượng đặt</caption>
        <thead>
          <tr class="bg-surface-alt">
            <th scope="col" class="px-5 py-4 text-left font-bold">Sản phẩm</th>
            {
              TIERS.map((t) => (
                <th scope="col" class="px-5 py-4 text-right font-bold whitespace-nowrap">
                  {t.label}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            products.map((p) => (
              <tr class="border-t border-line">
                <th scope="row" class="px-5 py-4 text-left font-semibold">
                  <a href={`/products/${p.id}`} class="transition-colors hover:text-primary">
                    {p.data.title}
                  </a>
                  <span class="block text-[12px] font-normal text-ink-faint">{p.data.category}</span>
                </th>
                {TIERS.map((t, i) => (
                  <td
                    class={`px-5 py-4 text-right whitespace-nowrap tabular-nums ${
                      i === 0 ? "text-ink-muted" : "font-bold text-cta"
                    }`}
                  >
                    {p.data.priceFrom ? `${vnd(p.data.priceFrom * t.factor)}/${p.data.unit}` : "Liên hệ"}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="text-[13px] text-ink-faint">
      Giá tham khảo, chưa gồm VAT. Giá cuối phụ thuộc kích thước, định lượng giấy và số màu in — gửi
      yêu cầu để nhận báo giá chính xác trong 30 phút.
    </p>

    <div class="flex flex-wrap gap-3">
      <a
        href="/contact"
        data-analytics="submit_quote_intent"
        class="pill h-12 bg-cta px-7 text-white transition-colors hover:bg-cta-hover"
      >
        Nhận báo giá chính xác
      </a>
      <a
        href={`tel:${b.hotline.replace(/\D/g, "")}`}
        data-analytics="click_hotline"
        class="pill flex h-12 items-center gap-2 border border-line px-7 text-ink transition-colors hover:bg-surface-alt"
      >
        <Icon name="lucide:phone" class="size-4" aria-hidden="true" /> {b.hotline}
      </a>
    </div>

    <section class="flex flex-col gap-4">
      <h2 class="text-2xl font-extrabold tracking-tight uppercase">Câu hỏi thường gặp</h2>
      {
        faq.map((f) => (
          <details class="rounded-panel border border-line bg-surface p-5">
            <summary class="cursor-pointer list-none font-semibold">{f.q}</summary>
            <p class="mt-3 leading-relaxed text-ink-muted">{f.a}</p>
          </details>
        ))
      }
    </section>
  </div>
</Layout>
