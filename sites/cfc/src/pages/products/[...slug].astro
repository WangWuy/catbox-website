---
/**
 * Trang chi tiết sản phẩm — chứng minh pipeline content chạy đủ:
 * MDX → Zod → route động → JSON-LD Product + FAQPage → Breadcrumb.
 *
 * Bảng thông số ở đây vừa phục vụ người mua vừa là mồi GEO (§6B.3): AI ưu tiên
 * trích dẫn dữ liệu dạng bảng có đơn vị rõ ràng.
 */
import type { ImageMetadata } from "astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";
import ProductCarousel from "@ui/patterns/ProductCarousel.astro";
import { BRANDS } from "@config/brands";
import { categoryTitle, categoryTrail } from "@config/categories";

export async function getStaticPaths() {
  const products = await getCollection("products", ({ data }) => !data.draft);
  const categories = await getCollection("categories");
  return products.map((p) => ({
    params: { slug: p.id },
    // Cả đường danh mục gốc → lá, để breadcrumb phản ánh đúng cây 3 tầng của
    // sitemap thay vì chỉ một cấp như trước.
    props: { product: p, trail: categoryTrail(categories, p.data.category) },
  }));
}

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const { product, trail } = Astro.props;
const { data } = product;
/** Danh mục trực tiếp của sản phẩm (lá cuối đường) — dùng làm nhãn hiển thị. */
const leaf = trail.at(-1);
const { Content } = await render(product);
const b = BRANDS.cfc;

const image = data.image ?? "/placeholders/1x1-1.svg";
/** Ảnh chính luôn là ảnh đầu gallery — tránh trùng lặp khi khách đã điền cả hai. */
const galleryImages = [image, ...data.gallery.filter((g) => g !== image)];

const categories = await getCollection("categories");
const allProducts = await getCollection("products", ({ data: d }) => !d.draft);
const relatedProducts = allProducts
  .filter((p) => p.id !== product.id && p.data.category === data.category)
  .sort((a, z) => a.data.order - z.data.order)
  .slice(0, 4);

const jsonLd: Record<string, unknown>[] = [
  {
    "@type": "Product",
    name: data.title,
    description: data.excerpt ?? data.seoDescription,
    image: new URL(image, Astro.site).href,
    category: leaf?.label ?? data.category,
    brand: { "@type": "Brand", name: b.name },
  },
];

if (data.faq.length) {
  jsonLd.push({
    "@type": "FAQPage",
    mainEntity: data.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<Layout
  title={data.title}
  description={data.seoDescription ?? data.excerpt ?? data.title}
  ogImage={data.ogImage ?? image}
  ogType="product"
  {jsonLd}
>
  <Breadcrumb
    items={[
      { label: "Sản phẩm", href: "/products" },
      ...trail.map((c) => ({ label: c.label, href: c.href })),
      { label: data.title },
    ]}
  />

  <article class="site-container grid gap-12 pb-16 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      <div class="relative overflow-hidden rounded-panel bg-surface-tint">
        <img
          src={image}
          alt={data.title}
          width="1200"
          height="1200"
          class="aspect-square w-full object-cover"
          data-product-image
        />
        {
          data.badge && (
            <span class="pill absolute bottom-4 left-4 bg-kraft px-3.5 py-2 text-[11px] text-white">
              {data.badge}
            </span>
          )
        }
      </div>

      {
        galleryImages.length > 1 && (
          <div class="flex flex-wrap gap-3" data-gallery>
            {galleryImages.map((g, i) => (
              <button
                type="button"
                data-gallery-thumb
                data-image={g}
                aria-pressed={i === 0}
                class="size-(--size-thumb-gallery) shrink-0 overflow-hidden rounded-panel border border-line outline-offset-2 aria-pressed:outline-2 aria-pressed:outline-ink"
              >
                <img src={g} alt="" width="72" height="72" class="size-full object-cover" />
              </button>
            ))}
          </div>
        )
      }

      {
        data.swatches.length > 0 && (
          <div class="flex items-center gap-3" data-swatches>
            <span class="text-[13px] font-semibold text-ink-muted">Chất liệu:</span>
            {data.swatches.map((s, i) => (
              <button
                type="button"
                data-swatch
                data-image={s.image ?? image}
                data-label={s.label}
                aria-pressed={i === 0}
                class="size-7 rounded-sm border border-line outline-offset-2 aria-pressed:outline-2 aria-pressed:outline-ink"
                style={`background:${s.color}`}
              >
                <span class="sr-only">{s.label}</span>
              </button>
            ))}
            <span data-swatch-label class="text-[13px] text-ink-faint">
              {data.swatches[0]?.label}
            </span>
          </div>
        )
      }
    </div>

    <div class="flex flex-col gap-5">
      <p class="text-meta font-semibold tracking-wide text-ink-faint uppercase">
        {
          leaf ? (
            <a href={leaf.href} class="transition-colors hover:text-primary">
              {leaf.label}
            </a>
          ) : (
            data.category
          )
        }
      </p>
      <h1 class="text-(length:--text-product-title-mobile) leading-tight font-extrabold tracking-tight md:text-(length:--text-product-title)">{data.title}</h1>
      {data.sku && <p class="text-meta text-ink-faint">Mã sản phẩm: {data.sku}</p>}
      {data.excerpt && <p class="text-[15px] leading-relaxed text-ink-muted">{data.excerpt}</p>}

      {data.moq && <p class="text-sm text-ink-faint">MOQ {data.moq}</p>}

      <div class="flex flex-wrap gap-3">
        <a
          href="/contact"
          data-analytics="submit_quote_intent"
          class="pill h-12 bg-primary px-7 text-white transition-colors hover:bg-primary-hover"
        >
          Nhận báo giá ngay
        </a>
        <a
          href={`tel:${b.hotline.replace(/\D/g, "")}`}
          data-analytics="click_hotline"
          class="pill flex h-12 items-center gap-2 border border-line px-7 text-ink transition-colors hover:bg-surface-alt"
        >
          <Icon name="lucide:phone" class="size-4" aria-hidden="true" /> {b.hotline}
        </a>
      </div>

      {
        data.specs.length > 0 && (
          <div class="overflow-hidden rounded-panel border border-line">
            <h2 class="border-b border-line bg-surface-alt px-5 py-3 text-[13px] font-bold tracking-wide uppercase">
              Thông số kỹ thuật
            </h2>
            <table class="w-full text-sm">
              <tbody>
                {data.specs.map((s) => (
                  <tr class="border-b border-line last:border-0">
                    <th scope="row" class="w-2/5 px-5 py-3 text-left font-semibold text-ink-muted">
                      {s.label}
                    </th>
                    <td class="px-5 py-3">{s.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>

  </article>

  <div class="site-container flex flex-col gap-12 pb-16">
    <div>
      <h2 class="mb-5 text-(length:--text-section-mobile) font-extrabold tracking-tight uppercase md:text-section">Mô tả sản phẩm</h2>
      <div class="prose-catbox">
        <Content />
      </div>
    </div>

    {
      data.faq.length > 0 && (
        <section>
          <h2 class="mb-5 text-(length:--text-section-mobile) font-extrabold tracking-tight uppercase md:text-section">Câu hỏi thường gặp</h2>
          <div class="flex flex-col gap-3">
            {data.faq.map((f) => (
              <details class="rounded-panel border border-line bg-surface p-5">
                <summary class="cursor-pointer list-none font-semibold">{f.q}</summary>
                <p class="mt-3 leading-relaxed text-ink-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <ProductCarousel
      assets={assets}
      title="Sản phẩm liên quan"
      products={relatedProducts.map((p) => ({
        title: p.data.title,
        category: categoryTitle(categories, p.data.category),
        href: `/products/${p.id}`,
        image: p.data.image,
        badge: p.data.badge,
        swatches: p.data.swatches,
      }))}
    />
  </div>
</Layout>

<script>
  // Island #4 — Swatches: đổi ảnh + nhãn. Vanilla, ~1 KB.
  const group = document.querySelector<HTMLElement>("[data-swatches]");
  if (group) {
    const img = document.querySelector<HTMLImageElement>("[data-product-image]");
    const label = group.querySelector<HTMLElement>("[data-swatch-label]");
    group.querySelectorAll<HTMLButtonElement>("[data-swatch]").forEach((btn) => {
      btn.addEventListener("click", () => {
        group
          .querySelectorAll("[data-swatch]")
          .forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        if (img && btn.dataset.image) img.src = btn.dataset.image;
        if (label && btn.dataset.label) label.textContent = btn.dataset.label;
      });
    });
  }

  // Island #5 — Gallery: click thumbnail đổi ảnh chính.
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  if (gallery) {
    const img = document.querySelector<HTMLImageElement>("[data-product-image]");
    gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]").forEach((btn) => {
      btn.addEventListener("click", () => {
        gallery
          .querySelectorAll("[data-gallery-thumb]")
          .forEach((b) => b.setAttribute("aria-pressed", "false"));
        btn.setAttribute("aria-pressed", "true");
        if (img && btn.dataset.image) img.src = btn.dataset.image;
      });
    });
  }
</script>
