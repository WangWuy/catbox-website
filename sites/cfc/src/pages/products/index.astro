---
export const prerender = true;

/**
 * Danh mục sản phẩm — lưới đầy đủ + bộ lọc island (chất liệu / kiểu dáng / giá).
 *
 * Toàn bộ sản phẩm nằm trong HTML ngay từ đầu; filter chỉ ẩn/hiện. Xem chú
 * thích trong packages/ui/catalog/ProductFilter.astro.
 */
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { categoryTitle } from "@config/categories";
import { labelMap, parseCatalog } from "@config/pages";
import Layout from "../../layouts/Layout.astro";
import catalogData from "../../content/pages-data/catalog.json";
import PageHero from "@ui/patterns/PageHero.astro";
import CatalogLayout from "@ui/patterns/CatalogLayout.astro";
import ProductCard from "@ui/primitives/ProductCard.astro";
import { type FilterGroup } from "@ui/primitives/ProductFilter.astro";

const catalog = parseCatalog(catalogData);

const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const products = (await getCollection("products", ({ data }) => !data.draft)).sort(
  (a, z) => a.data.order - z.data.order,
);

// `product.category` lưu slug (relationship) → đổi sang tên hiển thị.
const categories = await getCollection("categories");
const label = (slug: string) => categoryTitle(categories, slug);

// Từ vựng bộ lọc dùng chung với /danh-muc và trang chủ — xem `catalogSchema`.
const MATERIAL_LABEL = labelMap(catalog.materials);
const SHAPE_LABEL = labelMap(catalog.shapes);

/** Đếm số sản phẩm cho từng lựa chọn — người dùng biết trước lọc ra bao nhiêu */
const countBy = (field: "material" | "shape", value: string) =>
  products.filter((p) => p.data[field].includes(value)).length;

const groups: FilterGroup[] = [
  {
    key: "material",
    label: catalog.materialLabel,
    options: Object.entries(MATERIAL_LABEL).map(([value, label]) => ({
      value,
      label,
      count: countBy("material", value),
    })),
  },
  {
    key: "shape",
    label: catalog.shapeLabel,
    options: Object.entries(SHAPE_LABEL)
      .map(([value, label]) => ({ value, label, count: countBy("shape", value) }))
      .filter((o) => o.count > 0),
  },
];

const description = catalog.seo.description;

const jsonLd = [
  {
    "@type": "CollectionPage",
    name: catalog.collectionName,
    description,
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.data.title,
        url: new URL(`/products/${p.id}`, Astro.site).href,
      })),
    },
  },
];
---

<Layout title={catalog.seo.title} {description} {jsonLd}>
  <PageHero
    title={catalog.heroTitle}
    crumbs={[{ label: catalog.heroTitle }]}
    {assets}
    image={catalog.heroImage}
  />

  <CatalogLayout {groups} total={products.length} columns={3}>
    {
      products.map((p, i) => (
        <ProductCard
          {assets}
          title={p.data.title}
          category={label(p.data.category)}
          href={`/products/${p.id}`}
          image={p.data.image}
          badge={p.data.badge}
          swatches={p.data.swatches}
          swatchNote={catalog.swatchNote}
          variant={i + 1}
          filterData={{
            material: p.data.material.join(","),
            shape: p.data.shape.join(","),
          }}
        />
      ))
    }
  </CatalogLayout>
</Layout>
