---
export const prerender = true;

import { parseNotFound } from "@config/pages";
import Layout from "../layouts/Layout.astro";
import notFoundData from "../content/pages-data/404.json";

const page = parseNotFound(notFoundData);

/* Nút đầu là hành động chính (nền màu), các nút sau là phụ (viền) — quy ước
   này nằm ở đây chứ không thành field, vì nó là cách trang phân cấp nút chứ
   không phải nội dung khách cần sửa. */
const PRIMARY = "pill h-11 bg-primary px-6 text-white transition-colors hover:bg-primary-hover";
const SECONDARY =
  "pill h-11 border border-line px-6 text-ink transition-colors hover:bg-surface-alt";
---

<Layout title={page.seo.title} description={page.seo.description} noindex>
  <section class="site-container flex min-h-[50vh] flex-col items-center justify-center gap-4 py-20 text-center">
    <p class="text-(length:--text-hero-mobile) font-extrabold text-primary md:text-hero">
      {page.code}
    </p>
    <h1 class="text-2xl font-bold">{page.title}</h1>
    <p class="max-w-md text-ink-muted">
      {page.body}
    </p>
    <div class="mt-2 flex flex-wrap justify-center gap-3">
      {
        page.actions.map((a, i) => (
          <a href={a.href} class={i === 0 ? PRIMARY : SECONDARY}>
            {a.label}
          </a>
        ))
      }
    </div>
  </section>
</Layout>
