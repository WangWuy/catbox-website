---
/**
 * Trang chủ CFC — theo sitemap chính thức.
 *
 * Thứ tự khối: Header → Hero (banner + stats nhỏ) → Bán chạy/Sản phẩm các
 * loại (tabs) → Tin tức/Blog → Video mẫu túi in → Footer.
 */
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { categoryTitle } from "@config/categories";
import Layout from "../layouts/Layout.astro";

import HeroBanner from "@ui/patterns/HeroBanner.astro";
import BestsellerGrid from "@ui/patterns/BestsellerGrid.astro";
import NewsGrid from "@ui/patterns/NewsGrid.astro";
import FactoryReels from "@ui/patterns/FactoryReels.astro";

// Bản đồ ảnh cho SmartImage — glob phải nằm ở site vì đường dẫn tương đối
// với chính project này (xem packages/ui/lib/images.ts).
const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const products = (await getCollection("products", ({ data }) => !data.draft)).sort(
  (a, z) => a.data.order - z.data.order,
);

// `product.category` lưu slug (relationship) — đổi sang tên hiển thị để nhãn
// tab và nhãn trên thẻ sản phẩm luôn khớp tên khách đặt trong CMS.
const categories = await getCollection("categories");
const label = (slug: string) => categoryTitle(categories, slug);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, z) => z.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const toCard = (p: (typeof products)[number]) => ({
  title: p.data.title,
  category: label(p.data.category),
  href: `/products/${p.id}`,
  image: p.data.image,
  badge: p.data.badge,
  swatches: p.data.swatches,
  swatchNote: "Kraft / MG",
});

const bestsellers = products.filter((p) => p.data.bestseller).map(toCard);
const tabs = [...new Set(products.map((p) => label(p.data.category)))];

const description =
  "Xưởng sản xuất túi giấy, giấy gói và hộp đựng thực phẩm cho chuỗi bánh mì và quán F&B. In theo yêu cầu từ 2.000 túi, giao toàn quốc, đạt chuẩn ATVSTP và HACCP.";
---

<Layout title="Trang chủ" {description}>
  <div class="flex flex-col gap-(--space-section-gap) pb-(--space-section-gap) md:gap-(--space-section-gap-lg) md:pb-(--space-section-gap-lg)">
    <HeroBanner
      {assets}
      image="brand/hero-banner.png"
      eyebrow="Xưởng sản xuất trực tiếp"
      title="Bao bì giấy F&B tận xưởng cùng"
      titleAccent="CFC"
      subtitle="Túi giấy, giấy gói và hộp đựng thực phẩm in theo yêu cầu. Không qua trung gian, báo giá trong 30 phút."
      hashtag="ưu đãi cho chuỗi"
      stats={[
        { icon: "lucide:package", num: "4.400.000", label: "Chiếc/năm" },
        { icon: "lucide:folder-open", num: "88.000.000", label: "Chiếc/năm" },
        { icon: "lucide:shopping-bag", num: "990.000", label: "Chiếc/năm" },
        { icon: "lucide:gift", num: "6.600.000", label: "Chiếc/năm" },
        { icon: "lucide:droplet", num: "33.000", label: "Cuộn/năm" },
      ]}
    />

    <BestsellerGrid
      {assets}
      {tabs}
      title="Bán chạy"
      items={bestsellers}
    />

    <NewsGrid
      {assets}
      title="Tin Tức"
      action={{ label: "Xem thêm tin →", href: "/blog" }}
      items={posts.map((p) => ({
        title: p.data.title,
        href: `/blog/${p.id}`,
        date: p.data.date,
        cover: p.data.cover,
        description: p.data.description,
      }))}
    />

  </div>

  <!-- Nằm NGOÀI wrapper `gap-(--space-section-gap) pb-(--space-section-gap)`:
       khối video không lấy khoảng cách chung của trang, dán thẳng vào Footer. -->
  <FactoryReels
    {assets}
    label="Mẫu túi bánh mì que in 4 màu theo yêu cầu"
    video="/video/tui-banh-mi-in-mau.mp4"
    poster="/video/tui-banh-mi-in-mau-poster.jpg"
  />
</Layout>
