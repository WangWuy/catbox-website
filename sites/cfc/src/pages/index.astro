---
export const prerender = true;

/**
 * Trang chủ CFC — theo sitemap chính thức.
 *
 * Thứ tự khối: Header → Hero (banner + stats nhỏ) → Bán chạy/Sản phẩm các
 * loại (tabs) → Tin tức/Blog → Video mẫu túi in → Footer.
 *
 * Toàn bộ chữ và số trên trang này đọc từ singleton "Trang chủ" trong Keystatic
 * (`src/content/pages-data/home.json`) — file này chỉ còn lo việc lấy dữ liệu
 * từ content collection và lắp vào component. Muốn đổi tiêu đề khối, số liệu
 * hero hay video thì sửa trong CMS, không sửa ở đây.
 */
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { categoryTitle } from "@config/categories";
import { parseCatalog, parseHomepage } from "@config/pages";
import Layout from "../layouts/Layout.astro";
import catalogData from "../content/pages-data/catalog.json";
import homeData from "../content/pages-data/home.json";

import HeroBanner from "@ui/patterns/HeroBanner.astro";
import BestsellerGrid from "@ui/patterns/BestsellerGrid.astro";
import NewsGrid from "@ui/patterns/NewsGrid.astro";
import FactoryReels from "@ui/patterns/FactoryReels.astro";
import PartnerStrip from "@ui/patterns/PartnerStrip.astro";
import TrustStrip, { type TrustStripItem } from "@ui/patterns/TrustStrip.astro";
import { BRANDS } from "@config/brands";

// Danh sách đối tác CFC — thay file SVG trong /public/partners/ bằng logo thật.
const PARTNERS = [
  { name: "HABECO", logo: "/partners/habeco.svg" },
  { name: "Phú Quý", logo: "/partners/phuquy.svg" },
  { name: "Samsung", logo: "/partners/samsung.svg" },
  { name: "Nutifood", logo: "/partners/nutifood.svg" },
  { name: "Vietnam Airlines", logo: "/partners/vietnam-airlines.svg" },
  { name: "VietinBank", logo: "/partners/vietinbank.svg" },
];

const cfc = BRANDS.cfc;
const trustItems: TrustStripItem[] = [
  {
    icon: "lucide:truck",
    title: "Giao hàng miễn phí",
    sub: "Hoá đơn trên 3 triệu",
  },
  {
    icon: "lucide:package-check",
    title: "Đổi trả miễn phí",
    sub: "Trong vòng 7 ngày",
  },
  {
    icon: "lucide:hand-coins",
    title: "100% Hoàn tiền",
    sub: "Nếu sản phẩm lỗi",
  },
  {
    icon: "lucide:phone-call",
    title: `Hotline: ${cfc.hotline}`,
    sub: "Hỗ trợ 24/7",
    href: cfc.hotlineHref,
    highlight: true,
  },
];

const home = parseHomepage(homeData);
// Chỉ lấy `swatchNote` — thẻ sản phẩm ở đây phải chú thích giống hệt thẻ trên
// /products và /danh-muc, nên dùng chung một nguồn.
const catalog = parseCatalog(catalogData);

// Bản đồ ảnh cho SmartImage — glob phải nằm ở site vì đường dẫn tương đối
// với chính project này (xem packages/ui/lib/images.ts).
const assets = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const products = (await getCollection("products", ({ data }) => !data.draft)).sort(
  (a, z) => a.data.order - z.data.order,
);

// `product.category` lưu slug (relationship) — đổi sang tên hiển thị để nhãn
// tab và nhãn trên thẻ sản phẩm luôn khớp tên khách đặt trong CMS.
const categories = await getCollection("categories");
const label = (slug: string) => categoryTitle(categories, slug);

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, z) => z.data.date.getTime() - a.data.date.getTime())
  .slice(0, home.news.limit);

const toCard = (p: (typeof products)[number]) => ({
  title: p.data.title,
  category: label(p.data.category),
  categorySlug: p.data.category,
  href: `/products/${p.id}`,
  image: p.data.image,
  badge: p.data.badge,
  swatches: p.data.swatches,
  swatchNote: catalog.swatchNote,
});

const bestsellers = products
  .filter((p) => p.data.bestseller)
  .slice(0, home.bestsellers.limit)
  .map(toCard);

// Tab cố định theo yêu cầu — không tự sinh từ dữ liệu bestseller vì danh mục
// sản phẩm thật (19 category CMS) chi tiết hơn nhóm hiển thị mong muốn ở đây.
// Mỗi tab gom nhiều category slug; "coc-giay-ong-hut" (gộp cốc & ống hút)
// được tính vào cả 2 tab Cốc giấy và Ống hút giấy.
const bestsellerTabGroups = [
  { label: "Túi giấy thực phẩm", slugs: ["tui-giay-thuc-pham"] },
  { label: "Giấy gói thực phẩm", slugs: ["giay-goi-thuc-pham", "giay-goi-hamburger"] },
  {
    label: "Hộp đựng thức ăn giấy",
    slugs: ["hop-dung-thuc-an", "hop-dung-xoi", "hop-dung-salad", "khay-do-chien"],
  },
  { label: "Cốc giấy", slugs: ["coc-giay-ong-hut", "coc-1-lop", "coc-2-lop"] },
  { label: "Ống hút giấy", slugs: ["coc-giay-ong-hut", "ong-hut-giay"] },
];
---

<Layout title={home.seo.title} description={home.seo.description} overlapTrustStrip>
  <HeroBanner
    {assets}
    image={home.hero.image}
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    titleAccent={home.hero.titleAccent}
    subtitle={home.hero.subtitle}
    hashtag={home.hero.hashtag}
    stats={home.hero.stats}
  />

  <div class="py-(--space-section-gap) md:py-(--space-section-gap-lg)">
    <BestsellerGrid
      {assets}
      tabGroups={bestsellerTabGroups}
      title={home.bestsellers.title}
      items={bestsellers}
    />
  </div>

  <!-- Nền xen kẽ (kết hợp nền trắng và ghi theo concept 2T Print): riêng khối Tin tức dùng nền ghi nhạt
       (bg-surface-section-alt) để tách khỏi khối Banner→Bán chạy phía trên (nền trắng surface) và khối Video phía dưới
       (cả hai đều nền mặc định) — Video quay lại nền mặc định để nhập cùng
       dải màu với Đối tác/Cam kết dịch vụ theo sau, tạo bố cục 3 dải xen kẽ
       dọc trang: surface (trắng) → alt (ghi sáng) → surface (trắng). -->
  <div class="bg-surface-section-alt py-(--space-section-gap) md:py-(--space-section-gap-lg)">
    <NewsGrid
      {assets}
      title={home.news.title}
      action={home.news.action}
      items={posts.map((p) => ({
        title: p.data.title,
        href: `/blog/${p.id}`,
        date: p.data.date,
        cover: p.data.cover,
        description: p.data.description,
      }))}
    />
  </div>

  <FactoryReels
    {assets}
    label={home.reels.label}
    video={home.reels.video}
    poster={home.reels.poster}
    variant="controls"
  />

  <!-- Dải logo đối tác — nằm ngay trên Footer -->
  <PartnerStrip partners={PARTNERS} title="Đối tác tin cậy của" accent="CFC" />

  <!-- TrustStrip đè lên mép trên Footer ~2/3 chiều cao thẻ bằng margin âm.
       `relative z-(--z-trust-strip-overlap)` để thẻ nổi trên nền tối của
       Footer render ngay sau nó trong DOM. -->
  <div class="site-container relative z-(--z-trust-strip-overlap) mt-(--space-trust-strip-top) -mb-(--overlap-trust-strip) md:mt-(--space-trust-strip-top-lg)">
    <TrustStrip items={trustItems} variant="panel" />
  </div>
</Layout>
