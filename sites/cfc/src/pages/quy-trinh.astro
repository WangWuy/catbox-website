---
export const prerender = true;

/**
 * Quy trình làm việc — 2 luồng khách (mua mẫu có sẵn / đặt theo yêu cầu).
 *
 * Sơ đồ gốc sâu 3 tầng ở nhánh "đặt theo yêu cầu"; ở đây tầng 3 được gấp thành
 * dòng có badge giá thay vì vẽ cây thật, để không vỡ trên mobile.
 *
 * Nội dung đọc từ singleton "Trang quy trình" trong Keystatic. Link Shopee /
 * TikTok Shop vẫn để trống trong CMS — mục nào trống thì render dạng chữ tĩnh,
 * không ra thẻ <a> rỗng; khách điền link là tự thành nút bấm được.
 */
import { Icon } from "astro-icon/components";
import { parseProcess } from "@config/pages";
import Layout from "../layouts/Layout.astro";
import processData from "../content/pages-data/quy-trinh.json";
import Breadcrumb from "@ui/primitives/Breadcrumb.astro";

const page = parseProcess(processData);
const description = page.seo.description;

const CHANNEL_BASE =
  "pill flex items-center gap-1.5 border border-line bg-surface-alt px-4 py-2 text-micro text-ink-muted";

/* Hai tông badge sẵn có. Để ở đây chứ không thành chuỗi class trong CMS: khách
   chọn "tông nhấn" hay "tông CTA", không phải gõ tên class Tailwind. */
const BADGE_TONE = {
  primary: "pill bg-primary/10 px-3 py-1 text-tiny text-primary",
  cta: "pill bg-cta/10 px-3 py-1 text-tiny text-cta",
} as const;
---

<Layout title={page.seo.title} {description}>
  <Breadcrumb
    items={[
      { label: page.parentCrumb.label, href: page.parentCrumb.href },
      { label: page.intro.title },
    ]}
  />

  <div class="site-container flex flex-col gap-12 pb-16">
    <header class="flex max-w-3xl flex-col gap-4">
      <h1 class="text-(length:--text-section-mobile) font-extrabold tracking-tight uppercase md:text-section">
        {page.intro.title}
      </h1>
      <p class="leading-relaxed text-ink-muted">
        {page.intro.body}
      </p>
    </header>

    <section class="grid gap-6 lg:grid-cols-2" aria-label={page.flowsLabel}>
      {
        page.flows.map((flow) => (
          <article class="flex flex-col gap-5 rounded-panel border border-line bg-surface p-6 md:p-8">
            <div class="flex items-center gap-4">
              <span class="flex size-(--size-icon-panel-box) shrink-0 items-center justify-center rounded-panel bg-surface-tint text-primary">
                <Icon name={flow.icon} class="size-(--size-icon-panel)" aria-hidden="true" />
              </span>
              <div class="flex flex-col gap-1">
                <h2 class="font-display text-card-title font-bold">{flow.title}</h2>
                <p class="text-meta leading-snug text-ink-muted">{flow.tagline}</p>
              </div>
            </div>

            {flow.body && (
              <p class="text-label leading-relaxed text-ink-muted">{flow.body}</p>
            )}

            {flow.channels.length > 0 && (
              <div class="flex flex-col gap-2">
                <h3 class="text-meta font-bold tracking-wide uppercase text-ink-faint">
                  {flow.channelsLabel}
                </h3>
                <div class="flex flex-wrap gap-2.5">
                  {flow.channels.map((c) =>
                    c.href ? (
                      <a
                        href={c.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`${CHANNEL_BASE} transition-colors hover:border-primary hover:text-primary`}
                      >
                        <Icon name={c.icon} class="size-(--size-icon-inline)" aria-hidden="true" />
                        {c.label}
                      </a>
                    ) : (
                      <span class={CHANNEL_BASE}>
                        <Icon name={c.icon} class="size-(--size-icon-inline)" aria-hidden="true" />
                        {c.label}
                      </span>
                    ),
                  )}
                </div>
              </div>
            )}

            {flow.branches.map((branch) => (
              <div class="flex flex-col gap-3 rounded-panel bg-surface-alt p-5">
                <h3 class="flex items-center gap-2 font-display text-label font-bold">
                  <Icon
                    name={branch.icon}
                    class="size-(--size-icon-inline) text-primary"
                    aria-hidden="true"
                  />
                  {branch.title}
                </h3>

                {branch.items.length > 0 && (
                  <ul class="flex flex-col gap-3 border-s-(length:--width-flow-connector) border-line ps-(--indent-flow-child)">
                    {branch.items.map((item) => (
                      <li class="flex flex-col gap-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="text-label font-semibold">{item.label}</span>
                          {item.badge && (
                            <span class={BADGE_TONE[item.badgeTone]}>{item.badge}</span>
                          )}
                        </div>
                        <p class="text-meta leading-relaxed text-ink-muted">{item.desc}</p>
                      </li>
                    ))}
                  </ul>
                )}

                {branch.body && (
                  <p class="border-s-(length:--width-flow-connector) border-line ps-(--indent-flow-child) text-meta leading-relaxed text-ink-muted">
                    {branch.body}
                  </p>
                )}
              </div>
            ))}
          </article>
        ))
      }
    </section>

    <section class="flex flex-col gap-7">
      <div class="flex max-w-3xl flex-col gap-3">
        <h2 class="text-(length:--text-section-mobile) font-extrabold tracking-tight uppercase md:text-section">
          {page.steps.title}
        </h2>
        <p class="leading-relaxed text-ink-muted">
          {page.steps.body}
        </p>
      </div>
      <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          page.steps.items.map((s) => (
            <li class="flex flex-col gap-2.5 rounded-panel border border-line bg-surface p-6">
              <span class="font-display text-3xl leading-none font-extrabold text-primary/25">
                {s.num}
              </span>
              <h3 class="font-display text-card-title font-bold">{s.title}</h3>
              <p class="text-sm leading-relaxed text-ink-muted">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="flex flex-col gap-4 rounded-panel bg-surface-alt p-8 md:p-10">
      <h2 class="font-display text-2xl font-bold">{page.cta.title}</h2>
      <p class="max-w-2xl leading-relaxed text-ink-muted">
        {page.cta.body}
      </p>
      <a
        href={page.cta.action.href}
        class="pill mt-2 h-12 w-fit bg-cta px-7 text-white transition-colors hover:bg-cta-hover"
      >
        {page.cta.action.label}
      </a>
    </section>
  </div>
</Layout>
