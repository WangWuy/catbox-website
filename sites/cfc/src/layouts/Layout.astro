---
/**
 * Layout của site CFC — chỉ làm 2 việc: nạp theme CSS và chốt brand="cfc".
 * Toàn bộ cấu trúc trang nằm ở @ui/brand/fnb/BaseLayout.astro dùng chung với site Tetta (cùng khung F&B).
 */
import BaseLayout from "@ui/brand/fnb/BaseLayout.astro";
import "../styles/theme.css";

const FONTS =
  "https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700;800&display=swap";

type BaseProps = Omit<Parameters<typeof BaseLayout>[0], "brand" | "fonts">;
const props = Astro.props as BaseProps;
---

<BaseLayout brand="cfc" fonts={FONTS} {...props}>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
