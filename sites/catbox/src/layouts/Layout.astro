---
/**
 * Layout của site CATBOX — Dark Luxury Studio, font Urbanist/Inter.
 *
 * Khung riêng ở @ui/brand/catbox, KHÔNG dùng chung với CFC/Tetta.
 */
import BaseLayout from "@ui/brand/catbox/BaseLayout.astro";
import "../styles/theme.css";

const FONTS =
  "https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap";

type BaseProps = Omit<Parameters<typeof BaseLayout>[0], "fonts">;
const props = Astro.props as BaseProps;
---

<BaseLayout fonts={FONTS} {...props}>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>
